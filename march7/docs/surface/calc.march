-- An evaluator for integer expressions with + - * / and parentheses,
-- such as "1+2*(3+4)". Written without locals, on purpose (F11).
-- Notes marked F1, F2 and so on point to the findings in README.md.
-- = is dup and ~ is swap.

# calc

-- Every parsing word takes the text and a position and leaves them, advanced,
-- with its result on top:   str i64 -> str i64 i64

## < str i64 -> str i64 str >
peek : 2dup char-at ;                 -- the character there, or "" (F17)

## < str i64 -> str i64 >
skip : 1 + ;

## < str >
digit? : = "0" gte? ~ "9" lte? and ;
mulop? : = "*" eq? ~ "/" eq? or ;
addop? : = "+" eq? ~ "-" eq? or ;

-- One clause per operator, chosen by a literal pattern: the third input equals
-- "*", and so on. The body still sees the operator, hence the drop (F4).
## < i64 i64 "*" >
apply : drop * ;
## < i64 i64 "/" >
apply : drop / ;
## < i64 i64 "+" >
apply : drop + ;
## < i64 i64 "-" >
apply : drop - ;

## < >                                -- the words below have no context (F19)

-- A run of digits. The accumulator goes under the text and position, and the
-- scratch stack holds each digit while the accumulator comes up (F11).
number : 0 -rot
  [ peek digit? ]
  [ peek digit-value >r  rot 10 * r> +  -rot  skip ]
  while rot ;

-- A number, or an expression in parentheses. factor calls expr, which is
-- defined below and calls back down to factor (F8).
factor : peek "(" eq?
  [ skip expr  >r skip r> ]           -- past "(", the expression, past ")"
  [ number ]
  if ;

-- Factors joined by * and /. The loop keeps the text, the position and the
-- value so far; the operator waits on the scratch stack (F11).
term : factor
  [ >r peek mulop? r> ~ ]
  [ >r peek >r skip factor r> r> -rot apply ]
  while ;

-- Terms joined by + and -: the same loop as term (F18).
expr : term
  [ >r peek addop? r> ~ ]
  [ >r peek >r skip term r> r> -rot apply ]
  while ;

calc : 0 expr nip nip ;               -- "1+2*(3+4)" calc  leaves 15

## tree

-- The same arithmetic over a syntax tree. Expr is a variant type whose bin
-- case refers to Expr itself (F10). The constructor names are patterns too.

Expr : variant { num : i64 ; bin : Expr Expr str } ;

-- match takes pattern and action pairs. Undoing num leaves its i64; undoing
-- bin leaves the two subtrees and the operator. The recursive calls to eval sit
-- inside inlined arms (F9). Keeping the recursion inside one word, rather than
-- one clause per case, avoids recursion between clauses (F8).
### < Expr -> i64 >
eval : [ num ] [ ]
       [ bin ] [ >r eval ~ eval ~ r> apply ]
       match ;

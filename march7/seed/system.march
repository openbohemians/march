-- March7 system layer, written in March.
--
-- Compiling this file with any equivalent system (the generation-zero listing
-- or an earlier generation of this file) defines a complete new system and
-- leaves the token of its `boot` word on the stack. `march7 IMAGE --system OUT`
-- then exports an image whose entry is that word.
--
-- Rule that makes generations identical: every *compiled* call in this file
-- targets a word defined earlier in this file. Words from the running
-- dictionary may be *executed* at compile time (`:` `;` `immediate` `[` ...),
-- because executing a word leaves no reference to it in the output. Within
-- this file, primitive names are immediate words that emit the primitive
-- itself (phase 2), so every compiler produces the same inlined code.
--
-- Working memory is region 1 (see docs/FIRST-SLICE.md):
--   0 STATE   8 LATEST   16 HERE (output offset)   24 output region
--   32 next dictionary byte   40/48/56 input region/length/position
--   64/72 current word start/length   80/88/96 unfinished definition name
--   128-440 private temporaries, 344 string start, 520/528 instruction scan
--   3840-4095 name of the unfinished definition
--   4096-1048575 dictionary
--
-- Trap codes: 1 unknown word, 2 decimal overflow, 4 missing word, 5 nested
-- definition, 6 `;` outside a definition, 7 bad dictionary data or name,
-- 8 unterminated string, 10 arithmetic overflow, 11 division by zero,
-- 12 dictionary full, 13 compile-only word used outside a definition.

-- Phase 1: throwaway compile-time helpers, built from the running dictionary.
-- They are only ever executed, so they never reach the exported image.
: [ 0 STATE ! ; immediate
: ] 1 STATE ! ;
: prim, 2 c, c, ;

-- Phase 2: primitives. The wrappers, one primitive op and a return each, are
-- what the exported dictionary binds (`dup` is `p-dup`, flagged inline), so
-- `' dup` and `call` work in the booted system.
: p-dup [ 0 prim, ] ;
: p-drop [ 1 prim, ] ;
: p-swap [ 2 prim, ] ;
: p-over [ 3 prim, ] ;
: p-rot [ 4 prim, ] ;
: p-u+ [ 5 prim, ] ;
: p-u- [ 6 prim, ] ;
: p-u* [ 7 prim, ] ;
: p-u/ [ 8 prim, ] ;
: p-umod [ 9 prim, ] ;
: p-eq? [ 10 prim, ] ;
: p-ult? [ 11 prim, ] ;
: p-and [ 12 prim, ] ;
: p-or [ 13 prim, ] ;
: p-xor [ 14 prim, ] ;
: p-invert [ 15 prim, ] ;
: p-lshift [ 16 prim, ] ;
: p-rshift [ 17 prim, ] ;
: p-c@ [ 18 prim, ] ;
: p-c! [ 19 prim, ] ;
: p-@ [ 20 prim, ] ;
: p-! [ 21 prim, ] ;
: p-region-new [ 22 prim, ] ;
: p-region-free [ 23 prim, ] ;
: p-region-size [ 24 prim, ] ;
: p-call [ 25 prim, ] ;
: p-seal [ 26 prim, ] ;
: p-code-cid [ 27 prim, ] ;
: p-resolve [ 28 prim, ] ;
: p-publish [ 29 prim, ] ;
: p-blob-cid [ 30 prim, ] ;
: p-blob-read [ 31 prim, ] ;
: p-trap [ 32 prim, ] ;

-- Within this file each primitive name is an immediate word that emits the
-- primitive op. So compiled code is inlined whatever system compiles this
-- file, and every generation produces the same bytes. These emitters are
-- compile-time devices: nothing exported refers to them, and this file never
-- uses a primitive name outside a definition.
: dup 0 prim, ; immediate
: drop 1 prim, ; immediate
: swap 2 prim, ; immediate
: over 3 prim, ; immediate
: rot 4 prim, ; immediate
: u+ 5 prim, ; immediate
: u- 6 prim, ; immediate
: u* 7 prim, ; immediate
: u/ 8 prim, ; immediate
: umod 9 prim, ; immediate
: eq? 10 prim, ; immediate
: ult? 11 prim, ; immediate
: and 12 prim, ; immediate
: or 13 prim, ; immediate
: xor 14 prim, ; immediate
: invert 15 prim, ; immediate
: lshift 16 prim, ; immediate
: rshift 17 prim, ; immediate
: c@ 18 prim, ; immediate
: c! 19 prim, ; immediate
: @ 20 prim, ; immediate
: ! 21 prim, ; immediate
: region-new 22 prim, ; immediate
: region-free 23 prim, ; immediate
: region-size 24 prim, ; immediate
: call 25 prim, ; immediate
: seal 26 prim, ; immediate
: code-cid 27 prim, ; immediate
: resolve 28 prim, ; immediate
: publish 29 prim, ; immediate
: blob-cid 30 prim, ; immediate
: blob-read 31 prim, ; immediate
: trap 32 prim, ; immediate

-- Phase 3: clean base words.
: get 1 swap @ ;
: put 1 swap ! ;
: 0= 0 eq? ;
: nip swap drop ;
: out 24 get ;
: here 16 get ;
: c, out here c! here 1 u+ 16 put ;
: [ 0 0 put ; immediate
: ] 1 0 put ;
: prim, 2 c, c, ;
: u32, dup c, 8 rshift dup c, 8 rshift dup c, 8 rshift c, ;
: b! out swap c! ;
: u32! over over b! over 8 rshift over 1 u+ b! over 16 rshift over 2 u+ b! swap 24 rshift swap 3 u+ b! ;
-- Operand lengths of opcodes 0-9, six bits each: 1 9 2 33 33 5 5 1 33 33.
: oplen 6 u* 603768572619268673 swap rshift 63 and ;

-- Branch targets are instruction indexes, so count the instructions already
-- emitted into the output region. This is the one hand-assembled word: its
-- zero-branch (op 10) exits to op 28 and its branch (op 27) loops to op 6.
: ops
  0 520 put 0 528 put
  520 get here ult? [ 6 c, 28 u32, ]
  out 520 get c@ oplen 520 get u+ 520 put
  528 get 1 u+ 528 put
  [ 5 c, 6 u32, ]
  528 get ;

-- Phase 4: control flow. Forward references leave the byte position of a
-- four-byte branch operand; backward ones leave an instruction index.
: if 6 c, here 0 u32, ; immediate
: then ops swap u32! ; immediate
: else 5 c, here 0 u32, swap ops swap u32! ; immediate
: cycle ops ; immediate
: again 5 c, u32, ; immediate
: until 6 c, u32, ; immediate
: while 6 c, here 0 u32, ; immediate
: repeat swap 5 c, u32, ops swap u32! ; immediate
: exit 0 c, ; immediate
-- Dictionary flags: bit 0 immediate; bit 1 inline primitive, id in bits 8-15;
-- bit 2 transparent (an immediate word that leaves pending quotations alone).
: immediate 8 get dup 0= if 7 trap then 16 u+ dup get 1 or swap put ;
: prim-flag 8 lshift 2 or ;
: , 0 360 put cycle 360 get 8 ult? while dup 360 get 8 u* rshift c, 360 get 1 u+ 360 put repeat drop ;
: literal 1 c, , ;

-- From here on, `get` and `put` compile inline: a literal 1 (working region
-- 1), a swap, and the load or store. Words above keep calling them, which the
-- hand-counted `ops` relies on; they only run at compile time.
: get 1 literal 2 prim, 20 prim, ; immediate
: put 1 literal 2 prim, 21 prim, ; immediate

-- Phase 5: the scratch stack, for temporaries that must survive calls.
-- It belongs to the machine, not region 1. Every call gets its own scratch
-- frame, and returning discards whatever the word left there, so a word can
-- neither leave hidden outputs nor read its caller's values. The words are
-- compile-only and always emit the primitive inline: a call to a wrapper
-- would discard the value on the wrapper's own return.
: compile-only 0 get 0= if 13 trap then ;
: >r compile-only 33 prim, ; immediate
: r> compile-only 34 prim, ; immediate
: r@ compile-only 35 prim, ; immediate

-- Phase 6: the compiler.
: inc-pos 56 get 1 u+ 56 put ;
: input-char 40 get 56 get c@ ;

-- ( src-region src-offset dst-region dst-offset n -- )
: copy 128 put 136 put 144 put 152 put 160 put
  cycle 128 get while
    160 get 152 get c@ 144 get 136 get c!
    152 get 1 u+ 152 put
    136 get 1 u+ 136 put
    128 get 1 u- 128 put
  repeat ;

-- FNV-1a over bytes, finished with the MurmurHash3 64-bit mixer: the same
-- function as merkle-champ's `hash_bytes`, so a name hashes the same in the
-- working dictionary and in a store.
: mix64 dup 33 rshift xor -49064778989728563 u* dup 33 rshift xor
  -4265267296055464877 u* dup 33 rshift xor ;
-- ( region offset length -- hash )
: hash-bytes 760 put 752 put 744 put -3750763034362895579 768 put 0 776 put
  cycle 776 get 760 get ult? while
    744 get 752 get 776 get u+ c@ 768 get xor 1099511628211 u* 768 put
    776 get 1 u+ 776 put
  repeat
  768 get 760 get xor mix64 ;

-- The dictionary is hashed: 1,024 buckets in the region whose handle is at
-- working offset 736, each the head of a chain through the entries' bucket
-- links, newest first, so the newest definition of a name is found first.
-- An entry is: previous entry (LATEST chain), token, flags, name length, next
-- entry in its bucket, then the name bytes from offset 40.
-- ( region offset length -- bucket-offset )
: name-bucket hash-bytes 1023 and 8 u* ;

-- ( xt flags name-region name-offset length -- )
-- The entry is complete before LATEST or its bucket points at it.
: install 176 put 184 put 192 put 200 put 208 put
  176 get dup 0= swap 256 ult? 0= or if 7 trap then
  32 get 216 put
  216 get 40 u+ 176 get u+ 7 u+ -8 and dup 1048576 1 u+ ult? 0= if 12 trap then 224 put
  8 get 216 get put
  208 get 216 get 8 u+ put
  200 get 216 get 16 u+ put
  176 get 216 get 24 u+ put
  192 get 184 get 1 216 get 40 u+ 176 get copy
  192 get 184 get 176 get name-bucket 232 put
  736 get 232 get @ 216 get 32 u+ put
  224 get 32 put
  216 get 8 put
  216 get 736 get 232 get ! ;

-- ( region offset length -- entry | 0 )
: find 256 put 248 put 240 put
  736 get 240 get 248 get 256 get name-bucket @ 264 put
  cycle 264 get while
    264 get 24 u+ get 256 get eq? if
      0 272 put
      cycle
        272 get 256 get ult? if
          240 get 248 get 272 get u+ c@
          1 264 get 40 u+ 272 get u+ c@ eq?
        else 0 then
      while 272 get 1 u+ 272 put repeat
      272 get 256 get eq? if 264 get exit then
    then
    264 get 32 u+ get 264 put
  repeat 0 ;

: token 40 get 64 get 72 get ;

-- ( -- flag ) Skip whitespace, then take the next whitespace-delimited word.
: read-word
  cycle 56 get 48 get ult? if input-char 33 ult? else 0 then while inc-pos repeat
  56 get 48 get ult? 0= if 0 72 put 0 exit then
  56 get 64 put
  cycle 56 get 48 get ult? if input-char 33 ult? 0= else 0 then while inc-pos repeat
  56 get 64 get u- 72 put 1 ;

: word read-word 0= if 4 trap then token ;

: scan-char 40 get 288 get c@ ;
: scan-inc 288 get 1 u+ 288 put ;

-- ( -- n 1 | 0 ) Signed decimal. A decimal that does not fit traps (2)
-- instead of falling through to a dictionary word with that spelling.
: number
  64 get 288 put 64 get 72 get u+ 296 put 0 304 put
  scan-char 45 eq? if 1 304 put scan-inc else scan-char 43 eq? if scan-inc then then
  288 get 296 get eq? if 0 exit then
  288 get 336 put
  cycle 288 get 296 get ult? while
    scan-char 48 u- 10 ult? 0= if 0 exit then scan-inc
  repeat
  336 get 288 put 0 312 put 9223372036854775807 304 get u+ 320 put
  cycle 288 get 296 get ult? while
    scan-char 48 u- 328 put
    320 get 328 get u- 10 u/ 312 get ult? if 2 trap then
    312 get 10 u* 328 get u+ 312 put scan-inc
  repeat
  312 get 304 get if 0 swap u- then 1 ;

: compile, 3 c, out here code-cid here 32 u+ 16 put ;
: compile-quote 4 c, out here code-cid here 32 u+ 16 put ;

-- Stack effects (checker, slice 1). A word's effect is how many cells it
-- takes and leaves. The checker derives it from the word's canonical code
-- bytes, so it is exact whatever syntax produced the code, and it works the
-- same on a definition being built and on sealed code read back by CID.
-- Effects are computed on demand and remembered per session (never stored
-- in images). See docs/CHECKER.md.
--
-- Packed effect: bit 0 computed, bit 1 known, bits 8-23 inputs (or, when
-- unknown, the reason), bits 24-39 outputs. Reasons: 1 dynamic call, 2 calls
-- a word whose effect is unknown, 3 branches meet at different depths, 4 a
-- loop changes the depth, 5 returns leave different depths, 6 scratch pop
-- below the word's frame, 7 never returns, 8 recursion inconsistent with its
-- base case, 10 limits, 11 invalid code.
-- ( in out -- packed )
: effect-pack 24 lshift swap 8 lshift or 3 or ;
-- ( reason -- packed )
: effect-unknown 8 lshift 1 or ;
-- ( packed -- flag )
: effect-known? 1 rshift 1 and ;
-- ( packed -- n )
: effect-in 8 rshift 65535 and ;
-- ( packed -- n )
: effect-out 24 rshift 65535 and ;

-- Inputs and outputs of primitives 0-31, two bits each. Execute (25), trap
-- (32) and the scratch primitives (33-35) are handled specially.
-- ( id -- n )
: prim-in 2 u* -4687861376211047515 swap rshift 3 and ;
-- ( id -- n )
: prim-out 2 u* -4246594190310025246 swap rshift 3 and ;

-- Each analysis has its own region, so analyses nest (a call analyses its
-- callee). Its handle is at working offset 600. Fields: 0 code region,
-- 8 code length, 16 op count, 24 current op, 32 its byte offset, 40 live,
-- 48 depth, 56 scratch depth, 64 effect of a quotation on top (or 0),
-- 72 lowest depth, 80 returned?, 88 return depth, 96 unknown reason,
-- 104 pass, 112 assumed own effect, 120 recurs?. Depths are biased by 2^32
-- so that unsigned comparison works. Per-op tables start at 256: 0 byte
-- offset; 1-4 state from forward branches (set?, depth, scratch, quotation);
-- 5-7 state on arrival (set?, depth, scratch); 8 loop header?.
-- ( field -- v )
: an@ 600 get swap @ ;
-- ( v field -- )
: an! 600 get swap ! ;
-- ( k table -- field )
: tab 16 an@ 8 u* u* 256 u+ swap 8 u* u+ ;
-- ( k table -- v )
: tab@ tab an@ ;
-- ( v k table -- )
: tab! tab an! ;
-- ( pos -- byte )
: code@ 0 an@ swap c@ ;
-- ( pos -- n )
: code-u32
  dup code@ over 1 u+ code@ 8 lshift or
  over 2 u+ code@ 16 lshift or swap 3 u+ code@ 24 lshift or ;

-- ( region length -- n )
: count-ops
  656 put 648 put 0 664 put 0 672 put
  cycle 664 get 656 get ult? while
    648 get 664 get c@ oplen 664 get u+ 664 put
    672 get 1 u+ 672 put
  repeat 672 get ;

-- ( region length -- )
: analysis-begin
  over over count-ops dup 72 u* 256 u+ region-new 600 put
  16 an! 8 an! 0 an!
  0 32 an! 0 24 an!
  cycle 24 an@ 16 an@ ult? while
    32 an@ 24 an@ 0 tab!
    32 an@ code@ oplen 32 an@ u+ 32 an!
    24 an@ 1 u+ 24 an!
  repeat
  -- Mark loop headers: targets of backward branches.
  0 24 an!
  cycle 24 an@ 16 an@ ult? while
    24 an@ 0 tab@ dup code@ dup 5 eq? swap 6 eq? or if
      1 u+ code-u32 dup 24 an@ 1 u+ ult? if 1 swap 8 tab! else drop then
    else drop then
    24 an@ 1 u+ 24 an!
  repeat ;

-- ( reason -- )
: fail 96 an@ 0= if 96 an! else drop then 16 an@ 24 an! 0 40 an! ;
-- ( in out -- )
: apply
  swap 48 an@ swap u- dup 72 an@ ult? if dup 72 an! then u+ 48 an! ;
-- ( target -- )
: pend
  dup 1 tab@ if
    dup 2 tab@ 48 an@ eq? over 3 tab@ 56 an@ eq? and 0= if drop 3 fail exit then
    dup 4 tab@ 64 an@ eq? 0= if 0 over 4 tab! then drop
  else
    1 over 1 tab! 48 an@ over 2 tab! 56 an@ over 3 tab! 64 an@ swap 4 tab!
  then ;
-- ( target -- )
: back
  dup 6 tab@ 48 an@ eq? swap 7 tab@ 56 an@ eq? and 0= if 4 fail then ;
-- ( -- )
: arrive
  24 an@ 1 tab@ if
    40 an@ if
      24 an@ 2 tab@ 48 an@ eq? 24 an@ 3 tab@ 56 an@ eq? and 0= if 3 fail exit then
      24 an@ 4 tab@ 64 an@ eq? 0= if 0 64 an! then
    else
      24 an@ 2 tab@ 48 an! 24 an@ 3 tab@ 56 an! 24 an@ 4 tab@ 64 an! 1 40 an!
    then
  then
  40 an@ if
    24 an@ 8 tab@ if 0 64 an! then
    1 24 an@ 5 tab! 48 an@ 24 an@ 6 tab! 56 an@ 24 an@ 7 tab!
  then ;

-- The effect of a callee, through the word stored at working offset 616
-- (`effect-of`, defined below).
-- ( token -- packed )
: callee-effect 616 get call ;
-- ( -- packed )
: callee 0 an@ 32 an@ 1 u+ resolve callee-effect ;

-- ( -- )
: do-return
  80 an@ if 88 an@ 48 an@ eq? 0= if 5 fail exit then
  else 1 80 an! 48 an@ 88 an! then 0 40 an! ;
-- ( -- )
: do-call
  callee dup effect-known? if dup effect-in swap effect-out apply 0 64 an!
  else drop 2 fail then ;
-- ( -- )
: do-quote
  callee 0 1 apply dup effect-known? if 64 an! else drop 0 64 an! then ;
-- ( -- )
: do-execute
  64 an@ dup if 1 0 apply dup effect-in swap effect-out apply 0 64 an!
  else drop 1 fail then ;
-- ( id -- )
: do-prim
  35 over ult? if drop 11 fail exit then
  dup 25 eq? if drop do-execute exit then
  dup 32 eq? if drop 1 0 apply 0 40 an! exit then
  dup 33 eq? if drop 1 0 apply 56 an@ 1 u+ 56 an! 0 64 an! exit then
  dup 34 eq? if drop 56 an@ 0= if 6 fail exit then
    56 an@ 1 u- 56 an! 0 1 apply 0 64 an! exit then
  dup 35 eq? if drop 56 an@ 0= if 6 fail exit then 0 1 apply 0 64 an! exit then
  dup 0= if drop 1 2 apply exit then
  dup prim-in swap prim-out apply 0 64 an! ;
-- ( -- target )
: branch-target 32 an@ 1 u+ code-u32 ;
-- ( target -- )
: jump 24 an@ over ult? if pend else back then ;
-- ( -- )
: do-recur
  1 120 an! 104 an@ 1 eq? if 0 40 an! exit then
  112 an@ dup effect-in swap effect-out apply 0 64 an! ;

-- ( -- )
: step
  24 an@ 0 tab@ 32 an!
  32 an@ code@
  dup 0= if drop do-return exit then
  dup 1 eq? if drop 0 1 apply 0 64 an! exit then
  dup 2 eq? if drop 32 an@ 1 u+ code@ do-prim exit then
  dup 3 eq? if drop do-call exit then
  dup 4 eq? if drop do-quote exit then
  dup 5 eq? if drop branch-target jump 0 40 an! exit then
  dup 6 eq? if drop 1 0 apply 0 64 an! branch-target jump exit then
  dup 7 eq? if drop do-recur exit then
  dup 8 eq? if drop 0 3 apply 0 64 an! exit then
  dup 9 eq? if drop do-call 40 an@ if do-return then exit then
  drop 11 fail ;

-- ( pass -- )
: run-pass
  104 an!
  0 24 an!
  cycle 24 an@ 16 an@ ult? while
    0 24 an@ 1 tab! 0 24 an@ 5 tab!
    24 an@ 1 u+ 24 an!
  repeat
  0 24 an! 1 40 an! 4294967296 48 an! 0 56 an! 0 64 an! 4294967296 72 an!
  0 80 an! 0 88 an! 0 96 an!
  cycle 24 an@ 16 an@ ult? while
    arrive 40 an@ if step then
    24 an@ 1 u+ 24 an!
  repeat ;
-- ( -- packed )
: pass-result
  96 an@ if 96 an@ effect-unknown exit then
  80 an@ 0= if 7 effect-unknown exit then
  4294967296 72 an@ u- 88 an@ 72 an@ u- effect-pack ;

-- ( region length -- packed ) The effect of canonical code bytes. A word
-- that recurs is analysed twice: once treating `recur` as a dead end, which
-- gives its base case, then again assuming that effect for `recur`, which
-- must reproduce it.
: analyze
  600 get >r
  analysis-begin 1 run-pass pass-result
  120 an@ if dup effect-known? if
    dup 112 an! 2 run-pass pass-result
    dup effect-known? if
      over over eq? if drop else drop drop 8 effect-unknown then
    else swap drop then
  then then
  600 get region-free r> 600 put ;

-- ( token -- packed ) A word's effect, computed from its code on first use
-- and remembered in the table at working offset 624.
: effect-of
  dup 131072 ult? 0= if drop 10 effect-unknown exit then
  dup 8 u* 624 get swap @ dup if swap drop exit then drop
  dup 1 680 code-cid 1 680 blob-read swap drop analyze
  dup rot 8 u* 624 get swap ! ;

-- ( token -- inputs outputs 1 | reason 0 0 )
: stack-effect
  effect-of dup effect-known? if dup effect-in swap effect-out 1
  else effect-in 0 0 then ;
-- In checked mode, `;` rejects a definition whose effect is unknown, trapping
-- with 100 plus the reason.
: checked 1 632 put ;
: unchecked 0 632 put ;

-- ( name-region name-offset length -- ) The name is copied at once, so a
-- definition may continue in later input after its source buffer is gone.
: begin 0 get if 5 trap then
  dup 256 ult? 0= if 7 trap then
  dup 88 put 1 swap 3840 swap copy
  1 96 put 3840 80 put
  65536 region-new 24 put 0 16 put 1 0 put ;
: colon word begin ;
: semicolon 0 get 0= if 6 trap then 800 get if 20 trap then
  0 c,
  632 get if out here analyze dup effect-known? 0= if effect-in 100 u+ trap then
  else 0 then
  out 0 here seal
  dup >r 0 96 get 80 get 88 get install
  dup if r@ 8 u* 624 get swap ! else drop then
  out region-free 0 24 put 0 0 put ;

: >xt 8 u+ get ;
: quote-word word find dup 0= if 1 trap then >xt 0 get if compile-quote then ;
: emit-recur 7 c, ;
: line-comment cycle 56 get 48 get ult? while input-char inc-pos 10 eq? if exit then repeat ;

-- ( -- region 0 length ) or, compiling, emit a data operand.
-- Reads to the next double quote.
: s"
  inc-pos 56 get 344 put
  cycle 56 get 48 get ult? if input-char 34 eq? 0= else 0 then while inc-pos repeat
  56 get 48 get ult? 0= if 8 trap then
  40 get 344 get 56 get 344 get u- publish
  inc-pos
  0 get if 8 c, out here blob-cid here 32 u+ 16 put else 0 over region-size then ; immediate

-- Quotations: `[ ... ]` compiles its body into a buffer of its own and leaves
-- it pending, anchored where it appeared. A consumer (`if`, `while`, `times`)
-- inlines pending bodies into the definition; anything else first seals each
-- pending body as an anonymous word and emits a quotation of it in place.
-- Working memory: 800 nesting depth; 808 pending count; pending entries at
-- 1024 + 24i (region, length, depth); saved outer builders at 2560 + 24d
-- (region, offset, STATE); 3400-3432 temporaries for inlining.
-- Traps: 15 exit or recur inside a quotation, 16 nesting too deep, 17 `]`
-- without `[`, 18 too many pending quotations, 19 wrong quotations for a
-- consumer, 20 `;` inside an open quotation.
: q-entry 24 u* 1024 u+ ;
-- ( -- k ) Index of the first pending entry at the current depth.
: pending-start
  808 get cycle dup if dup 1 u- q-entry 16 u+ get 800 get eq? else 0 then
  while 1 u- repeat ;
-- ( -- n ) Pending quotations at the current depth.
: pending-here 808 get pending-start u- ;
-- ( region length -- token ) Append a return, seal, free the buffer.
: seal-quote
  over over >r >r 0 r> r> c!
  1 u+ over >r 0 swap seal r> region-free ;
-- ( -- ) Emit every pending quotation at this depth as a first-class
-- quotation, oldest first, where it appeared.
: materialize
  pending-start dup >r
  cycle dup 808 get ult? while
    dup q-entry dup get swap 8 u+ get seal-quote compile-quote
    1 u+
  repeat drop r> 808 put ;
-- ( region pos -- n ) A little-endian 32-bit operand.
: region-u32
  over over c@ >r over over 1 u+ c@ 8 lshift r> or >r
  over over 2 u+ c@ 16 lshift r> or >r 3 u+ c@ 24 lshift r> or ;
-- ( i -- ) Copy pending body i into the definition, shifting its branch
-- targets by the instruction index where it lands. Free its buffer.
: inline-quote
  q-entry dup get 3400 put 8 u+ get 3408 put ops 3416 put 0 3424 put
  cycle 3424 get 3408 get ult? while
    3400 get 3424 get c@ dup oplen 3432 put
    dup 5 eq? over 6 eq? or if
      c, 3400 get 3424 get 1 u+ region-u32 3416 get u+ u32,
    else
      drop 3400 get 3424 get out here 3432 get copy here 3432 get u+ 16 put
    then
    3424 get 3432 get u+ 3424 put
  repeat 3400 get region-free ;
-- ( -- ) Drop the newest n pending entries (already inlined).
: consumed 808 get swap u- 808 put ;

: quote-open
  800 get 32 ult? 0= if 16 trap then
  800 get 24 u* 2560 u+ out over put here over 8 u+ put 0 get swap 16 u+ put
  65536 region-new 24 put 0 16 put 1 0 put
  800 get 1 u+ 800 put ;
: quote-close
  800 get 0= if 17 trap then
  800 get 1 u- dup 800 put 24 u* 2560 u+ out here rot
  dup get 24 put dup 8 u+ get 16 put 16 u+ get dup 0 put
  if
    808 get 64 ult? 0= if 18 trap then
    808 get q-entry swap over 8 u+ put swap over put 800 get swap 16 u+ put
    808 get 1 u+ 808 put
  else seal-quote then ;

-- ( -- ) Quotation-aware `if`: `c [ t ] [ f ] if`, `c [ t ] if`, or, with
-- nothing pending, FORTH's `if ... else ... then`.
: qif
  pending-here
  dup 0= if drop 6 c, here 0 u32, exit then
  dup 1 eq? if drop
    6 c, here 0 u32, 808 get 1 u- inline-quote 1 consumed ops swap u32! exit then
  2 eq? 0= if 19 trap then
  6 c, here 0 u32, 808 get 2 u- inline-quote
  5 c, here 0 u32, swap ops swap u32!
  808 get 1 u- inline-quote ops swap u32! 2 consumed ;
-- ( -- ) `[ c ] [ body ] while`, or FORTH's `cycle ... while ... repeat`.
: qwhile
  pending-here
  dup 0= if drop 6 c, here 0 u32, exit then
  2 eq? 0= if 19 trap then
  ops 808 get 2 u- inline-quote
  6 c, here 0 u32, 808 get 1 u- inline-quote
  swap 5 c, u32, ops swap u32! 2 consumed ;
-- ( -- ) `n [ body ] times` runs body n times, with the index 0..n-1 as
-- `i0` (and the enclosing loop's as `i1`). The limit and index live on the
-- scratch stack.
: times
  pending-here 1 eq? 0= if 19 trap then
  33 prim, 0 literal 33 prim,
  ops 34 prim, 35 prim, 3 prim, 33 prim, 11 prim,
  6 c, here 0 u32, 808 get 1 u- inline-quote 1 consumed
  34 prim, 1 literal 5 prim, 33 prim,
  swap 5 c, u32, ops swap u32!
  34 prim, 1 prim, 34 prim, 1 prim, ;
: i0 compile-only 35 prim, ;
: i1 compile-only 34 prim, 34 prim, 35 prim, 4 prim, 4 prim, 33 prim, 33 prim, ;
: qexit 800 get if 15 trap then 0 c, ;
: qrecur 800 get if 15 trap then 7 c, ;

-- The outer interpreter over the current input: numbers before lookup.
-- Compiling a word whose entry is flagged as an inline primitive emits the
-- primitive op itself instead of a call to its wrapper. Before compiling
-- anything, or running an immediate word not flagged transparent (bit 2),
-- pending quotations are materialized where they stand.
: interpret
  cycle read-word while
    number if
      0 get if materialize literal then
    else
      token find dup 0= if 1 trap then
      dup 16 u+ get
      dup 1 and if
        dup 4 and 0= if 0 get if materialize then then
        drop >xt call
      else
        0 get 0= if drop >xt call else
          materialize
          dup 2 and if nip 8 rshift prim, else drop >xt compile, then
        then
      then
    then
  repeat ;

-- ( input-region length -- ) Reentrant: the caller's input is restored, so
-- words may evaluate text while their own input is being interpreted.
: evaluate
  40 get >r 48 get >r 56 get >r 64 get >r 72 get >r
  48 put 40 put 0 56 put interpret
  r> 72 put r> 64 put r> 56 put r> 48 put r> 40 put ;

-- Phase 7: recovery, dictionary export and boot.
: recover 24 get dup if region-free else drop then
  cycle 800 get while
    800 get 1 u- dup 800 put 24 u* 2560 u+ get dup if region-free else drop then
  repeat
  cycle 808 get while 808 get 1 u- dup 808 put q-entry get region-free repeat
  0 24 put 0 16 put 0 0 put 0 600 put ;

-- Dictionary export: oldest first, name length, flags, code CID, name bytes.
: out-byte 400 get 408 get c! 408 get 1 u+ 408 put ;
: out-cell 0 360 put cycle 360 get 8 ult? while dup 360 get 8 u* rshift out-byte 360 get 1 u+ 360 put repeat drop ;
: save-list dup 0= if drop exit then dup get recur 440 put
  440 get 24 u+ get out-cell
  440 get 16 u+ get out-cell
  440 get >xt 400 get 408 get code-cid 408 get 32 u+ 408 put
  1 440 get 40 u+ 400 get 408 get 440 get 24 u+ get copy
  408 get 440 get 24 u+ get u+ 408 put ;
: snapshot 1048576 region-new 400 put 0 408 put 8 get save-list 400 get 0 408 get ;

: in-cell 0 352 put 0 360 put
  cycle 360 get 8 ult? while
    384 get 392 get c@ 360 get 8 u* lshift 352 get or 352 put
    392 get 1 u+ 392 put 360 get 1 u+ 360 put
  repeat 352 get ;
: restore 416 put 392 put 384 put
  cycle 392 get 416 get ult? while
    in-cell 424 put
    in-cell dup 65536 ult? 0= if 7 trap then 432 put
    384 get 392 get resolve 392 get 32 u+ 392 put
    432 get 384 get 392 get 424 get install
    392 get 424 get u+ 392 put
  repeat
  392 get 416 get eq? 0= if 7 trap then ;

-- Signed application arithmetic over the unsigned machine operations.
-- Results that do not fit a signed 64-bit cell trap (10) instead of wrapping.
: min-int 9223372036854775807 1 u+ ;
: negative? min-int and 0= 0= ;
: negate 0 swap u- ;
: abs dup negative? if negate then ;
: lt? swap min-int xor swap min-int xor ult? ;
: gt? swap lt? ;
: lte? gt? 0= ;
: gte? lt? 0= ;
: + over over u+ >r r@ xor swap r@ xor and negative? if 10 trap then r> ;
: - over over u- >r over xor swap r@ xor and negative? if 10 trap then r> ;
: / dup 0= if 11 trap then
  over min-int eq? over -1 eq? and if 10 trap then
  over over xor negative? >r
  abs swap abs swap u/ r> if negate then ;
: mod over over / u* u- ;
: * over 0= if drop exit then
  over over u* >r swap r@ swap / eq? 0= if 10 trap then r> ;

: STATE 1 0 ;
: HERE 1 16 ;
: LATEST 1 8 ;

-- The name s" cannot be written with s" itself.
: sq-name 2 region-new 115 over 0 c! 34 over 1 c! 0 2 ;

: init
  ' p-dup 0 prim-flag s" dup" install
  ' p-drop 1 prim-flag s" drop" install
  ' p-swap 2 prim-flag s" swap" install
  ' p-over 3 prim-flag s" over" install
  ' p-rot 4 prim-flag s" rot" install
  ' p-u+ 5 prim-flag s" u+" install
  ' p-u- 6 prim-flag s" u-" install
  ' p-u* 7 prim-flag s" u*" install
  ' p-u/ 8 prim-flag s" u/" install
  ' p-umod 9 prim-flag s" umod" install
  ' p-eq? 10 prim-flag s" eq?" install
  ' p-ult? 11 prim-flag s" ult?" install
  ' p-and 12 prim-flag s" and" install
  ' p-or 13 prim-flag s" or" install
  ' p-xor 14 prim-flag s" xor" install
  ' p-invert 15 prim-flag s" invert" install
  ' p-lshift 16 prim-flag s" lshift" install
  ' p-rshift 17 prim-flag s" rshift" install
  ' p-c@ 18 prim-flag s" c@" install
  ' p-c! 19 prim-flag s" c!" install
  ' p-@ 20 prim-flag s" @" install
  ' p-! 21 prim-flag s" !" install
  ' p-region-new 22 prim-flag s" region-new" install
  ' p-region-free 23 prim-flag s" region-free" install
  ' p-region-size 24 prim-flag s" region-size" install
  ' p-call 25 prim-flag s" call" install
  ' word 0 s" word" install
  ' find 0 s" find" install
  ' >xt 0 s" >xt" install
  ' begin 0 s" begin" install
  ' colon 0 s" :" install
  ' semicolon 1 s" ;" install
  ' immediate 0 s" immediate" install
  ' literal 0 s" literal" install
  ' compile, 0 s" compile," install
  ' quote-word 1 s" quote" install
  ' quote-word 1 s" '" install
  ' , 0 s" ," install
  ' c, 0 s" c," install
  ' line-comment 5 s" --" install
  ' qrecur 1 s" recur" install
  ' STATE 0 s" STATE" install
  ' HERE 0 s" HERE" install
  ' LATEST 0 s" LATEST" install
  ' [ 1 s" [[" install
  ' ] 0 s" ]]" install
  ' quote-open 5 s" [" install
  ' quote-close 1 s" ]" install
  ' prim, 0 s" prim," install
  ' 0= 0 s" 0=" install
  ' nip 0 s" nip" install
  ' qif 5 s" if" install
  ' then 1 s" then" install
  ' else 1 s" else" install
  ' cycle 1 s" cycle" install
  ' again 1 s" again" install
  ' until 1 s" until" install
  ' qwhile 5 s" while" install
  ' repeat 1 s" repeat" install
  ' qexit 1 s" exit" install
  ' times 5 s" times" install
  ' i0 1 s" i0" install
  ' i1 1 s" i1" install
  ' s" 1 sq-name install
  ' >r 1 s" >r" install
  ' r> 1 s" r>" install
  ' r@ 1 s" r@" install
  ' evaluate 0 s" evaluate" install
  ' negate 0 s" negate" install
  ' abs 0 s" abs" install
  ' lt? 0 s" lt?" install
  ' gt? 0 s" gt?" install
  ' lte? 0 s" lte?" install
  ' gte? 0 s" gte?" install
  ' + 0 s" +" install
  ' - 0 s" -" install
  ' * 0 s" *" install
  ' / 0 s" /" install
  ' mod 0 s" mod" install
  ' p-trap 32 prim-flag s" trap" install
  ' p-seal 26 prim-flag s" seal" install
  ' p-code-cid 27 prim-flag s" code-cid" install
  ' p-resolve 28 prim-flag s" resolve" install
  ' p-publish 29 prim-flag s" publish" install
  ' p-blob-cid 30 prim-flag s" blob-cid" install
  ' p-blob-read 31 prim-flag s" blob-read" install
  ' stack-effect 0 s" stack-effect" install
  ' hash-bytes 0 s" hash-bytes" install
  ' checked 0 s" checked" install
  ' unchecked 0 s" unchecked" install ;

-- ( data-region 0 length -- evaluate recover export )
: boot 4096 32 put 0 8 put 0 0 put
  1048576 region-new 624 put ' effect-of 616 put 0 632 put
  8192 region-new 736 put
  dup if restore else drop drop drop init then
  ' evaluate ' recover ' snapshot ;

' boot

-- March7 system layer, written in March.
--
-- Compiling this file with any equivalent system (the generation-zero listing
-- or an earlier generation of this file) defines a complete new system and
-- leaves the token of its `boot` word on the stack. `march7 IMAGE --system OUT`
-- then exports an image whose entry is that word.
--
-- Rule that makes generations identical: every *compiled* call in this file
-- targets a word defined earlier in this file. Words from the running
-- dictionary may be *executed* at compile time (`:` `;` `immediate` `[` ...),
-- because executing a word leaves no reference to it in the output. Within
-- this file, primitive names are immediate words that emit the primitive
-- itself (phase 2), so every compiler produces the same inlined code.
--
-- Working memory is region 1 (see docs/FIRST-SLICE.md):
--   0 STATE   8 LATEST   16 HERE (output offset)   24 output region
--   32 next dictionary byte   40/48/56 input region/length/position
--   64/72 current word start/length   80/88/96 unfinished definition name
--   128-440 private temporaries, 344 string start, 520/528 instruction scan
--   3840-4095 name of the unfinished definition
--   4096-1048575 dictionary
--
-- Trap codes: 1 unknown word, 2 decimal overflow, 4 missing word, 5 nested
-- definition, 6 `;` outside a definition, 7 bad dictionary data or name,
-- 8 unterminated string, 10 arithmetic overflow, 11 division by zero,
-- 12 dictionary full, 13 compile-only word used outside a definition.

-- Phase 1: throwaway compile-time helpers, built from the running dictionary.
-- They are only ever executed, so they never reach the exported image.
: [ 0 STATE ! ; immediate
: ] 1 STATE ! ;
: prim, 2 c, c, ;

-- Phase 2: primitives. The wrappers, one primitive op and a return each, are
-- what the exported dictionary binds (`dup` is `p.dup`, flagged inline), so
-- `' dup` and `call` work in the booted system.
: p.dup [ 0 prim, ] ;
: p.drop [ 1 prim, ] ;
: p.swap [ 2 prim, ] ;
: p.over [ 3 prim, ] ;
: p.rot [ 4 prim, ] ;
: p.u+ [ 5 prim, ] ;
: p.u- [ 6 prim, ] ;
: p.u* [ 7 prim, ] ;
: p.u/ [ 8 prim, ] ;
: p.umod [ 9 prim, ] ;
: p.eq? [ 10 prim, ] ;
: p.ult? [ 11 prim, ] ;
: p.and [ 12 prim, ] ;
: p.or [ 13 prim, ] ;
: p.xor [ 14 prim, ] ;
: p.invert [ 15 prim, ] ;
: p.lshift [ 16 prim, ] ;
: p.rshift [ 17 prim, ] ;
: p.c@ [ 18 prim, ] ;
: p.c! [ 19 prim, ] ;
: p.@ [ 20 prim, ] ;
: p.! [ 21 prim, ] ;
: p.region-new [ 22 prim, ] ;
: p.region-free [ 23 prim, ] ;
: p.region-size [ 24 prim, ] ;
: p.call [ 25 prim, ] ;
: p.seal [ 26 prim, ] ;
: p.code-cid [ 27 prim, ] ;
: p.resolve [ 28 prim, ] ;
: p.publish [ 29 prim, ] ;
: p.blob-cid [ 30 prim, ] ;
: p.blob-read [ 31 prim, ] ;
: p.trap [ 32 prim, ] ;
: p.f+ [ 36 prim, ] ;
: p.f- [ 37 prim, ] ;
: p.f* [ 38 prim, ] ;
: p.f/ [ 39 prim, ] ;
: p.feq? [ 40 prim, ] ;
: p.flt? [ 41 prim, ] ;
: p.i>f [ 42 prim, ] ;
: p.f>i [ 43 prim, ] ;

-- Within this file each primitive name is an immediate word that emits the
-- primitive op. So compiled code is inlined whatever system compiles this
-- file, and every generation produces the same bytes. These emitters are
-- compile-time devices: nothing exported refers to them, and this file never
-- uses a primitive name outside a definition.
: dup 0 prim, ; immediate
: drop 1 prim, ; immediate
: swap 2 prim, ; immediate
: over 3 prim, ; immediate
: rot 4 prim, ; immediate
: u+ 5 prim, ; immediate
: u- 6 prim, ; immediate
: u* 7 prim, ; immediate
: u/ 8 prim, ; immediate
: umod 9 prim, ; immediate
: eq? 10 prim, ; immediate
: ult? 11 prim, ; immediate
: and 12 prim, ; immediate
: or 13 prim, ; immediate
: xor 14 prim, ; immediate
: invert 15 prim, ; immediate
: lshift 16 prim, ; immediate
: rshift 17 prim, ; immediate
: c@ 18 prim, ; immediate
: c! 19 prim, ; immediate
: @ 20 prim, ; immediate
: ! 21 prim, ; immediate
: region-new 22 prim, ; immediate
: region-free 23 prim, ; immediate
: region-size 24 prim, ; immediate
: call 25 prim, ; immediate
: seal 26 prim, ; immediate
: code-cid 27 prim, ; immediate
: resolve 28 prim, ; immediate
: publish 29 prim, ; immediate
: blob-cid 30 prim, ; immediate
: blob-read 31 prim, ; immediate
: trap 32 prim, ; immediate
: f+ 36 prim, ; immediate
: f- 37 prim, ; immediate
: f* 38 prim, ; immediate
: f/ 39 prim, ; immediate
: feq? 40 prim, ; immediate
: flt? 41 prim, ; immediate
: i>f 42 prim, ; immediate
: f>i 43 prim, ; immediate
: mark 46 prim, ; immediate
: gather 47 prim, ; immediate
: vector-length 48 prim, ; immediate
: vector-at 49 prim, ; immediate
: vector-push 50 prim, ; immediate
: vector-set 51 prim, ; immediate
: make-text 52 prim, ; immediate
: seq-concat 53 prim, ; immediate
: seq-slice 54 prim, ; immediate
: seq-same? 55 prim, ; immediate
: map-gather 56 prim, ; immediate
: kv-put 57 prim, ; immediate
: kv-has? 58 prim, ; immediate
: kv-remove 59 prim, ; immediate
: kv-keys 60 prim, ; immediate
: kv-values 61 prim, ; immediate
: byte-find 62 prim, ; immediate
: byte-past 63 prim, ; immediate
: byte-upto 64 prim, ; immediate
: byte-hash 65 prim, ; immediate
: bytes-eq? 66 prim, ; immediate
: decimal 67 prim, ; immediate
: write 69 prim, ; immediate
: compare 70 prim, ; immediate
: search 71 prim, ; immediate
: text>integer 72 prim, ; immediate
: text>float 73 prim, ; immediate

-- Phase 3: clean base words.
: get [ 44 prim, ] ;
: put [ 45 prim, ] ;
: 0= 0 eq? ;
: nip swap drop ;
: out 24 get ;
: here 16 get ;
: c, out here c! here 1 u+ 16 put ;
: [ 0 0 put ; immediate
: ] 1 0 put ;
: prim, 2 c, c, ;
: u32, dup c, 8 rshift dup c, 8 rshift dup c, 8 rshift c, ;
: b! out swap c! ;
: u32! over over b! over 8 rshift over 1 u+ b! over 16 rshift over 2 u+ b! swap 24 rshift swap 3 u+ b! ;
-- Operand lengths of opcodes 0-9, six bits each: 1 9 2 33 33 5 5 1 33 33.
-- Opcode 10 (a float literal) has the length of opcode 1, and opcode 11 (a
-- tail recur) that of opcode 7, so they are mapped there first, without a
-- branch.
: oplen dup 10 eq? 9 u* u- dup 11 eq? 4 u* u- 6 u* 603768572619268673 swap rshift 63 and ;

-- Branch targets are instruction indexes, so count the instructions already
-- emitted into the output region. This is the one hand-assembled word: its
-- zero-branch (op 10) exits to op 28 and its branch (op 27) loops to op 6.
: ops
  0 520 put 0 528 put
  520 get here ult? [ 6 c, 28 u32, ]
  out 520 get c@ oplen 520 get u+ 520 put
  528 get 1 u+ 528 put
  [ 5 c, 6 u32, ]
  528 get ;

-- Phase 4: control flow. Forward references leave the byte position of a
-- four-byte branch operand; backward ones leave an instruction index.
: if 6 c, here 0 u32, ; immediate
: then ops swap u32! ; immediate
: else 5 c, here 0 u32, swap ops swap u32! ; immediate
: cycle ops ; immediate
: again 5 c, u32, ; immediate
: until 6 c, u32, ; immediate
: while 6 c, here 0 u32, ; immediate
: repeat swap 5 c, u32, ops swap u32! ; immediate
: exit 0 c, ; immediate
-- Dictionary flags: bit 0 immediate; bit 1 inline primitive, id in bits 8-15;
-- bit 2 transparent (an immediate word that leaves pending quotations alone);
-- bit 3 a family word, whose calls `;` resolves by type; bit 4 a generic
-- word, whose calls `;` may replace with an instance for their input types;
-- bits 5 and 6 the array brackets `(` and `)`, which top level runs inline.
: immediate 8 get dup 0= if 7 trap then 16 u+ dup get 1 or swap put ;
: prim-flag 8 lshift 2 or ;

-- From here on, `get` and `put` compile inline, as one primitive each: a
-- load or store in working region 1 (44, 45). Words above keep calling them,
-- which the hand-counted `ops` relies on; they only run at compile time.
: get 44 prim, ; immediate
: put 45 prim, ; immediate

-- The byte emitters again, now with `get` and `put` inline; words above keep
-- the first `c,` and `prim,`. Then `0=`, `out` and `here` compile inline too.
-- `0=` is exported as `p.0=`, a function with the same code. The wrappers
-- share the namespace-style prefix `p.`, for primitive.
: c, 24 get 16 get c! 16 get 1 u+ 16 put ;
: prim, 2 c, c, ;
-- A cell, little endian: eight bytes, unrolled.
: , dup c, 8 rshift dup c, 8 rshift dup c, 8 rshift dup c, 8 rshift
  dup c, 8 rshift dup c, 8 rshift dup c, 8 rshift c, ;
: literal 1 c, , ;
: fliteral 10 c, , ;
: p.0= 0 eq? ;
: 0= 0 literal 10 prim, ; immediate
: out 24 literal 44 prim, ; immediate
: here 16 literal 44 prim, ; immediate

-- Instruction counts, kept incrementally so a control word does not recount
-- the whole definition: 848 is the output region counted, 856 the byte offset
-- reached, 864 the instructions before it. A different region, or an offset
-- behind the one reached, counts again from the start. The control words
-- that need a count are redefined to use it.
: ops
  out 848 get eq? 0= here 856 get ult? or if out 848 put 0 856 put 0 864 put then
  cycle 856 get here ult? while
    out 856 get c@ oplen 856 get u+ 856 put
    864 get 1 u+ 864 put
  repeat 864 get ;
: then ops swap u32! ; immediate
: else 5 c, here 0 u32, swap ops swap u32! ; immediate
: cycle ops ; immediate
: repeat swap 5 c, u32, ops swap u32! ; immediate

-- Phase 5: the scratch stack, for temporaries that must survive calls.
-- It belongs to the machine, not region 1. Every call gets its own scratch
-- frame, and returning discards whatever the word left there, so a word can
-- neither leave hidden outputs nor read its caller's values. The words are
-- compile-only and always emit the primitive inline: a call to a wrapper
-- would discard the value on the wrapper's own return.
: compile-only 0 get 0= if 13 trap then ;
: >r compile-only 33 prim, ; immediate
: r> compile-only 34 prim, ; immediate
: r@ compile-only 35 prim, ; immediate

-- Phase 6: the compiler.
: inc-pos 56 get 1 u+ 56 put ;
: input-char 40 get 56 get c@ ;

-- ( src-region src-offset dst-region dst-offset n -- )
: copy 128 put 136 put 144 put 152 put 160 put
  cycle 128 get while
    160 get 152 get c@ 144 get 136 get c!
    152 get 1 u+ 152 put
    136 get 1 u+ 136 put
    128 get 1 u- 128 put
  repeat ;

-- FNV-1a over bytes, finished with the MurmurHash3 64-bit mixer: the same
-- function as merkle-champ's `hash_bytes`, so a name hashes the same in the
-- working dictionary and in a store.
: mix64 dup 33 rshift xor -49064778989728563 u* dup 33 rshift xor
  -4265267296055464877 u* dup 33 rshift xor ;
-- ( region offset length -- hash )
: hash-bytes dup >r byte-hash r> xor mix64 ;

-- The dictionary is hashed: 1,024 buckets in the region whose handle is at
-- working offset 736, each the head of a chain through the entries' bucket
-- links, newest first, so the newest definition of a name is found first.
-- An entry is: previous entry (LATEST chain), token, flags, name length, next
-- entry in its bucket, then the name bytes from offset 40.
-- `read-word` hashes each word as it reads it (FNV-1a) and keeps that at 816
-- with the word's region, offset and length (824-840), so finding the word
-- just read needs no second pass over its bytes; only the length and mix64
-- remain. Any other name is hashed here in full.
-- ( region offset length -- region offset length flag )
: cached-hash?
  dup 840 get eq? 0= if 0 exit then
  over 832 get eq? 0= if 0 exit then
  rot dup 824 get eq? >r rot rot r> ;
-- ( region offset length -- hash )
: name-hash cached-hash? if drop drop drop 816 get 840 get xor mix64 else hash-bytes then ;
-- ( region offset length -- bucket-offset )
: name-bucket name-hash 1023 and 8 u* ;

-- ( xt flags name-region name-offset length -- )
-- The entry is complete before LATEST or its bucket points at it.
: install 176 put 184 put 192 put 200 put 208 put
  176 get dup 0= swap 256 ult? 0= or if 7 trap then
  32 get 216 put
  216 get 40 u+ 176 get u+ 7 u+ -8 and dup 1048576 1 u+ ult? 0= if 12 trap then 224 put
  8 get 216 get put
  208 get 216 get 8 u+ put
  200 get 216 get 16 u+ put
  176 get 216 get 24 u+ put
  192 get 184 get 1 216 get 40 u+ 176 get copy
  192 get 184 get 176 get name-bucket 232 put
  736 get 232 get @ 216 get 32 u+ put
  224 get 32 put
  216 get 8 put
  216 get 736 get 232 get ! ;

-- ( region offset length -- entry | 0 )
: find 256 put 248 put 240 put
  736 get 240 get 248 get 256 get name-bucket @ 264 put
  cycle 264 get while
    264 get 24 u+ get 256 get eq? if
      240 get 248 get 1 264 get 40 u+ 256 get bytes-eq? if 264 get exit then
    then
    264 get 32 u+ get 264 put
  repeat 0 ;

: token 40 get 64 get 72 get ;

-- ( -- flag ) Skip whitespace, then take the next whitespace-delimited word,
-- and hash its bytes (FNV-1a, as `hash-bytes` begins) for `find`. The byte
-- primitives do the scanning and hashing, so no loop runs per byte here.
: read-word
  40 get 56 get 48 get 32 byte-past
  dup 56 put dup 64 put
  48 get ult? 0= if 0 72 put 0 exit then
  40 get 64 get 48 get 32 byte-upto
  dup 56 put 64 get u- 72 put
  40 get 64 get 72 get byte-hash 816 put
  40 get 824 put 64 get 832 put 72 get 840 put 1 ;

: word read-word 0= if 4 trap then token ;

: scan-char 40 get 288 get c@ ;
: scan-inc 288 get 1 u+ 288 put ;

-- ( -- n 1 | 0 ) Signed decimal. A decimal that does not fit traps (2)
-- instead of falling through to a dictionary word with that spelling.
: int-number
  64 get 288 put 64 get 72 get u+ 296 put 0 304 put
  scan-char 45 eq? if 1 304 put scan-inc else scan-char 43 eq? if scan-inc then then
  288 get 296 get eq? if 0 exit then
  40 get 288 get 296 get 288 get u- decimal
  dup 0= if drop drop 0 exit then
  2 eq? if 2 trap then
  dup 9223372036854775807 304 get u+ swap ult? if 2 trap then
  304 get if 0 swap u- then 1 ;

-- Float literals: [sign] digits [. digits] [e|E [sign] digits], with a dot or
-- an exponent (so `1.` is a word, not a number). The value is correctly rounded
-- on the exact fast path: a mantissa of at most 2^53 scaled by a power of ten
-- up to 10^22, one multiplication or division (Clinger's fast path, extended by
-- moving excess powers of ten into the mantissa while it stays exact). Anything else traps (21) rather
-- than round wrongly. Zeros are deferred until a nonzero digit follows, so
-- trailing zeros never cost precision. Working memory: 3440 negative,
-- 3448 mantissa, 3456 decimal exponent biased by 1000, 3464 digit count,
-- 3472 seen a dot or exponent, 3480 exponent value, 3488 exponent negative,
-- 3496 deferred zeros.
-- ( -- digit 1 | 0 )
: scan-digit 288 get 296 get ult? if scan-char 48 u- dup 10 ult? if 1 exit then drop then 0 ;
-- ( digit -- )
: mantissa-push
  9007199254740992 over u- 10 u/ 3448 get ult? if 21 trap then
  3448 get 10 u* u+ 3448 put ;
-- ( digit -- )
: mantissa-digit
  dup 0= if drop 3496 get 1 u+ 3496 put exit then
  cycle 3496 get while 0 mantissa-push 3496 get 1 u- 3496 put repeat
  mantissa-push ;
-- ( k -- f ) 10^k as a float, exact for k <= 22.
: pow10 1 i>f swap cycle dup while 10 i>f rot f* swap 1 u- repeat drop ;
-- ( -- bits )
: float-value
  3448 get 0= if 0 else
    -- Extended fast path: move excess powers of ten into the mantissa while
    -- it stays at most 2^53, which is exact.
    cycle 1022 3456 get ult? if 3448 get 900719925474100 ult? else 0 then while
      3448 get 10 u* 3448 put 3456 get 1 u- 3456 put
    repeat
    3456 get 978 ult? 1022 3456 get ult? or if 21 trap then
    3448 get i>f
    3456 get 1000 ult? if 1000 3456 get u- pow10 f/ else 3456 get 1000 u- pow10 f* then
  then
  3440 get if 9223372036854775807 1 u+ xor then ;
-- ( -- bits 2 | 0 )
: parse-float
  64 get 288 put 64 get 72 get u+ 296 put
  0 3440 put 0 3448 put 1000 3456 put 0 3464 put 0 3472 put 0 3496 put
  scan-char 45 eq? if 1 3440 put scan-inc else scan-char 43 eq? if scan-inc then then
  cycle scan-digit while mantissa-digit 3464 get 1 u+ 3464 put scan-inc repeat
  3464 get 0= if 0 exit then
  288 get 296 get ult? if scan-char 46 eq? if
    scan-inc 0 3464 put 1 3472 put
    cycle scan-digit while
      mantissa-digit 3456 get 1 u- 3456 put 3464 get 1 u+ 3464 put scan-inc
    repeat
    3464 get 0= if 0 exit then
  then then
  288 get 296 get ult? if scan-char 32 or 101 eq? if
    scan-inc 1 3472 put 0 3480 put 0 3488 put 0 3464 put
    288 get 296 get ult? if
      scan-char 45 eq? if 1 3488 put scan-inc else scan-char 43 eq? if scan-inc then then
    then
    cycle scan-digit while
      3480 get 10 u* u+ dup 400 ult? 0= if 21 trap then 3480 put
      3464 get 1 u+ 3464 put scan-inc
    repeat
    3464 get 0= if 0 exit then
    3488 get if 3456 get 3480 get u- else 3456 get 3480 get u+ then 3456 put
  then then
  288 get 296 get eq? 0= if 0 exit then
  3472 get 0= if 0 exit then
  3456 get 3496 get u+ 3456 put
  float-value 2 ;

-- ( -- flag ) Could the current word be a number? It starts with a digit, or
-- with a sign followed by a digit. Most words fail this at once, which spares
-- them both number parsers.
: numeric-start?
  40 get 64 get c@ dup 48 u- 10 ult? if drop 1 exit then
  dup 45 eq? swap 43 eq? or 0= if 0 exit then
  72 get 2 ult? if 0 exit then
  40 get 64 get 1 u+ c@ 48 u- 10 ult? ;
-- ( -- n kind | 0 ) Kind 1 is an integer, kind 2 a float.
: number numeric-start? 0= if 0 exit then int-number dup if exit then drop parse-float ;

-- Tail calls: a call or `recur` emitted just before a return becomes a tail
-- call (9) or a tail recur (11), so recursion in tail position runs in
-- constant space. The return stays, for branches that target it. 944 holds
-- where the last call or recur was emitted, 952 the region it went to.
: mark-call here 944 put out 952 put ;
: tailify
  952 get out eq? 0= if exit then
  out 944 get c@
  dup 3 eq? if drop 944 get 33 u+ here eq? if 9 out 944 get c! then exit then
  7 eq? if 944 get 1 u+ here eq? if 11 out 944 get c! then then ;
: compile, mark-call 3 c, out here code-cid here 32 u+ 16 put ;
: compile-quote 4 c, out here code-cid here 32 u+ 16 put ;

-- Stack effects (checker, slice 1). A word's effect is how many cells it
-- takes and leaves. The checker derives it from the word's canonical code
-- bytes, so it is exact whatever syntax produced the code, and it works the
-- same on a definition being built and on sealed code read back by CID.
-- Effects are computed on demand and remembered per session (never stored
-- in images). See docs/CHECKER.md.
--
-- Packed effect: bit 0 computed, bit 1 known, bits 8-23 inputs (or, when
-- unknown, the reason), bits 24-39 outputs. Reasons: 1 dynamic call, 2 calls
-- a word whose effect is unknown, 3 branches meet at different depths, 4 a
-- loop changes the depth, 5 returns leave different depths, 6 scratch pop
-- below the word's frame, 7 never returns, 8 recursion inconsistent with its
-- base case, 10 limits, 11 invalid code.
-- ( in out -- packed )
: effect-pack 24 lshift swap 8 lshift or 3 or ;
-- ( reason -- packed )
: effect-unknown 8 lshift 1 or ;
-- ( packed -- flag )
: effect-known? 1 rshift 1 and ;
-- ( packed -- n )
: effect-in 8 rshift 65535 and ;
-- ( packed -- n )
: effect-out 24 rshift 65535 and ;

-- Inputs and outputs of primitives 0-31, two bits each. Execute (25), trap
-- (32) and the scratch primitives (33-35) are handled specially.
-- ( id -- n )
: prim-in 2 u* -4687861376211047515 swap rshift 3 and ;
-- ( id -- n )
: prim-out 2 u* -4246594190310025246 swap rshift 3 and ;

-- Each analysis has its own region, so analyses nest (a call analyses its
-- callee). Its handle is at working offset 600. Fields: 0 code region,
-- 8 code length, 16 op count, 24 current op, 32 its byte offset, 40 live,
-- 48 depth, 56 scratch depth, 64 effect of a quotation on top (or 0),
-- 72 lowest depth, 80 returned?, 88 return depth, 96 unknown reason,
-- 104 pass, 112 assumed own effect, 120 recurs?, 128 the types of the first
-- eight scratch slots, a byte each, 136 a loop header's types were widened,
-- 144-200 and 232-248 temporaries, 208 a type error's trap (23 a family
-- call's known types matched no clause, 26 an array used as a condition),
-- 216 the types the inputs start with (from working offset 3520), 224 the
-- code calls a family word or a generic word. Type blocks of 64 bytes: live
-- types at 256, types at return at 320, a scratch block at 384.
-- Depths are biased by 2^32 so that unsigned comparison works. Per-op tables
-- start at 512: 0 byte offset; 1-4 state from forward branches (set?, depth,
-- scratch, quotation); 5-7 state on arrival (set?, depth, scratch); 8 loop
-- header?; 9 scratch types from forward branches; 10 a loop header's
-- scratch types; 11 a loop header's types recorded?; 12 the clause chosen
-- for a family call; 13 the literal before it is to become a float. Per-op type
-- blocks follow: types from forward branches, then types on arrival.
-- ( field -- v )
: an@ 600 literal 44 prim, 2 prim, 20 prim, ; immediate
-- ( v field -- )
: an! 600 literal 44 prim, 2 prim, 21 prim, ; immediate
-- ( k table -- field )
: tab 16 an@ 8 u* u* 512 u+ swap 8 u* u+ ;
-- ( k table -- v )
: tab@ tab an@ ;
-- ( v k table -- )
: tab! tab an! ;
-- ( pos -- byte )
: code@ 0 an@ swap c@ ;
-- ( pos -- n )
: code-u32
  dup code@ over 1 u+ code@ 8 lshift or
  over 2 u+ code@ 16 lshift or swap 3 u+ code@ 24 lshift or ;

-- ( region length -- n )
: count-ops
  656 put 648 put 0 664 put 0 672 put
  cycle 664 get 656 get ult? while
    648 get 664 get c@ oplen 664 get u+ 664 put
    672 get 1 u+ 672 put
  repeat 672 get ;

-- ( region length -- )
: analysis-begin
  over over count-ops dup 240 u* 512 u+ region-new 600 put
  968 get 1 eq? if 600 get 968 put then
  3520 get 216 an! 0 3520 put
  16 an! 8 an! 0 an!
  0 32 an! 0 24 an!
  cycle 24 an@ 16 an@ ult? while
    32 an@ 24 an@ 0 tab!
    32 an@ code@ oplen 32 an@ u+ 32 an!
    24 an@ 1 u+ 24 an!
  repeat
  -- Mark loop headers: targets of backward branches.
  0 24 an!
  cycle 24 an@ 16 an@ ult? while
    24 an@ 0 tab@ dup code@ dup 5 eq? swap 6 eq? or if
      1 u+ code-u32 dup 24 an@ 1 u+ ult? if 1 swap 8 tab! else drop then
    else drop then
    24 an@ 1 u+ 24 an!
  repeat ;

-- Value types (checker slice 2): 0 unknown, 1 i64, 2 f64, a byte each. They
-- are kept by stack position in 64-byte blocks: position p is the cell at
-- depth p - 32 relative to the word's entry, so its inputs are 31, 30, and so
-- on down. A position outside the block is lost (255), which no clause
-- matches, so a family call on it is an error rather than a guess.
-- ( n -- mask ) The bytes of the top n slots, packed.
: ty-mask dup 8 ult? if 8 u* 1 swap lshift 1 u- else drop -1 then ;
-- ( -- d ) The position above the top slot.
: ty-depth 48 an@ 4294967264 u- ;
-- ( i -- p ) The position of the i-th slot from the top.
: ty-pos ty-depth swap u- 1 u- ;
-- ( i -- t )
: ty@ ty-pos dup 64 ult? if 256 u+ 600 get swap c@ else drop 255 then ;
-- ( t i -- )
: ty! ty-pos dup 64 ult? if 256 u+ 600 get swap c! else drop drop then ;
-- ( t -- ) Set the top slot's type.
: ty-set 0 ty! ;
-- ( n -- packed ) The top n slots' types (at most eight), the top first.
: ty-top
  dup 8 ult? 0= if drop 8 then
  0 swap
  cycle dup while 1 u- dup ty@ rot 8 lshift or swap repeat drop ;
-- ( packed n -- ) Set the top n slots' types from packed ones, the top
-- first; slots past the eighth are lost.
: ty-put
  240 an! 232 an! 0 248 an!
  cycle 248 an@ 240 an@ ult? while
    248 an@ 8 ult? if 232 an@ 248 an@ 8 u* rshift 255 and else 255 then
    248 an@ ty!
    248 an@ 1 u+ 248 an!
  repeat ;
-- ( in out -- ) Clear the positions a step pops and pushes, from its first
-- input up to the higher of the old and new tops.
: ty-clear
  over >r over over ult? if swap then drop
  ty-depth r> u- swap
  cycle dup while
    1 u- over over u+ dup 64 ult? if 256 u+ 0 swap 600 get swap c! else drop then
  repeat drop drop ;

-- Arrays (docs/ARRAYS.md) have types by element type and rank: 3, 4 and 5
-- are arrays of i64, of f64 and of unknown elements; each rank adds 3, up to
-- 230, so 6 is an array of arrays of i64. 252 is an array whose elements'
-- known types differ, 254 an empty array, whose elements have no type yet.
-- 253 is a string (docs/STRINGS.md), which is not an array to the checker:
-- families do not lift over its characters, and 247 an array of strings.
-- 231 to 246 are maps (below).
-- ( t -- flag )
: array-type?
  dup 252 eq? over 254 eq? or over 247 eq? or if drop 1 exit then
  dup 3 ult? 0= swap 231 ult? and ;
-- ( t -- t' ) The type of an array of elements of type t.
: array-of
  dup 0= if drop 5 exit then
  dup 253 eq? if drop 247 exit then
  dup 3 ult? if 2 u+ exit then
  dup 228 ult? if 3 u+ else drop 5 then ;
-- Maps (docs/MAPS.md) have types by their keys' and values' kinds:
-- 231 + 5k + v, with the key kind k 0 unknown, 1 i64 or 2 string, and the
-- value kind v 0 unknown, 1 i64, 2 f64 or 3 string. 246 is the empty map.
-- ( t -- flag )
: map-type? dup 231 ult? 0= swap 247 ult? and ;
-- ( t -- k ) ( t -- v ) The kinds of a key or value of type t.
: key-kind dup 1 eq? if drop 1 exit then 253 eq? if 2 else 0 then ;
: value-kind
  dup 1 eq? if drop 1 exit then dup 2 eq? if drop 2 exit then
  253 eq? if 3 else 0 then ;
-- ( k v -- t )
: map-of swap 5 u* u+ 231 u+ ;
-- ( t -- k ) ( t -- v ) A map type's key and value kinds.
: map-key 231 u- 5 u/ ;
: map-value 231 u- 5 umod ;
-- ( v -- t ) The type of a value of kind v; a key's for k.
: kind-type dup 3 eq? if drop 253 then ;
: key-type dup 2 eq? if drop 253 then ;
-- ( a b -- c ) a if the kinds agree, otherwise unknown.
: agree over eq? 0= if drop 0 then ;
-- ( k so-far -- k' ) Add a kind: the first one taken (none is -1).
: kind-join dup -1 eq? if drop exit then agree ;
-- ( tm tk tv -- t ) A map's type after a key and value of these types are
-- put into it.
: map-put-type
  value-kind >r key-kind >r
  dup 246 eq? if drop r> r> map-of exit then
  dup map-type? 0= if drop r> drop r> drop 0 exit then
  dup map-key r> agree swap map-value r> agree map-of ;
-- ( t -- t' ) The type of an array's elements: one rank less, unknown for
-- mixed elements, i64 for an empty array (as for an integer literal). A value
-- that is not an array is its own element, for lifting it against an array.
: element-type
  dup array-type? 0= if exit then
  dup 247 eq? if drop 253 exit then
  dup 6 ult? if 2 u- dup 3 eq? if drop 0 then exit then
  dup 252 ult? if 3 u- exit then
  254 eq? if 1 else 0 then ;
-- ( t -- t' ) The type at the bottom of nested arrays.
: base-type cycle dup array-type? while element-type repeat ;
-- Element summaries: what the elements of an array being built have in
-- common. Bits 0-7 a known type, 8 one is known, 9 one is unknown, 10 two
-- known types differ.
-- ( s t -- s' ) Add an element of type t. An empty array (254) agrees with
-- any array type.
: ty-join
  dup 0= over 255 eq? or if drop 512 or exit then
  over 256 and if
    over 255 and over eq? if drop exit then
    dup 254 eq? if over 255 and array-type? if drop exit then then
    over 255 and 254 eq? if dup array-type? if swap -256 and or exit then then
    drop 1024 or exit
  then
  256 or or ;
-- ( s -- t ) The array type for a summary.
: summary-type
  dup 1024 and if drop 252 exit then
  dup 512 and if drop 5 exit then
  dup 256 and if 255 and array-of exit then
  drop 254 ;
-- ( ta tx -- t ) An array's type after a value of type tx is pushed onto it
-- or set in it.
: push-type
  over array-type? 0= if drop exit then
  over 254 eq? if nip array-of exit then
  over 252 eq? if drop exit then
  swap element-type 0 swap ty-join swap ty-join summary-type ;
-- ( x y -- z ) Where paths meet, a slot's types: an empty array meeting an
-- array becomes that array's type, and an empty map meeting a map that
-- map's, so a result built in a loop keeps its type; other types that
-- differ become unknown.
: join1
  over over eq? if drop exit then
  over 254 eq? if dup array-type? if nip exit then then
  dup 254 eq? if over array-type? if drop exit then then
  over 246 eq? if dup map-type? if nip exit then then
  dup 246 eq? if over map-type? if drop exit then then
  drop drop 0 ;
-- ( a b -- c ) join1 for each byte of two cells of types, for the data
-- stack's blocks and the scratch slots.
: sc-join
  over over eq? if drop exit then
  0 144 an! 0
  cycle dup 64 ult? while
    >r over r@ rshift 255 and over r@ rshift 255 and join1
    r@ lshift 144 an@ or 144 an! r> 8 u+
  repeat drop drop drop 144 an@ ;
-- ( t -- ) Set the type of the scratch slot about to be pushed; slots past
-- the eighth are not kept.
: sc! 56 an@ dup 8 ult? if 128 u+ 600 get swap c! else drop drop then ;
-- ( -- t ) The type of the top scratch slot.
: sc@ 56 an@ 1 u- dup 8 ult? if 128 u+ 600 get swap c@ else drop 0 then ;
-- ( k b -- offset ) Op k's type block b: 0 from forward branches, 1 on arrival.
: blk 16 an@ 64 u* u* 16 an@ 112 u* 512 u+ u+ swap 64 u* u+ ;
-- ( from to -- ) Copy a type block.
: blk-copy 0 cycle dup 64 ult? while
    >r over r@ u+ an@ over r@ u+ an! r> 8 u+ repeat drop drop drop ;
-- ( from to -- ) Merge a type block into another.
: blk-merge 0 cycle dup 64 ult? while
    >r over r@ u+ an@ over r@ u+ an@ sc-join over r@ u+ an! r> 8 u+
  repeat drop drop drop ;
-- ( a b -- flag ) Whether two type blocks are equal.
: blk-eq? 0 >r 0
  cycle dup 64 ult? while
    >r over r@ u+ an@ over r@ u+ an@ xor r> r> rot or >r 8 u+
  repeat drop drop drop r> 0= ;
-- ( -- ) The types a pass starts with: unknown, except the inputs' types it
-- was given (field 216, packed, the top first).
: ty-seed
  0 cycle dup 128 ult? while 0 over 256 u+ an! 8 u+ repeat drop
  0 cycle dup 8 ult? while
    216 an@ over 8 u* rshift 255 and over 31 swap u- 256 u+ 600 get swap c!
    1 u+
  repeat drop ;
-- ( -- packed ) The types of the top eight slots at return, the top first.
: ret-types
  0 232 an! 8 248 an!
  cycle 248 an@ while
    248 an@ 1 u- 248 an!
    88 an@ 4294967264 u- 248 an@ u- 1 u-
    dup 64 ult? if 320 u+ 600 get swap c@ else drop 255 then
    232 an@ 8 lshift or 232 an!
  repeat 232 an@ ;

-- ( reason -- )
: fail 96 an@ 0= if 96 an! else drop then 16 an@ 24 an! 0 40 an! ;
-- ( in out -- )
: apply over over ty-clear
  swap 48 an@ swap u- dup 72 an@ ult? if dup 72 an! then u+ 48 an! ;
-- An open mark (fields 456-504) holds the depth at `mark` in bits 0-47, the
-- summary of the elements seen where paths met in bits 48-58, and whether
-- the count varies in bit 63.
-- ( depth -- flag ) Inside an array literal, a count that varies (a loop or
-- branch that changes the depth) is fine: `gather` takes whatever is above
-- its mark. So if a mark is open and both this depth and the current one are
-- at or above it, mark the literal as varying (bit 63 of its mark) and go on.
: vary?
  448 an@ 0= if drop 0 exit then
  448 an@ 1 u- 8 u* 456 u+ dup an@ 281474976710655 and
  rot over ult? 0= swap 48 an@ swap ult? 0= and
  dup if over an@ -9223372036854775808 or rot an! else nip then ;
-- ( block depth -- t ) The type of the slot at a depth, in a type block.
: slot-type
  4294967264 u- dup 64 ult? if u+ 600 get swap c@ else drop drop 255 then ;
-- ( s block from to -- s' ) Add the slots from depth from up to to, in a
-- type block, to an element summary.
: join-slots
  >r
  cycle dup r@ ult? while
    over over slot-type >r rot r> ty-join rot rot 1 u+
  repeat r> drop drop drop ;
-- ( block depth -- ) Where paths meet at different depths inside a literal,
-- add both paths' slots above its mark to its summary: the current ones and
-- the other path's, in block up to depth. So the literal's type covers every
-- element either path leaves.
: vary-join
  448 an@ 1 u- 8 u* 456 u+ 152 an!
  152 an@ an@ 281474976710655 and 160 an!
  152 an@ an@ 48 rshift 2047 and
  256 160 an@ 48 an@ join-slots
  rot rot 160 an@ swap join-slots
  48 lshift 152 an@ an@ dup 48 rshift 2047 and 48 lshift xor or 152 an@ an! ;
-- ( target -- )
: pend
  dup 1 tab@ if
    dup 3 tab@ 56 an@ eq? 0= if drop 3 fail exit then
    dup 2 tab@ 48 an@ eq? 0= if dup 2 tab@ vary? 0= if drop 3 fail exit then
      dup 0 blk over 2 tab@ vary-join then
    dup 4 tab@ 64 an@ eq? 0= if 0 over 4 tab! then
    dup 9 tab@ 128 an@ sc-join over 9 tab!
    256 over 0 blk blk-merge drop
  else
    1 over 1 tab! 48 an@ over 2 tab! 56 an@ over 3 tab! 64 an@ over 4 tab!
    128 an@ over 9 tab!
    256 swap 0 blk blk-copy
  then ;
-- ( target -- )
-- A back edge whose types differ from the loop header's widens them, and the
-- pass runs again until they are stable.
: back
  dup 1 blk 384 blk-copy 256 384 blk-merge
  dup 1 blk 384 blk-eq? 0= if 384 over 1 blk blk-copy 1 136 an! then
  dup 10 tab@ dup 128 an@ sc-join dup rot eq? if drop else over 10 tab! 1 136 an! then
  dup 7 tab@ 56 an@ eq? 0= if drop 4 fail exit then
  dup 6 tab@ 48 an@ eq? if drop exit then
  dup 6 tab@ vary? 0= if drop 4 fail exit then
  dup 1 blk swap 6 tab@ vary-join ;
-- ( -- )
: arrive
  24 an@ 1 tab@ if
    40 an@ if
      24 an@ 3 tab@ 56 an@ eq? 0= if 3 fail exit then
      24 an@ 2 tab@ 48 an@ eq? 0= if 24 an@ 2 tab@ vary? 0= if 3 fail exit then
        24 an@ 0 blk 24 an@ 2 tab@ vary-join then
      24 an@ 4 tab@ 64 an@ eq? 0= if 0 64 an! then
      24 an@ 0 blk 256 blk-merge
      24 an@ 9 tab@ 128 an@ sc-join 128 an!
    else
      24 an@ 2 tab@ 48 an! 24 an@ 3 tab@ 56 an! 24 an@ 4 tab@ 64 an! 1 40 an!
      24 an@ 0 blk 256 blk-copy
      24 an@ 9 tab@ 128 an!
    then
  then
  40 an@ if
    24 an@ 8 tab@ if
      0 64 an!
      24 an@ 11 tab@ if
        24 an@ 1 blk 256 blk-merge 24 an@ 10 tab@ 128 an@ sc-join 128 an!
      else 1 24 an@ 11 tab! then
      128 an@ 24 an@ 10 tab!
    then
    1 24 an@ 5 tab! 48 an@ 24 an@ 6 tab! 56 an@ 24 an@ 7 tab!
    256 24 an@ 1 blk blk-copy
  then ;

-- The effect of a callee, through the word stored at working offset 616
-- (`effect-of`, defined below).
-- ( token -- packed )
: callee-effect 616 get call ;
-- ( -- token )
: callee-token 0 an@ 32 an@ 1 u+ resolve ;
-- ( -- packed )
: callee callee-token callee-effect ;
-- ( outs token -- ) Give a call's outputs its callee's output types, which
-- `effect-of` keeps in the table at working offset 712.
: callee-types 8 u* 712 get swap @ swap ty-put ;
-- ( token -- )
: call-effect
  dup callee-effect dup effect-known? if
    dup effect-in swap effect-out dup >r apply r> swap callee-types 0 64 an!
  else drop drop 2 fail then ;

-- Families (checker slice 2). A family word, such as `+`, is the i64
-- version; its clauses for other input types are in a registry, a region
-- whose handle is at 728: a count, then entries of four cells: family token,
-- clause token, input types (a byte each, the top first) and their count.
-- When a definition has compiled a call to a family (960), `;` resolves it:
-- the typed analysis picks the clause matching each call's input types, and
-- the call is patched to it (968 marks that analysis). Working memory 976-1000
-- is for lookups. An entry's fifth cell is its result's type, or 0 to take it
-- from the clause's own analysis; `find-clause` leaves it at 792.
-- ( family clause types count outtype -- )
: add-clause
  728 get 0 @ dup 64 ult? 0= if 22 trap then
  40 u* 8 u+ >r
  728 get r@ 32 u+ ! 728 get r@ 24 u+ ! 728 get r@ 16 u+ ! 728 get r@ 8 u+ ! 728 get r> !
  728 get 0 @ 1 u+ 728 get 0 ! ;
-- ( token types -- clause | 0 )
: find-clause
  976 put 984 put 0 992 put
  cycle 992 get 728 get 0 @ ult? while
    992 get 40 u* 8 u+ 1000 put
    728 get 1000 get @ 984 get eq? if
      976 get 728 get 1000 get 24 u+ @ ty-mask and 728 get 1000 get 16 u+ @ eq? if
        728 get 1000 get 32 u+ @ 792 put
        728 get 1000 get 8 u+ @ exit
      then
    then
    992 get 1 u+ 992 put
  repeat 0 ;
-- ( token -- flag )
: family?
  0 992 put
  cycle 992 get 728 get 0 @ ult? while
    728 get 992 get 40 u* 8 u+ @ over eq? if drop 1 exit then
    992 get 1 u+ 992 put
  repeat drop 0 ;
-- ( -- flag ) Whether the top slot is an integer literal just emitted: the
-- previous op is opcode 1 and nothing branches to this one.
: retype-ok?
  24 an@ dup 0= if exit then
  dup 1 tab@ over 8 tab@ or if drop 0 exit then
  1 u- 0 tab@ code@ 1 eq? 0 ty@ 1 eq? and ;
-- ( token types -- flag ) Whether a family call's inputs are all known and
-- not all i64, so that falling back to the i64 version would be wrong.
: types-mismatch?
  swap callee-effect effect-in ty-mask >r r@ and
  dup dup 4 rshift or dup 2 rshift or dup 1 rshift or 72340172838076673 and
  72340172838076673 r@ and eq?
  swap 72340172838076673 r> and eq? 0= and ;
-- ( token -- token 0 | 1 ) A family call with an array input and no clause
-- of its own: the lifted word for it (from `lift-for`, through the token at
-- working offset 3392), which applies the element operation to each element.
: lift-step
  dup 1 ty@ 0 ty@ 3392 get call dup if >r nip 24 an@ 12 tab! 2 1 apply r> ty-set 0 64 an! 1 exit then drop
  retype-ok? 1 ty@ dup array-type? swap base-type 2 eq? and and 0= if 0 exit then
  dup 1 ty@ 2 3392 get call dup 0= if exit then
  >r nip 1 24 an@ 13 tab! 24 an@ 12 tab! 2 1 apply r> ty-set 0 64 an! 1 ;
-- ( token -- token 0 | 1 ) A family call in the definition being resolved:
-- the clause for its input types, or one for a float in place of the integer
-- literal just before it (`x 1 +` with x an f64). With neither, it stays a
-- call to the family word, an error if its inputs are known and not i64.
: family-step
  dup family? 0= if 0 exit then
  dup 8 ty-top find-clause dup if
    nip dup 24 an@ 12 tab! call-effect 792 get dup if ty-set else drop then 1 exit
  then drop
  retype-ok? if
    dup 8 ty-top -256 and 2 or find-clause dup if
      nip 1 24 an@ 13 tab! dup 24 an@ 12 tab! 2 ty-set call-effect 1 exit
    then drop
  then
  lift-step if 1 exit then
  dup 8 ty-top types-mismatch? if 23 208 an! then 0 ;

-- Generic words: a word whose code still calls a family word, or another
-- generic word, has bit 40 set in its effect. A call to one with an f64 among
-- its inputs gets an instance: its code compiled again with those input
-- types, through `instantiate` (its token is at working offset 3504).
-- ( token -- flag )
: generic? callee-effect 40 rshift 1 and ;
-- ( types -- flag ) Whether any slot is an f64 or an array, which an
-- instance would treat differently from the i64 version.
: wants-instance?
  0 swap cycle dup while
    dup 255 and dup 2 ult? 0= swap 255 ult? and rot or swap 8 rshift
  repeat drop ;
-- ( token -- token 0 | 1 )
: instance-step
  dup generic? 0= if 0 exit then
  dup callee-effect effect-in ty-top
  dup wants-instance? 0= if drop 0 exit then
  over swap 3504 get call
  nip dup 24 an@ 12 tab! call-effect 1 ;

-- ( -- )
: do-return
  80 an@ if 88 an@ 48 an@ eq? 0= if 5 fail exit then 256 320 blk-merge
  else 1 80 an! 48 an@ 88 an! 256 320 blk-copy then 0 40 an! ;
-- ( -- )
-- A call to a family word that stays unresolved is the i64 version.
: do-call
  callee-token
  968 get 600 get eq? if family-step if exit then instance-step if exit then then
  dup family? over generic? or if 1 224 an! then
  dup family? swap call-effect if 1 ty-set then ;
-- ( -- )
: do-quote
  callee 0 1 apply dup effect-known? if 64 an! else drop 0 64 an! then ;
-- ( -- )
: do-execute
  64 an@ dup if 1 0 apply dup effect-in swap effect-out apply 0 64 an!
  else drop 1 fail then ;
-- ( id -- ) The type of a primitive's one result: integer arithmetic, logic
-- and comparisons (5-17), byte loads (18) and region sizes (24) give i64;
-- float arithmetic (36-39) and i>f (42) give f64; float comparisons (40, 41)
-- and f>i (43) give i64. Anything else stays unknown.
: prim-type
  dup 5 ult? 0= over 18 ult? and over 18 eq? or over 24 eq? or if drop 1 ty-set exit then
  dup 36 ult? 0= over 40 ult? and over 42 eq? or if drop 2 ty-set exit then
  dup 40 eq? over 41 eq? or swap 43 eq? or if 1 ty-set then ;
-- ( id -- ) Shuffles move types with their values: swap leaves b a, over
-- a b a, rot b c a. Fields 152, 160 and 168 hold the top three slots' types
-- from before the shuffle.
: shuffle-types
  dup 2 eq? if drop 160 an@ 0 ty! 152 an@ 1 ty! exit then
  dup 3 eq? if drop 160 an@ 0 ty! 152 an@ 1 ty! 160 an@ 2 ty! exit then
  4 eq? if 168 an@ 0 ty! 152 an@ 1 ty! 160 an@ 2 ty! then ;
-- `mark` and `gather`: the analysis keeps the depth at each open `mark`
-- (field 448 a count, 456-504 the marks), so `gather` knows how many cells
-- it takes, and the array's type from theirs and from those seen where paths
-- met at different depths. An element of unknown type makes the word
-- generic, so a call with known types gets an instance that knows it.
-- ( -- )
: do-mark
  448 an@ 7 ult? 0= if 10 fail exit then
  48 an@ 448 an@ 8 u* 456 u+ an! 448 an@ 1 u+ 448 an! 0 64 an! ;
-- ( -- )
: do-gather
  448 an@ 0= if 6 fail exit then
  448 an@ 1 u- dup 448 an! 8 u* 456 u+ an@
  dup 48 rshift 2047 and swap 281474976710655 and
  48 an@ over ult? if drop drop 6 fail exit then
  48 an@ over u- >r
  256 swap 48 an@ join-slots
  dup 512 and if 1 224 an! then
  summary-type r> 1 apply ty-set 0 64 an! ;
-- ( t -- t' ) The type of an element read from a value of type t. An
-- element of an array whose elements' types differ is lost (255): it may be
-- either, so a family call on it is an error rather than a guess.
: at-type
  dup 253 eq? if drop 1 exit then
  dup map-type? if map-value kind-type exit then
  dup array-type? 0= if drop 0 exit then
  dup 252 eq? if drop 255 exit then
  element-type ;
-- ( -- t ) The type of a map from the pairs above the mark at 152: the
-- kinds the keys, and the values, agree on.
: pair-type
  -1 168 an! -1 176 an!
  152 an@ cycle dup 48 an@ ult? while
    256 over slot-type key-kind 168 an@ kind-join 168 an!
    256 over 1 u+ slot-type value-kind 176 an@ kind-join 176 an!
    2 u+
  repeat drop
  168 an@ 176 an@ map-of ;
-- ( -- ) `}`: the cells above the mark are pairs of a key and a value. The
-- map's type takes the kinds they agree on, unknown if the count varies.
: do-map-gather
  448 an@ 0= if 6 fail exit then
  448 an@ 1 u- dup 448 an! 8 u* 456 u+ an@
  dup 63 rshift 160 an! 281474976710655 and 152 an!
  48 an@ 152 an@ ult? if 6 fail exit then
  48 an@ 152 an@ u-
  dup 0= if drop 246 else drop 160 an@ if 231 else pair-type then then
  48 an@ 152 an@ u- 1 apply ty-set 0 64 an! ;
-- ( ta tb -- t ) The type of two arrays or strings joined: theirs if they
-- agree, the other's if one is an empty array, otherwise unknown.
: concat-type
  over over eq? if drop exit then
  dup 254 eq? if drop exit then
  over 254 eq? if nip exit then
  drop drop 0 ;
-- ( id -- )
: do-prim
  73 over ult? if drop 11 fail exit then
  -- `text-of` takes the type of the value below it from the literal before
  -- it: resolving, the literal is set to the value's type when it is known;
  -- when it is not, the word is generic, so a call with a known type gets an
  -- instance that knows it.
  dup 68 eq? if drop
    1 ty@ dup 0= over 255 eq? or if drop 1 224 an! else
      968 get 600 get eq? retype-ok? and if 2 u+ 24 an@ 13 tab! else drop then
    then
    2 1 apply 253 ty-set 0 64 an! exit then
  dup 69 eq? if drop 1 0 apply 0 64 an! exit then
  dup 70 eq? over 71 eq? or if drop 2 1 apply 1 ty-set 0 64 an! exit then
  dup 72 eq? if drop 1 2 apply 1 0 ty! 1 1 ty! 0 64 an! exit then
  dup 73 eq? if drop 1 2 apply 1 0 ty! 2 1 ty! 0 64 an! exit then
  dup 62 ult? 0= if
    dup 65 ult? if drop 4 1 apply 1 ty-set 0 64 an! exit then
    dup 65 eq? if drop 3 1 apply 1 ty-set 0 64 an! exit then
    dup 66 eq? if drop 5 1 apply 1 ty-set 0 64 an! exit then
    drop 3 2 apply 1 0 ty! 1 1 ty! 0 64 an! exit
  then
  dup 56 eq? if drop do-map-gather exit then
  dup 57 eq? if drop
    2 ty@ dup map-type? if 1 ty@ 0 ty@ map-put-type else 0 ty@ push-type then
    >r 3 1 apply r> ty-set 0 64 an! exit then
  dup 58 eq? if drop 2 1 apply 1 ty-set 0 64 an! exit then
  dup 59 eq? if drop 1 ty@ >r 2 1 apply r> ty-set 0 64 an! exit then
  dup 60 eq? if drop 0 ty@ dup map-type? if map-key key-type array-of else drop 5 then
    >r 1 1 apply r> ty-set 0 64 an! exit then
  dup 61 eq? if drop 0 ty@ dup map-type? if map-value kind-type array-of else drop 5 then
    >r 1 1 apply r> ty-set 0 64 an! exit then
  dup 52 eq? if drop 3 1 apply 253 ty-set 0 64 an! exit then
  dup 53 eq? if drop 1 ty@ 0 ty@ concat-type >r 2 1 apply r> ty-set 0 64 an! exit then
  dup 54 eq? if drop 2 ty@ >r 3 1 apply r> ty-set 0 64 an! exit then
  dup 55 eq? if drop 2 1 apply 1 ty-set 0 64 an! exit then
  dup 48 eq? if drop 1 1 apply 1 ty-set 0 64 an! exit then
  dup 49 eq? if drop 1 ty@ at-type >r 2 1 apply r> ty-set 0 64 an! exit then
  dup 50 eq? if drop 1 ty@ 0 ty@ push-type >r 2 1 apply r> ty-set 0 64 an! exit then
  dup 51 eq? if drop 2 ty@ 0 ty@ push-type >r 3 1 apply r> ty-set 0 64 an! exit then
  dup 46 eq? if drop do-mark exit then
  dup 47 eq? if drop do-gather exit then
  dup 45 eq? if drop 2 0 apply 0 64 an! exit then
  dup 25 eq? if drop do-execute exit then
  dup 32 eq? if drop 1 0 apply 0 40 an! exit then
  dup 33 eq? if drop 0 ty@ sc! 1 0 apply 56 an@ 1 u+ 56 an! 0 64 an! exit then
  dup 34 eq? if drop 56 an@ 0= if 6 fail exit then
    sc@ >r 56 an@ 1 u- 56 an! 0 sc! 0 1 apply r> ty-set 0 64 an! exit then
  dup 35 eq? if drop 56 an@ 0= if 6 fail exit then
    sc@ >r 0 1 apply r> ty-set 0 64 an! exit then
  -- 36-41 take two and leave one (float arithmetic and comparison); 42-44
  -- take one and leave one (conversions, and the working-region load).
  dup 36 ult? 0= if dup 42 ult? if 2 1 else 1 1 then apply prim-type 0 64 an! exit then
  dup 5 ult? if
    0 ty@ 152 an! 1 ty@ 160 an! 2 ty@ 168 an!
    dup 0= if drop 1 2 apply 152 an@ 0 ty! 152 an@ 1 ty! exit then
    dup prim-in over prim-out apply 0 64 an! shuffle-types exit
  then
  dup prim-in over prim-out apply prim-type 0 64 an! ;
-- ( -- target )
: branch-target 32 an@ 1 u+ code-u32 ;
-- ( target -- )
: jump 24 an@ over ult? if pend else back then ;
-- ( -- )
: do-recur
  1 120 an! 104 an@ 1 eq? if 0 40 an! exit then
  112 an@ dup effect-in swap effect-out apply 0 64 an! ;

-- ( -- )
: step
  24 an@ 0 tab@ 32 an!
  32 an@ code@
  dup 0= if drop do-return exit then
  dup 1 eq? if drop 0 1 apply 1 ty-set 0 64 an! exit then
  dup 2 eq? if drop 32 an@ 1 u+ code@ do-prim exit then
  dup 3 eq? if drop do-call exit then
  dup 4 eq? if drop do-quote exit then
  dup 5 eq? if drop branch-target jump 0 40 an! exit then
  dup 6 eq? if drop 0 ty@ array-type? if 26 208 an! then
    1 0 apply 0 64 an! branch-target jump exit then
  dup 7 eq? if drop do-recur exit then
  dup 8 eq? if drop 0 3 apply 0 64 an! exit then
  dup 9 eq? if drop do-call 40 an@ if do-return then exit then
  dup 10 eq? if drop 0 1 apply 2 ty-set 0 64 an! exit then
  dup 11 eq? if drop do-recur 40 an@ if do-return then exit then
  drop 11 fail ;

-- ( pass -- )
: run-pass
  104 an!
  0 24 an!
  cycle 24 an@ 16 an@ ult? while
    0 24 an@ 1 tab! 0 24 an@ 5 tab! 0 24 an@ 12 tab! 0 24 an@ 13 tab!
    24 an@ 1 u+ 24 an!
  repeat
  0 24 an! 1 40 an! 4294967296 48 an! 0 56 an! 0 64 an! 4294967296 72 an!
  0 80 an! 0 88 an! 0 96 an! ty-seed 0 208 an! 0 448 an! 0 128 an!
  cycle 24 an@ 16 an@ ult? while
    arrive 40 an@ if step then
    24 an@ 1 u+ 24 an!
  repeat ;
-- ( -- packed )
: pass-result
  96 an@ if 96 an@ effect-unknown exit then
  80 an@ 0= if 7 effect-unknown exit then
  4294967296 72 an@ u- 88 an@ 72 an@ u- effect-pack ;

-- ( pos -- v ) A little-endian cell in the code being analysed.
: code-cell
  0 184 an! 8 176 an!
  cycle 176 an@ while
    176 an@ 1 u- 176 an!
    184 an@ 8 lshift over 176 an@ u+ code@ or 184 an!
  repeat drop 184 an@ ;
-- ( byte pos -- ) Write a byte of the code being analysed, which is the
-- definition being finished or the copy an instance is made from.
: code! 0 an@ swap c! ;
-- ( k -- ) Make the integer literal at op k a float literal of its value.
: retype-literal
  0 tab@ 192 an!
  192 an@ 1 u+ code-cell i>f 200 an!
  10 192 an@ code!
  0 176 an!
  cycle 176 an@ 8 ult? while
    200 an@ 176 an@ 8 u* rshift 192 an@ 1 u+ 176 an@ u+ code!
    176 an@ 1 u+ 176 an!
  repeat ;
-- ( value k -- ) Set the value of the integer literal at op k.
: set-literal
  0 tab@ 192 an! 200 an!
  0 176 an!
  cycle 176 an@ 8 ult? while
    200 an@ 176 an@ 8 u* rshift 192 an@ 1 u+ 176 an@ u+ code!
    176 an@ 1 u+ 176 an!
  repeat ;
-- ( -- ) Patch each resolved family call to its clause, and each literal
-- marked in table 13: 1 to become a float, or 2 plus a type for `text-of`.
: apply-resolutions
  0 24 an!
  cycle 24 an@ 16 an@ ult? while
    24 an@ 12 tab@ dup if 0 an@ 24 an@ 0 tab@ 1 u+ code-cid else drop then
    24 an@ 13 tab@ dup 1 eq? if drop 24 an@ 1 u- retype-literal else
      dup if 2 u- 24 an@ 1 u- set-literal else drop then then
    24 an@ 1 u+ 24 an!
  repeat ;

-- ( pass -- ) Run a pass until no loop header's types are widened.
: run-pass* cycle 0 136 an! dup run-pass 136 an@ while repeat drop ;
-- ( region length -- packed ) The effect of canonical code bytes. A word
-- that recurs is analysed twice: once treating `recur` as a dead end, which
-- gives its base case, then again assuming that effect for `recur`, which
-- must reproduce it.
: analyze
  600 get >r
  analysis-begin 1 run-pass* pass-result
  120 an@ if dup effect-known? if
    dup 112 an! 2 run-pass* pass-result
    dup effect-known? if
      over over eq? if drop else drop drop 8 effect-unknown then
    else swap drop then
  then then
  dup effect-known? 224 an@ and if 1099511627776 or then
  ret-types 720 put
  208 an@ 1008 put
  968 get 600 get eq? if 1008 get 0= if apply-resolutions then 0 968 put then
  600 get region-free r> 600 put ;

-- ( token -- packed ) A word's effect, computed from its code on first use
-- and remembered in the table at working offset 624.
-- Output types go to the table at 712, the same way.
: effect-of
  dup 131072 ult? 0= if drop 10 effect-unknown exit then
  dup 8 u* 624 get swap @ dup if swap drop exit then drop
  dup >r 1 680 code-cid 1 680 blob-read swap drop analyze
  720 get 712 get r@ 8 u* !
  dup 624 get r> 8 u* ! ;

-- ( token -- inputs outputs 1 | reason 0 0 )
: stack-effect
  effect-of dup effect-known? if dup effect-in swap effect-out 1
  else effect-in 0 0 then ;
-- ( token -- types outputs 1 | reason 0 0 ) The types of a word's outputs, a
-- byte each, the top first: 0 unknown, 1 i64, 2 f64.
: stack-types
  dup effect-of dup effect-known? if
    effect-out swap 8 u* 712 get swap @ over ty-mask and swap 1
  else nip effect-in 0 0 then ;
-- In checked mode, `;` rejects a definition whose effect is unknown, trapping
-- with 100 plus the reason.
: checked 1 632 put ;
: unchecked 0 632 put ;

-- ( name-region name-offset length -- ) The name is copied at once, so a
-- definition may continue in later input after its source buffer is gone.
: begin 0 get if 5 trap then
  dup 256 ult? 0= if 7 trap then
  dup 88 put 1 swap 3840 swap copy
  1 96 put 3840 80 put
  65536 region-new 24 put 0 16 put 1 0 put ;
-- ( -- ) Resolve the family calls in the definition being finished; trap 23
-- if a call's known input types match no clause, 26 if an array is used as a
-- condition. 1016 says whether the
-- definition is generic, so `;` can flag it (dictionary flag bit 4).
: resolve-families
  0 960 put 0 1008 put 1 968 put
  out here analyze 40 rshift 1 and 1016 put 0 968 put
  1008 get dup if trap then drop ;

-- Instances, remembered by word and input types in the region whose handle
-- is at 3512: a count, then entries of three cells (word, types, instance).
-- The same table remembers output types for top-level runs, keyed by the
-- word with bit 62 set. Working memory 3536-3568 holds temporaries.
-- ( key types -- value | 0 )
: find-instance
  3544 put 3536 put 0 3552 put
  cycle 3552 get 3512 get 0 @ ult? while
    3512 get 3552 get 24 u* 8 u+ @ 3536 get eq?
    3512 get 3552 get 24 u* 16 u+ @ 3544 get eq? and if
      3512 get 3552 get 24 u* 24 u+ @ exit
    then
    3552 get 1 u+ 3552 put
  repeat 0 ;
-- ( key types value -- ) Remember an entry, unless the table is full; the
-- table only saves work, since an instance is the same code each time.
: add-instance
  3512 get 0 @ dup 4096 ult? 0= if drop drop drop drop exit then
  24 u* 8 u+ >r
  3512 get r@ 16 u+ ! 3512 get r@ 8 u+ ! 3512 get r> !
  3512 get 0 @ 1 u+ 3512 get 0 ! ;
-- ( token types -- instance ) A generic word compiled again for inputs of
-- the given types: its code is copied, resolved starting from those types,
-- and sealed. A known type that matches no clause in the copy is an error
-- of the call (trap 23 at the caller's `;`, or at once at top level). The
-- instance's effect and output types are those found from the input types,
-- and remembered: its code alone does not say, for example, what the
-- elements of an array built from its inputs are.
: instantiate
  over over find-instance dup if nip nip exit then drop
  over 1 680 code-cid 1 680 blob-read swap drop
  dup region-new 3560 put 3568 put 0 3560 get 0 3568 get copy
  3560 get 3568 get
  >r >r dup 3520 put r> r>
  968 get >r 1008 get >r 1 968 put 0 1008 put
  over over analyze 720 get
  1008 get r> 1008 put r> 968 put
  dup if 600 get if 208 an! else trap then else drop then
  >r >r over >r >r 0 r> seal r> region-free
  r> over 8 u* 624 get swap ! r> over 8 u* 712 get swap !
  dup >r add-instance r> ;
-- ( xt types -- outtypes ) The output types of a word run on inputs of the
-- given types: an analysis of its code starting from them, remembered.
: typed-outputs
  over 4611686018427387904 or over find-instance dup if nip nip 9223372036854775807 and exit then drop
  over 1 680 code-cid 1 680 blob-read swap drop
  >r >r dup 3520 put r> r>
  analyze drop 720 get
  dup >r -9223372036854775808 or >r 4611686018427387904 rot or swap r> add-instance r> ;

-- Top level: the interpreter keeps the types of the values it pushes, a byte
-- each, in a stack of its own (a region whose handle is at 3576; its top is at
-- 784), so a family word or a generic word run there gets the clause or
-- instance its inputs' types call for. Values below it have unknown types.
-- 3528 says the top value is an integer literal just read, which a float
-- clause may convert.
-- ( t -- )
: shadow-push 784 get 65536 ult? if 3576 get 784 get c! 784 get 1 u+ 784 put else drop then ;
-- ( n -- )
: shadow-pop 784 get over ult? if drop 0 else 784 get swap u- then 784 put ;
-- ( i -- t ) The type of the i-th value from the top.
: shadow@ dup 784 get ult? if 784 get swap u- 1 u- 3576 get swap c@ else drop 0 then ;
-- ( n -- packed ) The top n types (at most eight), the top first.
: shadow-top
  dup 8 ult? 0= if drop 8 then 0 swap
  cycle dup while 1 u- dup shadow@ rot 8 lshift or swap repeat drop ;
-- ( kind -- )
: shadow-literal dup 1 eq? 3528 put shadow-push ;
-- ( in out outtypes -- ) Pop in values' types, push out with these types;
-- past the eighth they are lost.
: shadow-apply
  >r swap shadow-pop
  cycle dup while
    1 u- dup 8 ult? if r@ over 8 u* rshift 255 and else 255 then shadow-push
  repeat drop r> drop ;
-- ( n -- t ) The type of an array of the top n values, as `do-gather`.
: shadow-elem
  0 swap cycle dup while 1 u- dup shadow@ >r swap r> ty-join swap repeat
  drop summary-type ;
-- `(` and `)` at top level also keep the type stack's top at each `(`
-- (3328 a count, 3336-3384 the tops), so `)` can type the array. Bit 32 of
-- a top marks a literal whose count varies (`shadow-unknown`): its `)` types
-- an array of unknown elements, its `}` a map of unknown kinds.
: shadow-open
  3328 get 7 ult? if 784 get 3328 get 8 u* 3336 u+ put 3328 get 1 u+ 3328 put then
  0 3528 put ;
: shadow-close
  0 3528 put
  3328 get 0= if 0 784 put 5 shadow-push exit then
  3328 get 1 u- dup 3328 put 8 u* 3336 u+ get
  dup 32 rshift if 4294967295 and 784 put 5 shadow-push exit then
  784 get over ult? if drop 0 784 put 5 shadow-push exit then
  784 get over u- shadow-elem swap 784 put shadow-push ;
-- ( mark -- t ) The type of a map of the pairs from a mark to the top.
: shadow-pair-type
  >r -1 -1
  cycle r@ 784 get ult? while
    swap 3576 get r@ c@ key-kind swap kind-join
    swap 3576 get r@ 1 u+ c@ value-kind swap kind-join
    r> 2 u+ >r
  repeat r> drop map-of ;
-- `}` at top level, as `)`, for a map.
: shadow-close-map
  0 3528 put
  3328 get 0= if 0 784 put 231 shadow-push exit then
  3328 get 1 u- dup 3328 put 8 u* 3336 u+ get
  dup 32 rshift if 4294967295 and 784 put 231 shadow-push exit then
  784 get over ult? if drop 0 784 put 231 shadow-push exit then
  dup 784 get eq? if 784 put 246 shadow-push exit then
  dup shadow-pair-type swap 784 put shadow-push ;
-- ( xt -- xt' ) A family word's clause for the values on the stack, or the
-- lifted word when one of them is an array.
: shadow-clause
  dup 8 shadow-top find-clause dup if nip exit then drop
  3528 get 0 shadow@ 1 eq? and if
    dup 8 shadow-top -256 and 2 or find-clause dup if
      nip >r i>f r> 1 shadow-pop 2 shadow-push exit
    then drop
  then
  dup 1 shadow@ 0 shadow@ 3392 get call dup if >r nip r> 792 put exit then drop
  3528 get 0 shadow@ 1 eq? and 1 shadow@ dup array-type? swap base-type 2 eq? and and if
    >r i>f r> 1 shadow-pop 2 shadow-push
    dup 1 shadow@ 2 3392 get call dup if >r nip r> 792 put exit then drop
  then
  dup 8 shadow-top types-mismatch? if 23 trap then ;
-- ( -- ) After a word whose effect is not known, such as a loop that pushes
-- a varying count, nothing is known of the stack's types; inside an open
-- literal, only of those above its mark, which the word is taken to keep,
-- and the literal's count varies.
: shadow-unknown
  3328 get 0= if 0 784 put exit then
  3328 get 1 u- 8 u* 3336 u+ dup get 4294967295 and
  dup 784 get ult? if dup 784 put then drop
  dup get 4294967296 or swap put ;
-- ( xt -- ) The types of the stack after running xt.
: shadow-effect
  dup callee-effect dup effect-known? 0= if drop drop shadow-unknown exit then
  dup effect-in shadow-top
  dup if rot swap typed-outputs else drop swap 8 u* 712 get swap @ then
  over effect-out ty-mask and
  swap dup effect-in swap effect-out rot shadow-apply ;
-- ( xt flags -- ) Run a word at top level. Its dictionary flags say whether
-- it is a family word (bit 3) or a generic one (bit 4).
: run-typed
  0 792 put
  dup 8 and if drop shadow-clause else
    16 and if
      dup callee-effect effect-in shadow-top
      dup wants-instance? if instantiate else drop then
    then
  then
  dup shadow-effect 0 3528 put
  792 get dup if 1 shadow-pop shadow-push else drop then
  call ;
: semicolon 0 get 0= if 6 trap then 800 get if 20 trap then
  tailify 0 c,
  0 1016 put 960 get if resolve-families then
  632 get if out here analyze 1008 get dup if trap then drop
    dup effect-known? 0= if effect-in 100 u+ trap then
  else 0 then
  out 0 here seal
  dup >r 0 96 get 80 get 88 get install
  1016 get if 8 get 16 u+ dup get 16 or swap put then
  dup if r@ 8 u* 624 get swap ! 720 get 712 get r@ 8 u* ! else drop then
  out region-free 0 24 put 0 0 put ;

: >xt 8 u+ get ;
: emit-recur 7 c, ;
-- Skip to the end of the line, past its newline.
: line-comment 40 get 56 get 48 get 10 byte-find
  dup 48 get ult? if 1 u+ then 56 put ;

-- ( -- region 0 length ) or, compiling, emit a data operand.
-- Reads to the next double quote.
: s"
  inc-pos 56 get 344 put
  40 get 56 get 48 get 34 byte-find 56 put
  56 get 48 get ult? 0= if 8 trap then
  40 get 344 get 56 get 344 get u- publish
  inc-pos
  0 get if 8 c, out here blob-cid here 32 u+ 16 put else 0 over region-size then ; immediate


-- Symbols: in source, `\times` is the word `×` (docs/SURFACE.md), so code
-- compiles the same whether or not `march7 fmt` has rewritten it. One entry
-- per line: the name after the backslash, a space, the symbol. A symbol is
-- never longer in bytes than its escape, so a word only shrinks. The
-- formatter reads this same table.
: symbol-table s"
times ×
div ÷
cdot ⋅
pm ±
mp ∓
sqrt √
cbrt ∛
sum ∑
prod ∏
infty ∞
partial ∂

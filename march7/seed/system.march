pi π
rho ρ
sigma σ
tau τ
upsilon υ
phi ϕ
varphi φ
chi χ
psi ψ
omega ω
Gamma Γ
Delta Δ
Theta Θ
Lambda Λ
Xi Ξ
Pi Π
Sigma Σ
Upsilon Υ
Phi Φ
Psi Ψ
Omega Ω
_0 ₀
_1 ₁
_2 ₂
_3 ₃
_4 ₄
_5 ₅
_6 ₆
_7 ₇
_8 ₈
_9 ₉
_+ ₊
_- ₋
_= ₌
_a ₐ
_e ₑ
_o ₒ
_x ₓ
_h ₕ
_k ₖ
_l ₗ
_m ₘ
_n ₙ
_p ₚ
_s ₛ
_t ₜ
_i ᵢ
_j ⱼ
_r ᵣ
_u ᵤ
_v ᵥ
^0 ⁰
^1 ¹
^2 ²
^3 ³
^4 ⁴
^5 ⁵
^6 ⁶
^7 ⁷
^8 ⁸
^9 ⁹
^+ ⁺
^- ⁻
^= ⁼
^n ⁿ
^i ⁱ
" ;

-- Working memory: 448 word region, 456 offset, 464 length, 472 read index,
-- 480 write index, 488 name start, 496 name length, 504 table region, 536
-- table length, 544 table position, 552 entry name, 560 its length, 568
-- compare index, 576 entry symbol, 584 its length. Rewritten words go to the
-- buffer at 3584 (256 bytes).
-- ( n -- byte ) A byte of the word being rewritten.
: sym-at 448 get 456 get rot u+ c@ ;
: ascii-letter? dup 65 ult? 0= over 91 ult? and swap dup 97 ult? 0= swap 123 ult? and or ;
-- The length of the escape name at 488, into 496: `_` or `^` with the byte
-- after it, or a run of ASCII letters; zero if neither.
: sym-name 0 496 put
  488 get 464 get ult? 0= if exit then
  488 get sym-at dup 95 eq? swap 94 eq? or if
    488 get 1 u+ 464 get ult? if 2 496 put then exit
  then
  cycle 488 get 496 get u+ dup 464 get ult? if sym-at ascii-letter? else drop 0 then
  while 496 get 1 u+ 496 put repeat ;
-- ( -- flag ) Whether the table entry at 552 names the escape at 488.
: sym-same? 560 get 496 get eq? 0= if 0 exit then
  0 568 put
  cycle 568 get 496 get ult? if
    504 get 552 get 568 get u+ c@  488 get 568 get u+ sym-at eq?
  else 0 then
  while 568 get 1 u+ 568 put repeat
  568 get 496 get eq? ;
-- ( -- flag ) Find the escape's entry; its symbol is then at 576, 584 long.
: sym-lookup symbol-table 536 put drop 504 put 0 544 put
  cycle 544 get 536 get ult? while
    544 get 552 put
    cycle 544 get 536 get ult? if 504 get 544 get c@ 32 eq? 0= else 0 then
    while 544 get 1 u+ 544 put repeat
    544 get 552 get u- 560 put
    544 get 1 u+ dup 576 put 544 put
    cycle 544 get 536 get ult? if 504 get 544 get c@ 10 eq? 0= else 0 then
    while 544 get 1 u+ 544 put repeat
    544 get 576 get u- 584 put
    544 get 1 u+ 544 put
    sym-same? if 1 exit then
  repeat 0 ;
-- ( region offset length -- region offset length ) A word with its `\name`
-- escapes rewritten as symbols, in the buffer at 3584. A word too long for
-- the buffer comes back unchanged; an unknown name is left as written.
: symbolize dup 256 ult? 0= if exit then
  >r over over dup r@ u+ 92 byte-find over r@ u+ eq? if r> exit then r>
  464 put 456 put 448 put 0 472 put 0 480 put
  cycle 472 get 464 get ult? while
    472 get sym-at 92 eq? if
      472 get 1 u+ 488 put sym-name 496 get if sym-lookup else 0 then
    else 0 then
    if
      504 get 576 get 1 3584 480 get u+ 584 get copy
      480 get 584 get u+ 480 put
      472 get 1 u+ 496 get u+ 472 put
    else
      472 get sym-at 1 3584 480 get u+ c!
      480 get 1 u+ 480 put  472 get 1 u+ 472 put
    then
  repeat
  1 3584 480 get ;
-- ( region offset length -- entry | 0 ) find, and failing that, find again
-- with the word's escapes rewritten.
: lookup find dup if exit then drop
  240 get 248 get 256 get symbolize find ;
: colon word symbolize begin ;
: quote-word word lookup dup 0= if 1 trap then >xt 0 get if compile-quote then ;

-- Quotations: `[ ... ]` compiles its body into a buffer of its own and leaves
-- it pending, anchored where it appeared. A consumer (`if`, `while`, `times`)
-- inlines pending bodies into the definition; anything else first seals each
-- pending body as an anonymous word and emits a quotation of it in place.
-- Working memory: 800 nesting depth; 808 pending count; pending entries at
-- 1024 + 24i (region, length, depth); saved outer builders at 2560 + 24d
-- (region, offset, STATE); 3400-3432 temporaries for inlining.
-- Traps: 15 exit or recur inside a quotation sealed as its own word, 16
-- nesting too deep, 17 `]` without `[`, 18 too many pending quotations, 19
-- wrong quotations for a consumer, 20 `;` inside an open quotation.
: q-entry 24 u* 1024 u+ ;
-- `exit` and `recur` mean the definition they are written in, so inside a
-- quotation they are allowed only if a consumer inlines it. 872 holds a bit
-- for each open quotation level that contains one; at `]` it moves to a flag
-- byte for the pending entry, at 880 + i. Sealing a flagged quotation traps
-- (15); inlining one into an enclosing quotation marks that one in turn.
: mark-flow 1 800 get lshift 872 get or 872 put ;
-- ( i -- flag )
: entry-flow 880 u+ 1 swap c@ ;
-- ( -- k ) Index of the first pending entry at the current depth.
: pending-start
  808 get cycle dup if dup 1 u- q-entry 16 u+ get 800 get eq? else 0 then
  while 1 u- repeat ;
-- ( -- n ) Pending quotations at the current depth.
: pending-here 808 get pending-start u- ;
-- ( region length -- token ) Append a return, seal, free the buffer.
: seal-quote
  over over >r >r 0 r> r> c!
  1 u+ over >r 0 swap seal r> region-free ;
-- ( -- ) Emit every pending quotation at this depth as a first-class
-- quotation, oldest first, where it appeared.
: materialize
  pending-start dup >r
  cycle dup 808 get ult? while
    dup entry-flow if 15 trap then
    dup q-entry dup get swap 8 u+ get seal-quote compile-quote
    1 u+
  repeat drop r> 808 put ;
-- ( -- ) At top level, push every pending quotation, oldest first, as a
-- value: a quotation stays pending until a token other than a consumer
-- comes, or the input ends.
: top-materialize
  808 get 0= if exit then
  pending-start dup >r
  cycle dup 808 get ult? while
    dup entry-flow if 15 trap then
    dup >r q-entry dup get swap 8 u+ get seal-quote 0 shadow-push r> 1 u+
  repeat drop r> 808 put ;
-- ( region pos -- n ) A little-endian 32-bit operand.
: region-u32
  over over c@ >r over over 1 u+ c@ 8 lshift r> or >r
  over over 2 u+ c@ 16 lshift r> or >r 3 u+ c@ 24 lshift r> or ;
-- ( i -- ) Copy pending body i into the definition, shifting its branch
-- targets by the instruction index where it lands. Free its buffer.
: inline-quote
  dup entry-flow 800 get 0= 0= and if mark-flow then
  q-entry dup get 3400 put 8 u+ get 3408 put ops 3416 put 0 3424 put
  cycle 3424 get 3408 get ult? while
    3400 get 3424 get c@ dup oplen 3432 put
    dup 5 eq? over 6 eq? or if
      c, 3400 get 3424 get 1 u+ region-u32 3416 get u+ u32,
    else
      dup 3 eq? swap 7 eq? or if mark-call then
      3400 get 3424 get out here 3432 get copy here 3432 get u+ 16 put
    then
    3424 get 3432 get u+ 3424 put
  repeat 3400 get region-free ;
-- ( -- ) Drop the newest n pending entries (already inlined).
: consumed 808 get swap u- 808 put ;

: quote-open
  800 get 32 ult? 0= if 16 trap then
  800 get 24 u* 2560 u+ out over put here over 8 u+ put 0 get swap 16 u+ put
  65536 region-new 24 put 0 16 put 1 0 put
  800 get 1 u+ 800 put ;
: quote-close
  800 get 0= if 17 trap then
  872 get 800 get rshift 1 and >r
  1 800 get lshift invert 872 get and 872 put
  800 get 1 u- dup 800 put 24 u* 2560 u+ out here rot
  dup get 24 put dup 8 u+ get 16 put 16 u+ get 0 put
  808 get 64 ult? 0= if 18 trap then
  808 get q-entry swap over 8 u+ put swap over put 800 get swap 16 u+ put
  r> 1 880 808 get u+ c!
  808 get 1 u+ 808 put ;

-- ( xt -- ) At top level a consumer compiles its code into a temporary,
-- anonymous word and runs it at once. It is resolved and checked as an
-- instance for the types of the values it takes, so
-- `( 1.5 2.5 ) [ 1 + ] map` adds floats there too, and `( 1 2 ) [ 3 ] if`
-- is an error. `run-at-top` does this for any compiling word.
: run-at-top
  65536 region-new 24 put 0 16 put 1 0 put
  call 0 c, 0 0 put
  out 0 here seal out region-free 0 24 put 0 16 put
  dup callee-effect effect-in shadow-top instantiate 0 960 put
  0 run-typed ;
: at-top pending-here 0= if 19 trap then run-at-top ;
-- ( -- ) Quotation-aware `if`: `c [ t ] [ f ] if`, `c [ t ] if`, or, with
-- nothing pending, FORTH's `if ... else ... then`.
: emit-if
  pending-here
  dup 0= if drop 6 c, here 0 u32, exit then
  dup 1 eq? if drop
    6 c, here 0 u32, 808 get 1 u- inline-quote 1 consumed ops swap u32! exit then
  2 eq? 0= if 19 trap then
  6 c, here 0 u32, 808 get 2 u- inline-quote
  5 c, here 0 u32, swap ops swap u32!
  808 get 1 u- inline-quote ops swap u32! 2 consumed ;
-- ( -- ) `[ c ] [ body ] while`, or FORTH's `cycle ... while ... repeat`.
: emit-while
  pending-here
  dup 0= if drop 6 c, here 0 u32, exit then
  2 eq? 0= if 19 trap then
  ops 808 get 2 u- inline-quote
  6 c, here 0 u32, 808 get 1 u- inline-quote
  swap 5 c, u32, ops swap u32! 2 consumed ;
-- Counted loops keep three cells on the scratch stack, the index on top, so
-- `i0` and `i1` find the index of the loop and of the one enclosing it:
-- `times` keeps 0, the count and the index; `each` the array, its length and
-- the index; `map` the array being built, the array and the index.
-- ( -- ) Whether the index is below the cell under it.
: loop-test 34 prim, 35 prim, 3 prim, 33 prim, 11 prim, ;
-- ( -- ) The index's increment.
: loop-step 34 prim, 1 literal 5 prim, 33 prim, ;
-- ( -- ) Drop the loop's cells.
: loop-end 34 prim, 1 prim, 34 prim, 1 prim, 34 prim, 1 prim, ;
-- ( -- ) The newest pending quotation, as the loop's body.
: loop-body 808 get 1 u- inline-quote 1 consumed ;
-- ( -- ) `n [ body ] times` runs body n times, with the index 0..n-1 as
-- `i0` (and the enclosing loop's as `i1`).
: emit-times
  pending-here 1 eq? 0= if 19 trap then
  0 literal 33 prim, 33 prim, 0 literal 33 prim,
  ops loop-test 6 c, here 0 u32, loop-body
  loop-step swap 5 c, u32, ops swap u32! loop-end ;
-- ( a -- ) `a [ body ] each` runs body once for each element of a, in order,
-- with the element on top of the stack and its index as `i0`.
: emit-each
  pending-here 1 eq? 0= if 19 trap then
  0 prim, 33 prim, 48 prim, 33 prim, 0 literal 33 prim,
  ops loop-test 6 c, here 0 u32,
  34 prim, 34 prim, 35 prim, 4 prim, 4 prim, 33 prim, 0 prim, 33 prim, 49 prim,
  loop-body loop-step swap 5 c, u32, ops swap u32! loop-end ;
-- ( a x -- y ) `a x [ body ] fold` runs body on an accumulator, x at first,
-- and each element, leaving the last accumulator: `xs 0 [ + ] fold` sums.
: emit-fold
  pending-here 1 eq? 0= if 19 trap then
  2 prim, emit-each ;
-- ( a -- b ) `a [ body ] map` is the array of body's results: body takes
-- each element and leaves one value in its place.
: emit-map
  pending-here 1 eq? 0= if 19 trap then
  46 prim, 47 prim, 33 prim, 33 prim, 0 literal 33 prim,
  ops 34 prim, 35 prim, 3 prim, 33 prim, 48 prim, 11 prim, 6 c, here 0 u32,
  34 prim, 35 prim, 3 prim, 33 prim, 2 prim, 49 prim,
  loop-body
  34 prim, 34 prim, 4 prim, 34 prim, 2 prim, 50 prim, 33 prim, 33 prim,
  1 literal 5 prim, 33 prim,
  swap 5 c, u32, ops swap u32!
  34 prim, 1 prim, 34 prim, 1 prim, 34 prim, ;
-- The consumers: compiled in place in a definition, through a temporary
-- word at top level.
: qif 0 get if emit-if else ' emit-if at-top then ;
: qwhile 0 get if emit-while else ' emit-while at-top then ;
: times 0 get if emit-times else ' emit-times at-top then ;
: each 0 get if emit-each else ' emit-each at-top then ;
: fold 0 get if emit-fold else ' emit-fold at-top then ;
: map 0 get if emit-map else ' emit-map at-top then ;
: i0 compile-only 35 prim, ;
: i1 compile-only
  34 prim, 34 prim, 34 prim, 35 prim,
  2 prim, 33 prim, 2 prim, 33 prim, 2 prim, 33 prim, ;
: qexit 800 get if mark-flow then tailify 0 c, ;
: qrecur 800 get if mark-flow then mark-call 7 c, ;

-- Strings, second slice (docs/STRINGS.md): escapes and holes in literals.
-- `text-of` ( x t -- s ) marks its definition for resolving, which sets its
-- type literal (primitive 68).
: text-of 68 prim, 1 960 put ; immediate
-- ( x -- s ) A value as text: a string as itself, anything else as March
-- writes it, by the type the checker gives it.
: >string 0 text-of ;

-- A literal's state is in a region of its own, so literals nest (a hole may
-- hold another literal); its handle is at 752. Fields: 0 the text buffer,
-- 8 its length, 16 the part count, 24 the code holes, then parts of 16 bytes
-- from 32: kind (0 text, 1 code hole, 2 a bare `\_`) and the text's blob or
-- the hole's pending entry; 1056 the open hole's depth. The buffer has twice
-- the input left, since an escape may write more bytes than it takes. 744 counts the inputs the literal takes with `_`
-- and `\_`, and is -1 outside any literal, where `_` traps 29. A bad escape
-- traps 27. Working memory 760-776 holds temporaries.
-- ( field -- v ) ( v field -- )
: lit@ 752 get swap @ ;
: lit! 752 get swap ! ;
-- ( b -- ) ( r o n -- ) Append a byte, or bytes, to the text.
: lit-byte 0 lit@ 8 lit@ c! 8 lit@ 1 u+ 8 lit! ;
: lit-bytes >r 0 lit@ 8 lit@ r@ copy 8 lit@ r> u+ 8 lit! ;
-- ( kind value -- ) Add a part.
: lit-part
  16 lit@ dup 64 ult? 0= if 27 trap then
  16 u* 32 u+ >r r@ 8 u+ lit! r> lit!
  16 lit@ 1 u+ 16 lit! ;
-- ( -- ) The text so far as a part, if there is any.
: lit-flush
  8 lit@ if 0 lit@ 0 8 lit@ publish 0 swap lit-part 0 8 lit! then ;
-- ( cp -- ) Append a code point as UTF-8.
: lit-utf8
  dup 1114111 swap ult? if 27 trap then
  dup 55296 ult? 0= over 57344 ult? and if 27 trap then
  dup 128 ult? if lit-byte exit then
  dup 2048 ult? if dup 6 rshift 192 or lit-byte 63 and 128 or lit-byte exit then
  dup 65536 ult? if
    dup 12 rshift 224 or lit-byte dup 6 rshift 63 and 128 or lit-byte
    63 and 128 or lit-byte exit
  then
  dup 18 rshift 240 or lit-byte dup 12 rshift 63 and 128 or lit-byte
  dup 6 rshift 63 and 128 or lit-byte 63 and 128 or lit-byte ;
-- ( c -- v )
: hex-digit
  dup 48 u- 10 ult? if 48 u- exit then
  dup 97 u- 6 ult? if 87 u- exit then
  dup 65 u- 6 ult? if 55 u- exit then
  27 trap ;
-- ( semi -- semi v ) Hex digits up to the `;`.
: lit-hex
  dup 760 put 0
  56 get 760 get eq? if 27 trap then
  cycle 56 get 760 get ult? while
    16 u* input-char hex-digit u+ inc-pos
    dup 1114111 swap ult? if 27 trap then
  repeat ;
-- ( semi len -- semi ) `\#digits;` or `\#xhex;`: a code point.
: lit-number
  drop inc-pos
  input-char 120 eq? if inc-pos lit-hex else
    dup 56 get u- >r 40 get 56 get r> decimal 1 eq? 0= if 27 trap then
  then
  lit-utf8 ;
-- ( semi len -- semi ) `\name;`: a control character (`n`, `t`, `r`), or a
-- symbol from the table `\name` uses in source.
: lit-name
  dup 1 eq? if
    input-char dup 110 eq? if drop drop 10 lit-byte exit then
    dup 116 eq? if drop drop 9 lit-byte exit then
    114 eq? if drop 13 lit-byte exit then
  then
  40 get 448 put 0 456 put 56 get 488 put 496 put
  sym-lookup 0= if 27 trap then
  504 get 576 get 584 get lit-bytes ;
-- ( -- flag ) `\_x;` where `_x` names a symbol, such as `\_1;`, is that
-- symbol, as `\_1` is in code; any other `\_` is an input. 56 is at the `_`.
: lit-subscript?
  56 get 2 u+ 48 get ult? 0= if 0 exit then
  40 get 56 get 2 u+ c@ 59 eq? 0= if 0 exit then
  40 get 448 put 0 456 put 56 get 488 put 2 496 put
  sym-lookup 0= if 0 exit then
  504 get 576 get 584 get lit-bytes
  56 get 3 u+ 56 put 1 ;
-- ( -- ) A code hole `\[ … ]`, compiled as a quotation and left pending.
-- At the hole's own depth a `]` ends it wherever a word would start, so the
-- text resumes right after it: `"\[ n ] apples"`. The hole's depth is at
-- field 1056, where `_` checks it. The interpreter's step is reached through
-- 104, since it reads literals in turn.
: lit-hole
  quote-open 800 get 1056 lit!
  cycle
    40 get 56 get 48 get 32 byte-past dup 56 put
    dup 48 get ult? 0= if 8 trap then
    40 get swap c@ 93 eq? 800 get 1056 lit@ eq? and 0=
  while read-word drop 104 get call repeat
  inc-pos materialize quote-close 0 1056 lit!
  808 get 1 u- dup q-entry 8 u+ get 0= if 27 trap then
  1 swap lit-part
  24 lit@ 1 u+ 24 lit! ;
-- ( -- ) An escape: 56 is at the byte after the backslash.
: lit-escape
  input-char
  dup 92 eq? over 34 eq? or if lit-byte inc-pos exit then
  dup 95 eq? if drop
    lit-subscript? if exit then
    inc-pos lit-flush 2 0 lit-part 744 get 1 u+ 744 put exit
  then
  dup 91 eq? if drop inc-pos lit-flush lit-hole exit then
  drop 40 get 56 get 48 get 59 byte-find
  dup 48 get ult? 0= if 27 trap then
  dup 56 get u- dup 0= over 64 ult? 0= or if 27 trap then
  input-char 35 eq? if lit-number else lit-name then
  1 u+ 56 put ;
-- ( -- ) Compiling: take the inputs onto the scratch stack, the first one on
-- top, then build the string from its parts in order: text as data made a
-- string, a code hole inlined, a bare input taken, each hole's value made
-- text by `>string`, joined with `concat`.
: lit-emit
  744 get cycle dup while 33 prim, 1 u- repeat drop
  0 cycle dup 16 lit@ ult? while
    dup 16 u* 32 u+ dup lit@ swap 8 u+ lit@
    over 0= if nip 8 c, out here blob-cid here 32 u+ 16 put 52 prim, else
      over 2 eq? if drop drop 34 prim, ' >string compile, else
        nip inline-quote ' >string compile, then then
    dup if 53 prim, then
    1 u+
  repeat drop
  24 lit@ consumed
  744 get 24 lit@ or if 1 960 put then ;
-- ( -- s ) A string literal (docs/STRINGS.md): a token that starts with a
-- double quote, read to the closing one: text, escapes (`\\`, `\"`, `\name;`,
-- `\#n;`), and holes (`\[ code ]`, `\_`). Compiling, it becomes code that
-- builds the string; at top level, a literal without holes is made at once.
: string-literal
  744 get >r 752 get >r
  1064 region-new 752 put
  48 get 64 get u- 2 u* region-new 0 lit! 0 8 lit! 0 16 lit! 0 24 lit!
  0 1056 lit!
  0 744 put
  64 get 1 u+ 56 put
  cycle
    40 get 56 get 48 get 92 byte-find 776 put
    40 get 56 get 776 get 34 byte-find 768 put
    40 get 56 get 768 get 56 get u- lit-bytes
    768 get 776 get ult? if 768 get 1 u+ 56 put 0 else
      776 get 1 u+ 48 get ult? 0= if 8 trap then
      776 get 1 u+ 56 put lit-escape 1
    then
  while repeat
  8 lit@ 16 lit@ 0= or if 0 lit@ 0 8 lit@ publish 0 swap lit-part then
  0 lit@ region-free
  0 get if lit-emit else 40 lit@ 0 over region-size make-text 253 shadow-push then
  752 get region-free
  r> 752 put r> 744 put ;
-- ( -- flag ) Whether the literal at the current word has a hole, which at
-- top level needs a word to run in.
: lit-holes?
  64 get 1 u+
  cycle
    40 get over 48 get 92 byte-find 776 put
    40 get over 776 get 34 byte-find 768 put
    768 get 776 get ult? 776 get 1 u+ 48 get ult? 0= or if drop 0 exit then
    drop 40 get 776 get 1 u+ c@ dup 91 eq? swap 95 eq? or if 1 exit then
    776 get 2 u+
  again ;
-- ( -- s ) At top level, a literal with holes compiles into a temporary
-- word, resolved and checked for the types of the values it takes, and runs
-- at once, as the consumers do.
: literal-at-top ' string-literal run-at-top ;
-- ( -- s ) A raw string literal: a token that starts with `'` and is longer
-- than `'` alone, read to the next `'`, with no escapes.
: raw-literal
  64 get 1 u+ dup 56 put 344 put
  40 get 56 get 48 get 39 byte-find 56 put
  56 get 48 get ult? 0= if 8 trap then
  40 get 344 get 56 get 344 get u- publish
  inc-pos
  0 get if 8 c, out here blob-cid here 32 u+ 16 put 52 prim,
  else 0 over region-size make-text 253 shadow-push then ;
-- ( -- ) `_` in a hole: the next input, taken from the scratch stack. Only
-- at the hole's own depth, not inside a quotation in it, which a loop may
-- run with its own state on the scratch stack.
: input-word
  744 get -1 eq? if 29 trap then
  800 get 1056 lit@ eq? 0= if 29 trap then
  744 get 1 u+ 744 put 34 prim, ;

-- The outer interpreter over the current input: string literals and numbers
-- before lookup.
-- Compiling a word whose entry is flagged as an inline primitive emits the
-- primitive op itself instead of a call to its wrapper. Before compiling
-- anything, or running an immediate word not flagged transparent (bit 2),
-- pending quotations are materialized where they stand; at top level they
-- become values on the stack, there and at the end of the input. Transparent
-- immediate words (the consumers, `[`, `--`) run directly at top level.
-- ( -- ) `compile-token` compiles the word just read; the code in a string's
-- holes is compiled by it too, through 104.
: compile-token
  40 get 64 get c@
  dup 34 eq? if drop materialize string-literal exit then
  39 eq? 1 72 get ult? and if materialize raw-literal exit then
  number dup if materialize 2 eq? if fliteral else literal then exit then
  drop token lookup dup 0= if 1 trap then
  dup 16 u+ get
  dup 1 and if dup 4 and 0= if materialize then drop >xt call exit then
  materialize
  dup 24 and if 1 960 put then
  dup 2 and if nip 8 rshift prim, else drop >xt compile, then ;
-- At top level the brackets mark and gather the stack in place, and marks
-- belong to a frame, so this half stays in `interpret` itself.
: interpret
  cycle read-word while
    0 get if compile-token else
    40 get 64 get c@ 34 eq? if
      top-materialize lit-holes? if literal-at-top else string-literal then
    else
    40 get 64 get c@ 39 eq? 1 72 get ult? and if top-materialize raw-literal else
    number dup if >r >r top-materialize r> r> shadow-literal else
      drop token lookup dup 0= if 1 trap then
      dup 16 u+ get
      dup 1 and if
        dup 4 and 0= if >r >r top-materialize r> r> then
        dup 224 and if
          dup 32 and if drop drop mark shadow-open else
          64 and if drop gather shadow-close else drop map-gather shadow-close-map then then
        else dup 4 and if drop >xt call else swap >xt swap run-typed then then
      else
        swap >xt swap >r >r top-materialize r> r> run-typed
      then
    then
    then
    then
    then
  repeat
  0 get 0= if top-materialize then ;

-- ( input-region length -- ) Reentrant: the caller's input is restored, so
-- words may evaluate text while their own input is being interpreted.
: evaluate
  40 get >r 48 get >r 56 get >r 64 get >r 72 get >r
  48 put 40 put 0 56 put interpret
  r> 72 put r> 64 put r> 56 put r> 48 put r> 40 put ;

-- Phase 7: recovery, dictionary export and boot.
: recover 24 get dup if region-free else drop then
  cycle 800 get while
    800 get 1 u- dup 800 put 24 u* 2560 u+ get dup if region-free else drop then
  repeat
  cycle 808 get while 808 get 1 u- dup 808 put q-entry get region-free repeat
  0 24 put 0 16 put 0 0 put 0 600 put 0 872 put 0 960 put 0 968 put
  0 3520 put 0 3528 put 0 784 put -1 744 put ;

-- Dictionary export: oldest first, name length, flags, code CID, name bytes.
: out-byte 400 get 408 get c! 408 get 1 u+ 408 put ;
: out-cell 0 360 put cycle 360 get 8 ult? while dup 360 get 8 u* rshift out-byte 360 get 1 u+ 360 put repeat drop ;
: save-list dup 0= if drop exit then dup get recur 440 put
  440 get 24 u+ get out-cell
  440 get 16 u+ get out-cell
  440 get >xt 400 get 408 get code-cid 408 get 32 u+ 408 put
  1 440 get 40 u+ 400 get 408 get 440 get 24 u+ get copy
  408 get 440 get 24 u+ get u+ 408 put ;
: snapshot 1048576 region-new 400 put 0 408 put 8 get save-list 400 get 0 408 get ;

: in-cell 0 352 put 0 360 put
  cycle 360 get 8 ult? while
    384 get 392 get c@ 360 get 8 u* lshift 352 get or 352 put
    392 get 1 u+ 392 put 360 get 1 u+ 360 put
  repeat 352 get ;
: restore 416 put 392 put 384 put
  cycle 392 get 416 get ult? while
    in-cell 424 put
    in-cell dup 65536 ult? 0= if 7 trap then 432 put
    384 get 392 get resolve 392 get 32 u+ 392 put
    432 get 384 get 392 get 424 get install
    392 get 424 get u+ 392 put
  repeat
  392 get 416 get eq? 0= if 7 trap then ;

-- Signed application arithmetic over the unsigned machine operations.
-- Results that do not fit a signed 64-bit cell trap (10) instead of wrapping.
: min-int 9223372036854775807 1 u+ ;
: negative? min-int and 0= 0= ;
: negate 0 swap u- ;
: abs dup negative? if negate then ;
: lt? swap min-int xor swap min-int xor ult? ;
: gt? swap lt? ;
: lte? gt? 0= ;
: gte? lt? 0= ;
: + over over u+ >r r@ xor swap r@ xor and negative? if 10 trap then r> ;
: - over over u- >r over xor swap r@ xor and negative? if 10 trap then r> ;
: / dup 0= if 11 trap then
  over min-int eq? over -1 eq? and if 10 trap then
  over over xor negative? >r
  abs swap abs swap u/ r> if negate then ;
: mod over over / u* u- ;
: * over 0= if drop exit then
  over over u* >r swap r@ swap / eq? 0= if 10 trap then r> ;
-- Float clauses of the comparison families. IEEE comparisons with a NaN are
-- false, so `lte?` is less-than or equal, not the negation of greater-than.
: f-gt? swap flt? ;
: f-lte? over over flt? >r feq? r> or ;
: f-gte? swap f-lte? ;

-- Arrays (docs/ARRAYS.md): `( … )` gathers what its body leaves into a
-- persistent vector of cells, held by the machine. `length` and `at` compile
-- to their primitives; the checker gives `at`'s result the element type.
-- A definition with a literal is resolved at `;` (960), so the types of its
-- arrays are checked, and lifting applies inside it.
: qopen 46 prim, 1 960 put ;
: qclose 47 prim, ;
-- `{ k v … }` gathers key and value pairs into a map, as `( … )` gathers an
-- array: `{` marks like `(`, `}` is primitive 56.
: qmapclose 56 prim, ;
-- ( a -- n )
: length vector-length ;
-- ( a i -- x )
: at vector-at ;
-- ( a b -- c ) Two arrays, or two strings, joined.
: concat seq-concat ;
-- ( a i j -- b ) Elements, or characters, i to j - 1.
: slice seq-slice ;
-- ( a b -- flag ) Whether two arrays, two strings or two maps have equal
-- contents.
: same? seq-same? ;
-- ( m k v -- m' ) A new map with key k set to v, or array with element k
-- replaced. Installed as `put`, a name the system track keeps for itself.
: map-put kv-put ;
-- ( m k -- flag ) Whether a map has a key.
: has? kv-has? ;
-- ( m k -- m' ) A new map without a key.
: remove kv-remove ;
-- ( m -- a ) ( m -- a ) A map's keys, and its values, as arrays.
: keys kv-keys ;
: values kv-values ;

-- Strings, second slice (docs/STRINGS.md).
-- ( x -- ) Writes a value as text.
: print >string write ;
-- ( s -- n ) ( s -- f ) A string's number; a string that is not one traps 28.
: >integer text>integer 0= if 28 trap then ;
: >float text>float 0= if 28 trap then ;
-- ( a b -- n ) ( s t -- i ) Order two strings (-1, 0 or 1), and find one in
-- another (its index in characters, or -1).
: order compare ;
: index-of search ;
-- Ordering words' clauses for strings, by code point.
: text-lt? compare 0 lt? ;
: text-gt? compare 0 gt? ;
: text-lte? compare 0 lte? ;
: text-gte? compare 0 gte? ;

-- The lifting rule. A lifted word is one of these templates with its calls to
-- `lift-op` pointed at the element operation. Each keeps its arrays, value,
-- length, result and index in a small region of its own, and builds its result
-- from an empty vector (`mark gather`) with `vector-push`.
: lift-op drop 1123581321 xor ;
-- ( a x -- c ) Each element e of a, as e x op.
: lift-ax 48 region-new >r
  r@ 8 ! r@ 0 !
  r@ 0 @ vector-length r@ 24 !
  mark gather r@ 32 !
  0 r@ 40 !
  cycle r@ 40 @ r@ 24 @ ult? while
    r@ 32 @ r@ 0 @ r@ 40 @ vector-at r@ 8 @ lift-op vector-push r@ 32 !
    r@ 40 @ 1 u+ r@ 40 !
  repeat
  r@ 32 @ r> region-free ;
-- ( x a -- c ) Each element e of a, as x e op.
: lift-xa 48 region-new >r
  r@ 0 ! r@ 8 !
  r@ 0 @ vector-length r@ 24 !
  mark gather r@ 32 !
  0 r@ 40 !
  cycle r@ 40 @ r@ 24 @ ult? while
    r@ 32 @ r@ 8 @ r@ 0 @ r@ 40 @ vector-at lift-op vector-push r@ 32 !
    r@ 40 @ 1 u+ r@ 40 !
  repeat
  r@ 32 @ r> region-free ;
-- ( a b -- c ) Elements e of a and f of b in step, as e f op. The lengths
-- must agree (trap 25).
: lift-aa 48 region-new >r
  r@ 8 ! r@ 0 !
  r@ 0 @ vector-length r@ 24 !
  r@ 8 @ vector-length r@ 24 @ eq? 0= if 25 trap then
  mark gather r@ 32 !
  0 r@ 40 !
  cycle r@ 40 @ r@ 24 @ ult? while
    r@ 32 @ r@ 0 @ r@ 40 @ vector-at r@ 8 @ r@ 40 @ vector-at lift-op vector-push r@ 32 !
    r@ 40 @ 1 u+ r@ 40 !
  repeat
  r@ 32 @ r> region-free ;
-- ( op region length -- ) Point the code's calls to `lift-op` at op.
: lift-patch
  80 region-new >r
  r@ 16 ! r@ 8 ! r@ 0 !
  ' lift-op r@ 32 code-cid
  0 r@ 24 !
  cycle r@ 24 @ r@ 16 @ ult? while
    r@ 8 @ r@ 24 @ c@
    dup 3 eq? over 9 eq? or if
      1 r@ 72 ! 0 r@ 64 !
      cycle r@ 64 @ 32 ult? while
        r@ 8 @ r@ 24 @ 1 u+ r@ 64 @ u+ c@ r@ r@ 64 @ 32 u+ c@ eq? 0= if 0 r@ 72 ! then
        r@ 64 @ 1 u+ r@ 64 !
      repeat
      r@ 72 @ if r@ 0 @ r@ 8 @ r@ 24 @ 1 u+ code-cid then
    then
    oplen r@ 24 @ u+ r@ 24 !
  repeat r> region-free ;
-- ( op template -- lifted ) The template's code with its calls to `lift-op`
-- pointed at op, sealed, and remembered in the instance table (keyed by the
-- template with bit 61 set).
: make-lifted
  over over 2305843009213693952 or swap find-instance dup if nip nip exit then drop
  dup 1 680 code-cid 1 680 blob-read swap drop
  dup region-new 3560 put 3568 put 0 3560 get 0 3568 get copy
  over 3560 get 3568 get lift-patch
  3560 get 0 3568 get seal 3560 get region-free
  >r 2305843009213693952 or swap r@ add-instance r> ;
-- ( family b t -- op | 0 ) The operation on elements of types b and t, t on
-- top: if either is itself an array, the lifted word for them, since lifting
-- goes all the way down, as in APL; otherwise the family's clause for them,
-- or the family itself, the i64 version, if both are i64 or unknown.
: element-op
  0 792 put
  over array-type? over array-type? or if
    3392 get call dup if 792 put then exit
  then
  over 2 ult? over 2 ult? and >r
  swap 8 lshift or
  over swap find-clause
  dup if nip r> drop exit then drop
  r> if exit then drop 0 ;
-- ( op -- t ) The type of an element operation's result.
: op-out
  792 get dup if nip exit then drop
  dup family? if drop 1 exit then
  dup callee-effect drop 8 u* 712 get swap @ 255 and ;
-- ( token b t -- lifted arraytype | 0 ) For a family call whose two inputs
-- have types b and t, t on top: the lifted word, if either is an array. An
-- array whose elements' known types differ (252) does not lift: the i64
-- version would be wrong for some of them. The lifted word's remembered
-- output type is set to the array type, which its own analysis, seeing only
-- a region, cannot find.
: lift-for
  over array-type? over array-type? or 0= if drop drop drop 0 exit then
  over 252 eq? over 252 eq? or if drop drop drop 0 exit then
  over array-type? if dup array-type? if ' lift-aa else ' lift-ax then else ' lift-xa then >r
  element-type swap element-type swap
  element-op
  dup 0= if r> drop exit then
  dup op-out array-of
  swap r> make-lifted swap
  over callee-effect drop over 8 u* >r dup 712 get r> ! ;
-- The families and their clauses: f64 arithmetic and comparisons (types 514
-- are f64 f64).
-- Staged types, a prototype (doc/design/TYPES.md, docs/STAGED.md).
-- `typed name … ;` lowers its body to the explicit form, in which `.`
-- applies a word (stage 1), records it with its stack effect, and runs a
-- type stage over it (stage 2). The type stage keeps a stack of judgments
-- beside the code, settles each literal's type from its context, and leaves
-- plain code behind. `explicit name … ;` takes a body already in the
-- explicit form. A heading, `# < … >`, gives the definitions after it their
-- context, which lowering puts first in each body as its own signature.
--
-- Typed words of one name are the clauses of a family. Applied in a typed
-- body, a family is resolved there, on the caller's judgments: by types at
-- compile time, the most specific clause winning, and by guards at run time,
-- in the order the clauses were defined. A clause is evaluated where it is
-- applied, so its types are worked out for each use. A clause that takes
-- values without saying their types, or has guards or type variables, has no
-- code of its own: it exists only to be applied so.
--
-- Types: 1 i64, 2 f64, 3 money (exact cents), 4 integer literal, 5 decimal
-- literal, 6 a type, 7 an operation, 8 a typed word, 9 string, 10-35 the type
-- variables `a` to `z`, 50 the start of an array literal, and from 256 types
-- built by `ary`, `vec` and `map`, each a term in a table, equal terms one
-- entry, so equal types are one number. A judgment is 40 bytes: type, known
-- (1 if its value is), value, scale (a decimal literal's digits after the
-- point), and the offset of the literal emitted for it, or -1. A literal is
-- emitted where it appears, as a placeholder whose opcode and value are
-- patched once its type is known, so the code's stack always matches the
-- judgments'. Operations: 1 `+`, 2 `*`, 3 `-`, 4 `dup`, 5 `drop`, 6 `swap`,
-- 7 `length`, 8 `at`, 9 `concat`, 10 `lt?`, 11 `gt?`, 12 `eq?`. A type term
-- is 24 bytes: constructor (1 `ary`, 2 `vec`, 3 `map`) and two arguments: an
-- element type; a length and an element type; a key and a value type. A
-- typed word is 80 bytes: its explicit form's region and length, the values
-- it takes and leaves, and its name's length and bytes.
--
-- Working memory: 272 the judgments' region, 280 their count, 112 the typed
-- words' region, 120 their count, 168 how deeply typed words are being
-- applied, 592 the token of `st-token-body`, 608 the type terms' region, 640
-- their count, 312-336, 368-376 and 512 temporaries. The typed words' region
-- keeps more state after the 64 words: see `st-state`. Traps: 1 no clause,
-- like an unknown word, at compile time or at run time; 23 a type mismatch,
-- a tie, or too few values; 27 a limit; 40 a word the prototype does not
-- know; 41 a literal that cannot become its type; 42 typed words applied too
-- deeply.
-- ( k -- offset ) The k-th judgment from the top.
: st-at 280 get swap u- 1 u- 40 u* ;
-- ( k field -- v ) ( v k field -- )
: st@ swap st-at u+ 272 get swap @ ;
: st! swap st-at u+ 272 get swap ! ;
-- ( type known value scale slot -- )
: st-push
  280 get dup 64 ult? 0= if 27 trap then 40 u* 312 put
  272 get 312 get 32 u+ ! 272 get 312 get 24 u+ ! 272 get 312 get 16 u+ !
  272 get 312 get 8 u+ ! 272 get 312 get !
  280 get 1 u+ 280 put ;
: st-drop 280 get 1 u- 280 put ;
-- ( n -- ) At least n judgments, or trap.
: st-need 280 get swap ult? if 23 trap then ;
-- ( t -- flag ) Whether a type is a literal's; whether it has values at run
-- time, rather than being a type, an operation, a typed word or a mark;
-- whether it is a number's or a literal's.
: st-lit? dup 4 eq? swap 5 eq? or ;
: st-value-type? dup 6 ult? over 9 eq? or swap 255 swap ult? or ;
: st-num? dup 1 u- 3 ult? swap st-lit? or ;
-- ( -- ) The typed words' region, with 1,024 bytes after the 64 words for
-- the prototype's other state, at 5120 and on: 0 and 8 the current heading's
-- bracket, its region and length; 16 where `--` fell in the bracket being
-- read; 24 and 32 the declared outputs, 16 bits each, and how many; 40-247
-- the type variables' bindings; 248 how many guards a signature has, and from
-- 256 each guard's word and how many types precede it, 16 bytes each; 320
-- whether guards are being recorded; 328 where the bracket's types start;
-- 344-360 a match's score, verdict and length; 728-768 a guard test's and
-- an alternative's temporaries; 776-792 a bracket's effect.
: st-state 112 get 0= if 6144 region-new 112 put 0 120 put then ;
-- ( off -- v ) ( v off -- )
: st-cell@ st-state 112 get swap 5120 u+ @ ;
: st-cell! st-state 112 get swap 5120 u+ ! ;
-- ( i f -- v ) A field of type term i.
: st-tfield swap 24 u* u+ 608 get swap @ ;
-- ( con a b -- t ) The type a constructor builds from its arguments: the
-- existing term if there is one, so equal types are one number.
: st-tterm
  608 get 0= if 6144 region-new 608 put 0 640 put then
  328 put 320 put 312 put
  0 cycle dup 640 get ult? while
    dup 0 st-tfield 312 get eq?
    over 8 st-tfield 320 get eq? and
    over 16 st-tfield 328 get eq? and if 256 u+ exit then
    1 u+
  repeat drop
  640 get 256 ult? 0= if 27 trap then
  640 get 24 u* 336 put
  312 get 608 get 336 get ! 320 get 608 get 336 get 8 u+ !
  328 get 608 get 336 get 16 u+ !
  640 get 256 u+ 640 get 1 u+ 640 put ;
-- ( t -- con a b ) A built type's constructor and arguments; 0 0 0 for a
-- type of its own.
: st-tparts
  dup 256 ult? if drop 0 0 0 exit then
  256 u- dup 0 st-tfield over 8 st-tfield rot 16 st-tfield ;
-- ( t -- flag ) Whether a type is a variable; ( v -- off ) its binding's
-- cell; ( -- ) forget every binding.
: st-var? 10 u- 26 ult? ;
: st-var-cell 10 u- 8 u* 40 u+ ;
: st-unbind 0 cycle dup 26 ult? while 0 over 8 u* 40 u+ st-cell! 1 u+ repeat drop ;
-- ( t -- t' ) A type with its bound variables replaced.
: st-subst
  dup st-var? if dup st-var-cell st-cell@ dup if nip recur exit then drop exit then
  dup 256 ult? if exit then
  st-tparts >r >r >r
  r@ 1 eq? if r> drop r> recur r> drop 1 swap 0 st-tterm exit then
  r@ 2 eq? if r> drop r> r> recur >r 2 swap r> st-tterm exit then
  r> drop r> recur r> recur >r 3 swap r> st-tterm ;
-- ( t -- flag ) Whether a type has a variable in it.
: st-has-var?
  dup st-var? if drop 1 exit then
  dup 256 ult? if drop 0 exit then
  st-tparts >r >r
  2 eq? if r> drop r> recur exit then
  r> recur r> recur or ;
-- ( p t -- flag ) Whether type t matches pattern p, binding p's variables; a
-- bound variable must match what it was bound to.
: st-unify
  over st-var? if
    over st-var-cell st-cell@ dup if rot drop swap recur exit then drop
    swap st-var-cell st-cell! 1 exit
  then
  over over eq? if drop drop 1 exit then
  over 256 ult? over 256 ult? or if drop drop 0 exit then
  st-tparts >r >r >r
  st-tparts
  rot dup r> eq? 0= if drop drop drop r> drop r> drop 0 exit then
  2 eq? if swap r> eq? 0= if drop r> drop 0 exit then r> recur exit then
  swap r> recur 0= if drop r> drop 0 exit then
  r> recur ;
-- ( t -- n ) How specific a type is: its parts that are not variables.
: st-weight
  dup 0= if exit then
  dup st-var? if drop 0 exit then
  dup 256 ult? if drop 1 exit then
  st-tparts >r >r
  2 eq? if r> drop r> recur 2 u+ exit then
  r> recur r> recur u+ 1 u+ ;
-- ( n -- 10^n )
: st-pow10 1 swap cycle dup while swap 10 u* swap 1 u- repeat drop ;
-- ( -- slot ) A literal to be settled later.
: placeholder here 0 literal ;
-- ( v o -- ) The eight bytes of v, little-endian, into the definition at
-- offset o, which need not be aligned, as a cell store's must.
: out-cell!
  312 put
  8 cycle dup while
    over 255 and out 312 get c! 312 get 1 u+ 312 put
    swap 8 rshift swap 1 u-
  repeat drop drop ;
-- ( k t -- ) Give literal judgment k the type t, by t's conversion, and
-- patch its placeholder: an integer literal becomes an i64, a float, or
-- whole units of money; a decimal literal a float, or cents if it has at
-- most two digits after the point once trailing zeros go, exactly, never
-- through a float.
: st-convert
  328 put 336 put
  336 get 0 st@ 4 eq? if
    336 get 16 st@
    328 get 2 eq? if i>f else 328 get 3 eq? if 100 * else
      328 get 1 eq? 0= if 41 trap then then then
  else
    336 get 16 st@ 336 get 24 st@
    328 get 2 eq? if st-pow10 i>f swap i>f swap f/ else
      328 get 3 eq? if
        cycle dup 2 swap ult? if over 10 mod 0= else 0 then while
          swap 10 / swap 1 u-
        repeat
        dup 2 swap ult? if 41 trap then 2 swap u- st-pow10 *
      else 41 trap then
    then
  then
  dup 336 get 16 st! 0 336 get 24 st! 328 get 336 get 0 st!
  336 get 32 st@ 320 put
  328 get 2 eq? if 10 else 1 then out 320 get c!
  320 get 1 u+ out-cell! ;
-- ( k -- ) A literal no context typed: an integer is an i64, a decimal a
-- float.
: st-default dup 0 st@ 4 eq? if 1 else 2 then st-convert ;
-- ( k t -- ) Judgment k is of type t, a pattern whose variables bind: a
-- literal takes it, or its default if it is still a variable; anything else
-- must match it, since nothing converts implicitly.
: st-annotate-at
  st-subst
  over 0 st@ st-lit? if
    dup st-has-var? 0= if st-convert exit then
    over st-default
  then
  swap 0 st@ st-unify 0= if 23 trap then ;
-- ( a b op -- c ) Checked integer arithmetic, at compile time.
: st-int-op dup 1 eq? if drop + exit then 2 eq? if * else - then ;
-- ( op -- ) Two literals emitted last, folded into one at compile time.
-- Decimals stay exact: sums align to the longer fraction, and products add
-- their fractions' lengths.
: st-fold
  376 put
  1 0 st@ 4 eq? 0 0 st@ 4 eq? and if
    1 16 st@ 0 16 st@ 376 get st-int-op 320 put 4 328 put 0 336 put
  else
    376 get 2 eq? if
      1 16 st@ 0 16 st@ * 320 put 1 24 st@ 0 24 st@ u+ 336 put
    else
      1 24 st@ 0 24 st@ over over ult? if swap then drop 336 put
      1 16 st@ 336 get 1 24 st@ u- st-pow10 *
      0 16 st@ 336 get 0 24 st@ u- st-pow10 *
      376 get 1 eq? if + else - then 320 put
    then
    5 328 put
  then
  1 32 st@ 16 put 0 848 put st-drop st-drop
  328 get 1 320 get 336 get placeholder st-push ;
-- ( t -- e ) An array type's element type, or 0.
: st-elem-of
  dup 256 ult? if drop 0 exit then
  st-tparts drop swap 1 eq? if exit then drop 0 ;
-- ( t -- b ) A type as the checker's byte: i64, and money, 1; f64 2;
-- arrays of them 3 and 4; anything else 0.
: st-checker-type
  dup 2 eq? if drop 2 exit then
  dup 1 eq? over 3 eq? or if drop 1 exit then
  st-elem-of dup 2 eq? if drop 4 exit then
  dup 1 eq? swap 3 eq? or if 3 else 0 then ;
-- ( t -- ) The two judgments on top give way to a value of type t, after
-- an operation is emitted.
: st-result st-drop st-drop 0 0 0 -1 st-push ;
-- ( -- ) `+`, `*` or `-` (at 368) with an array: the clause `< a ary a -- a
-- ary >`, by the lifted word march's checker makes for the element
-- operation (`lift-for`). A literal takes the elements' type.
: st-lift
  1 0 st@ st-elem-of dup 0= if drop 0 0 st@ st-elem-of then 376 put
  376 get dup 1 u- 3 ult? 0= if 23 trap then
  3 eq? 368 get 2 eq? and if 23 trap then
  1 0 st@ st-lit? if 1 376 get st-convert then
  0 0 st@ st-lit? if 0 376 get st-convert then
  1 0 st@ dup 376 get eq? swap st-elem-of 376 get eq? or 0= if 23 trap then
  0 0 st@ dup 376 get eq? swap st-elem-of 376 get eq? or 0= if 23 trap then
  368 get 1 eq? if ' + else 368 get 2 eq? if ' * else ' - then then
  1 0 st@ st-checker-type 0 0 st@ st-checker-type lift-for
  dup 0= if 23 trap then drop compile,
  1 0 st@ st-elem-of if 1 0 st@ else 0 0 st@ then st-result ;
-- ( -- ) Arithmetic (at 368) on two numbers of one type: floats by the
-- float primitive, integers and cents by the checked word.
: st-arith
  1 0 st@ 2 eq? if
    368 get 1 eq? if 36 else 368 get 2 eq? if 38 else 37 then then prim,
  else
    368 get 1 eq? if ' + compile, else
      368 get 2 eq? if ' * compile, else ' - compile, then
    then
  then
  1 0 st@ st-result ;
-- ( -- ) A comparison (at 368) of two numbers of one type: a flag.
: st-compare
  1 0 st@ 2 eq? if
    368 get 10 eq? if 41 prim, else
      368 get 11 eq? if 2 prim, 41 prim, else 40 prim, then
    then
  else
    368 get 10 eq? if ' lt? compile, else
      368 get 11 eq? if ' gt? compile, else 10 prim, then
    then
  then
  1 st-result ;
-- ( op -- ) `+`, `*`, `-` or a comparison, by its operands' types: two
-- literals emitted last fold, for arithmetic; an array lifts; a literal takes
-- the other operand's type; then both types must agree. Money is not
-- multiplied.
: st-binop
  368 put 2 st-need
  1 0 st@ st-lit? 0 0 st@ st-lit? and if
    368 get 4 ult?
    1 32 st@ 9 u+ 0 32 st@ eq? and 0 32 st@ 9 u+ here eq? and if
      368 get st-fold exit
    then
    1 st-default 0 st-default
  then
  368 get 4 ult? 1 0 st@ st-elem-of 0 0 st@ st-elem-of or 0= 0= and if
    st-lift exit
  then
  1 0 st@ st-num? 0 0 st@ st-num? and 0= if 23 trap then
  1 0 st@ st-lit? if 1 0 0 st@ st-convert then
  0 0 st@ st-lit? if 0 1 0 st@ st-convert then
  1 0 st@ 0 0 st@ eq? 0= if 23 trap then
  1 0 st@ 3 eq? 368 get 2 eq? and if 23 trap then
  368 get 9 ult? if st-arith else st-compare then ;
-- ( k -- ) Judgment k must have a value at run time.
: st-value 0 st@ st-value-type? 0= if 23 trap then ;
-- ( -- ) `dup`: a literal is copied as a new literal, so each copy can take
-- its own type; anything else is duplicated at run time.
: st-dup
  1 st-need 0 st-value
  0 0 st@ st-lit? if
    0 0 st@ 1 0 16 st@ 0 24 st@ placeholder st-push exit
  then
  0 prim, 0 0 st@ 0 0 0 -1 st-push ;
-- ( -- ) `drop`: a literal emitted last is taken back; anything else is
-- dropped at run time.
: st-drop-word
  1 st-need 0 st-value
  0 32 st@ dup -1 eq? 0= swap 9 u+ here eq? and if
    0 32 st@ 16 put 0 848 put st-drop exit
  then
  1 prim, st-drop ;
-- ( f -- ) ( -- ) `swap`, at run time, and of the two judgments.
: st-swap-field >r 1 r@ st@ 0 r@ st@ 1 r@ st! 0 r> st! ;
: st-swap
  2 st-need 0 st-value 1 st-value
  2 prim,
  0 st-swap-field 8 st-swap-field 16 st-swap-field 24 st-swap-field
  32 st-swap-field ;
-- ( -- ) `length`: of a string, an array or a map, an i64 at run time; of a
-- vec, its length, known at compile time, so the value is dropped and the
-- length is a literal.
: st-length
  1 st-need 0 0 st@
  dup 256 ult? if
    9 eq? 0= if 23 trap then 48 prim, st-drop 1 0 0 0 -1 st-push exit
  then
  st-tparts drop swap 2 eq? if
    1 prim, st-drop >r 4 1 r> 0 placeholder st-push exit
  then
  drop 48 prim, st-drop 1 0 0 0 -1 st-push ;
-- ( t -- ) Emit `at`; its result is of type t.
: st-elem 49 prim, st-result ;
-- ( -- ) `at`: a string's code point or an array's element, by an i64
-- index; a map's value, by a key of its key type. A literal index or key
-- takes the type wanted; a literal index into a vec is checked against its
-- length at compile time.
: st-at
  2 st-need
  1 0 st@ 9 eq? if 0 1 st-annotate-at 1 st-elem exit then
  1 0 st@ dup 256 ult? if 23 trap then
  st-tparts 376 put 368 put
  dup 3 eq? if drop 0 368 get st-annotate-at 376 get st-elem exit then
  dup 2 eq? if
    drop 0 0 st@ st-lit? if
      0 1 st-annotate-at 0 16 st@ 368 get ult? 0= if 23 trap then
    then
    0 1 st-annotate-at 376 get st-elem exit
  then
  drop 0 1 st-annotate-at 368 get st-elem ;
-- ( t -- ) Emit `concat`; its result is of type t.
: st-concat-to 53 prim, st-result ;
-- ( -- ) `concat`: two strings, or two arrays of one type; two vecs of one
-- element type make a vec as long as both, known at compile time.
: st-concat
  2 st-need
  1 0 st@ 312 put 0 0 st@ 320 put
  312 get 9 eq? 320 get 9 eq? and if 9 st-concat-to exit then
  312 get 256 ult? 320 get 256 ult? or if 23 trap then
  312 get st-tparts 376 put 368 put 336 put
  320 get st-tparts
  336 get 1 eq? if
    drop drop 1 eq? 0= if 23 trap then
    312 get 320 get eq? 0= if 23 trap then
    312 get st-concat-to exit
  then
  336 get 2 eq? if
    376 get eq? 0= if 23 trap then
    swap 2 eq? 0= if 23 trap then
    368 get + 2 swap 376 get st-tterm st-concat-to exit
  then
  23 trap ;
-- ( -- ) `(`: an array literal begins. The machine marks the stack, and a
-- judgment marks where the elements start.
: st-open 46 prim, 50 0 0 0 -1 st-push ;
-- ( -- k ) How many judgments are above the nearest `(`.
: st-mark-depth
  0 cycle dup 280 get ult? if dup 0 st@ 50 eq? 0= else 0 then while 1 u+ repeat
  dup 280 get ult? 0= if 23 trap then ;
-- ( -- ) `)`: the elements gathered into an array. They share one type:
-- literals take the others', or, all literals, f64 if any is a decimal and
-- i64 otherwise.
: st-close
  st-mark-depth 368 put 368 get 0= if 23 trap then
  0 376 put
  0 cycle dup 368 get ult? while
    dup 0 st@ st-lit? 0= if dup 0 st@ 376 put then 1 u+
  repeat drop
  376 get 0= if
    1 376 put
    0 cycle dup 368 get ult? while dup 0 st@ 5 eq? if 2 376 put then 1 u+ repeat drop
  then
  0 cycle dup 368 get ult? while
    dup 0 st@ st-lit? if dup 376 get st-convert then
    dup 0 st@ 376 get eq? 0= if 23 trap then
    dup st-value 1 u+
  repeat drop
  47 prim,
  368 get cycle dup while st-drop 1 u- repeat drop st-drop
  1 376 get 0 st-tterm 0 0 0 -1 st-push ;
-- ( id -- ) An operation, applied.
: st-op
  dup 4 ult? if st-binop exit then
  dup 10 u- 3 ult? if st-binop exit then
  dup 4 eq? if drop st-dup exit then
  dup 5 eq? if drop st-drop-word exit then
  dup 6 eq? if drop st-swap exit then
  dup 7 eq? if drop st-length exit then
  8 eq? if st-at else st-concat then ;
-- ( r o n -- flag ) ( c -- flag ) Whether the current word is these bytes,
-- or this one character.
: tok=
  dup 72 get eq? 0= if drop drop drop 0 exit then
  >r >r >r 40 get 64 get r> r> r> bytes-eq? ;
: tok-char? 72 get 1 eq? if 40 get 64 get c@ eq? else drop 0 then ;
-- ( idx field -- v ) A field of a typed word.
: st-entry swap 80 u* u+ 112 get swap @ ;
-- ( -- idx | -1 ) The typed word the current word names, the newest first.
: st-find
  120 get
  cycle dup while
    1 u-
    dup 32 st-entry 72 get eq? if
      dup 80 u* 40 u+ >r 40 get 64 get 112 get r> 72 get bytes-eq? if exit then
    then
  repeat drop -1 ;
-- ( -- t ) The type the current word names: a type's name, or a single
-- letter, a type variable.
: st-type-name
  s" i64" tok= if 1 exit then
  s" f64" tok= if 2 exit then
  s" money" tok= if 3 exit then
  s" string" tok= if 9 exit then
  72 get 1 eq? if 40 get 64 get c@ 97 u- dup 26 ult? if 10 u+ exit then drop then
  40 trap ;
-- ( -- ref | -1 ) The guard the current word names: a comparison (1010 to
-- 1012), or a typed word.
: st-guard-ref
  s" lt?" tok= if 1010 exit then
  s" gt?" tok= if 1011 exit then
  s" eq?" tok= if 1012 exit then
  st-find ;
-- ( -- ) A name: an operation, a typed word or a type, as a value until `.`
-- applies it.
: st-name
  s" +" tok= if 7 1 1 0 -1 st-push exit then
  s" *" tok= if 7 1 2 0 -1 st-push exit then
  s" -" tok= if 7 1 3 0 -1 st-push exit then
  s" dup" tok= if 7 1 4 0 -1 st-push exit then
  s" drop" tok= if 7 1 5 0 -1 st-push exit then
  s" swap" tok= if 7 1 6 0 -1 st-push exit then
  s" length" tok= if 7 1 7 0 -1 st-push exit then
  s" at" tok= if 7 1 8 0 -1 st-push exit then
  s" concat" tok= if 7 1 9 0 -1 st-push exit then
  s" lt?" tok= if 7 1 10 0 -1 st-push exit then
  s" gt?" tok= if 7 1 11 0 -1 st-push exit then
  s" eq?" tok= if 7 1 12 0 -1 st-push exit then
  st-find dup -1 eq? 0= if 8 swap 1 swap 0 -1 st-push exit then drop
  st-type-name 6 swap 1 swap 0 -1 st-push ;
-- ( -- in out ) What applying the current name takes and leaves.
: st-name-effect
  s" +" tok= s" *" tok= or s" -" tok= or if 2 1 exit then
  s" lt?" tok= s" gt?" tok= or s" eq?" tok= or if 2 1 exit then
  s" dup" tok= if 1 2 exit then
  s" drop" tok= if 1 0 exit then
  s" swap" tok= if 2 2 exit then
  s" length" tok= if 1 1 exit then
  s" at" tok= s" concat" tok= or if 2 1 exit then
  st-find dup -1 eq? 0= if dup 16 st-entry swap 24 st-entry exit then drop
  st-type-name drop 1 1 ;
-- ( -- m s ) A decimal literal's digits and how many follow the point:
-- `1.10` is 110 and 2.
: dec-literal
  64 get 312 put 0 320 put
  40 get 312 get c@ 45 eq? if 1 320 put 312 get 1 u+ 312 put then
  40 get 312 get 64 get 72 get u+ 46 byte-find 328 put
  40 get 312 get 328 get 312 get u- decimal 1 eq? 0= if 41 trap then
  64 get 72 get u+ 328 get 1 u+ u- 336 put
  336 get 0= if 41 trap then
  40 get 328 get 1 u+ 336 get decimal 1 eq? 0= if 41 trap then
  swap 336 get st-pow10 u* u+
  320 get if negate then 336 get ;
-- ( -- ) A number: an integer or a decimal literal, emitted as a placeholder.
: st-literal
  40 get 64 get dup 72 get u+ 46 byte-find 64 get 72 get u+ ult? if
    dec-literal >r >r 5 1 r> r> placeholder st-push exit
  then
  number 1 eq? 0= if 41 trap then >r 4 1 r> 0 placeholder st-push ;
-- ( t -- ) Push a type, as a value.
: st-push-type 6 1 rot 0 -1 st-push ;
-- ( k -- t ) Judgment k must be a type; its number.
: st-type-arg dup 0 st@ 6 eq? 0= if 23 trap then 16 st@ ;
-- ( ref -- ) A guard in a bracket: recorded, with how many types precede
-- it, when a clause's signature is read for matching; otherwise passed by.
: st-guard-word
  320 st-cell@ 0= if drop exit then
  248 st-cell@ 4 ult? 0= if 27 trap then
  248 st-cell@ 16 u* 256 u+ st-cell!
  280 get 328 st-cell@ u- 248 st-cell@ 16 u* 264 u+ st-cell!
  248 st-cell@ 1 u+ 248 st-cell! ;
-- ( -- ) A word inside a bracket: a number is a length, a type's name or a
-- variable is the type, `ary`, `vec` and `map` build types from those below
-- them, `--` divides inputs from outputs, and a guard looks.
: st-type-word
  numeric-start? if
    number 1 eq? 0= if 41 trap then >r 4 1 r> 0 -1 st-push exit
  then
  s" --" tok= if 280 get 16 st-cell! exit then
  s" ary" tok= if 1 st-need 1 0 st-type-arg 0 st-tterm st-drop st-push-type exit then
  s" vec" tok= if
    2 st-need 1 0 st@ 4 eq? 0= if 23 trap then
    2 1 16 st@ 0 st-type-arg st-tterm st-drop st-drop st-push-type exit
  then
  s" map" tok= if
    2 st-need 3 1 st-type-arg 0 st-type-arg st-tterm st-drop st-drop st-push-type exit
  then
  st-guard-ref dup -1 eq? 0= if st-guard-word exit then drop
  st-type-name st-push-type ;
-- ( -- ) `< … >`: a type expression, which leaves a type for each value it
-- types, inputs before `--` and outputs after. First in a definition, the
-- inputs are its values, not known until run time, and the outputs an
-- obligation checked at `;`. Anywhere else, the inputs type as many values
-- on top, the deepest first: a literal takes its type, anything else must
-- match it; there, outputs and guards are passed by. So a typed word's
-- signature, applied in another typed body, types what it is given. 376
-- holds where the types start, then how many there are, 368 whether they are
-- inputs, 312 how many outputs; `st-convert` uses 320-336.
: st-sig
  st-unbind
  280 get dup 376 put 328 st-cell! -1 16 st-cell!
  168 get 0= 280 get 0= and here 0= and 368 put
  cycle read-word 0= if 8 trap then 62 tok-char? 0= while st-type-word repeat
  16 st-cell@ -1 eq? if 280 get 16 st-cell! then
  280 get 16 st-cell@ u- 312 put
  368 get if
    312 get 5 ult? 0= if 27 trap then
    0 24 st-cell! 312 get 32 st-cell!
    0 cycle dup 312 get ult? while
      312 get over u- 1 u- st-type-arg over 16 u* lshift 24 st-cell@ or 24 st-cell!
      1 u+
    repeat drop
  then
  312 get cycle dup while st-drop 1 u- repeat drop
  280 get 376 get u- 376 put
  0 cycle dup 376 get ult? while dup st-type-arg drop 1 u+ repeat drop
  368 get if
    0 cycle dup 376 get ult? while
      dup 16 st@ over 0 st! 0 over 8 st! 0 over 16 st!
      1 u+
    repeat drop exit
  then
  376 get 2 u* st-need
  0 cycle dup 376 get ult? while
    dup 376 get u+ over 16 st@ st-annotate-at
    1 u+
  repeat drop
  376 get cycle dup while st-drop 1 u- repeat drop ;
-- ( -- ) `;`: the outputs a signature declared, if any, type the results; a
-- literal still undecided takes its default type; a type, an operation or a
-- typed word left over is an error. Then the definition ends as any other
-- does.
: st-finish
  32 st-cell@ dup if
    dup 280 get eq? 0= if 23 trap then
    0 cycle over over swap ult? while
      over over u- 1 u- over 24 st-cell@ swap 16 u* rshift 65535 and st-annotate-at
      1 u+
    repeat drop
  then drop
  0 32 st-cell!
  0 cycle dup 280 get ult? while
    dup 0 st@ st-lit? if dup st-default else
      dup 0 st@ st-value-type? 0= if 23 trap then then
    1 u+
  repeat drop
  272 get region-free 0 272 put 0 280 put
  semicolon ;
-- ( idx -- ) A typed word applied: its explicit form, evaluated here, on
-- these judgments, up to its `;`. Each word is read by `st-token-body`,
-- defined below, which applies typed words through this one, so it is
-- reached through 592.
: st-inline
  168 get 16 ult? 0= if 42 trap then 168 get 1 u+ 168 put
  dup 0 st-entry swap 8 st-entry
  40 get >r 48 get >r 56 get >r 64 get >r 72 get >r
  48 put 40 put 0 56 put
  cycle read-word 0= if 8 trap then 59 tok-char? 0= while 592 get call repeat
  r> 72 put r> 64 put r> 56 put r> 48 put r> 40 put
  168 get 1 u- 168 put ;
-- Families. Applying a family allocates a frame of 512 bytes for its state,
-- since a clause's evaluation may apply other families: 0 the candidates,
-- how many, and from 8 each one's typed word and its score, doubled, plus 1
-- if guarded, 16 bytes each; 136 the best unguarded candidate, 144 its
-- score, 152 whether it ties; 160 a snapshot of the judgments, 168 their
-- count, 176 how many inputs, 184 the judgments below them; 192 how many
-- results the first alternative left, -1 before it, and from 200 their
-- types; 264 how many alternatives jump to the end, and from 272 where; 336
-- how many guards jump to the next alternative, and from 344 where; 376 the
-- current clause's guards, how many, and from 384 each one's word and the
-- types before it.
-- ( i j -- flag ) Whether typed words i and j have one name.
: st-same-name?
  over 32 st-entry over 32 st-entry eq? 0= if drop drop 0 exit then
  >r 80 u* 40 u+ 112 get swap 112 get r@ 80 u* 40 u+ r> 32 st-entry bytes-eq? ;
-- ( idx -- n ) Push the input types of typed word idx's signature, its
-- bracket first in its explicit form, recording its guards; -1, and nothing
-- pushed, if it has none. Its outputs are dropped.
: st-clause-sig
  dup 0 st-entry swap 8 st-entry
  40 get >r 48 get >r 56 get >r 64 get >r 72 get >r
  48 put 40 put 0 56 put
  0 248 st-cell!
  read-word 0= if 8 trap then
  60 tok-char? if
    280 get 328 st-cell! -1 16 st-cell! 1 320 st-cell!
    cycle read-word 0= if 8 trap then 62 tok-char? 0= while st-type-word repeat
    0 320 st-cell!
    16 st-cell@ -1 eq? if 280 get 16 st-cell! then
    280 get 16 st-cell@ u- cycle dup while st-drop 1 u- repeat drop
    280 get 328 st-cell@ u-
  else -1 then
  r> 72 put r> 64 put r> 56 put r> 48 put r> 40 put ;
-- ( i -- ) One input of a match: the pattern among the n types on top (n at
-- 360), against the value below them. A literal matches a type it converts
-- to, scoring 2 for its default type and 1 for another, or a variable,
-- scoring 0; anything else must unify, scoring 4 for each part of the
-- pattern that is not a variable.
: st-match-slot
  360 st-cell@ over u- 1 u- 16 st@
  swap 360 st-cell@ 2 u* swap u- 1 u-
  dup 0 st@ st-lit? if
    0 st@ swap st-subst
    dup st-has-var? if drop drop exit then
    over 4 eq? if dup 1 u- 3 ult? else dup 2 eq? over 3 eq? or then
    0= if drop drop 0 352 st-cell! exit then
    swap 4 eq? if 1 else 2 then eq? if 2 else 1 then 344 st-cell@ + 344 st-cell!
    exit
  then
  0 st@ over swap st-unify 0= if drop 0 352 st-cell! exit then
  st-weight 4 * 344 st-cell@ + 344 st-cell! ;
-- ( n -- score ok ) Whether the n types on top match the n values below
-- them, and how specifically. The types are dropped.
: st-match
  st-unbind 360 st-cell! 0 344 st-cell! 1 352 st-cell!
  280 get 360 st-cell@ 2 u* ult? if 0 352 st-cell! then
  352 st-cell@ if
    0 cycle dup 360 st-cell@ ult? 352 st-cell@ and while dup st-match-slot 1 u+ repeat drop
  then
  360 st-cell@ cycle dup while st-drop 1 u- repeat drop
  344 st-cell@ 352 st-cell@ ;
-- ( F j sg -- ) Add a candidate to frame F.
: st-cand-add
  rot >r
  r@ 0 @ dup 8 ult? 0= if 27 trap then 16 u* 8 u+
  r@ swap 8 u+ !
  r@ r@ 0 @ 16 u* 8 u+ !
  r@ 0 @ 1 u+ r> 0 ! ;
-- ( F j -- ) Typed word j, a clause, is a candidate if its types match.
: st-candidate
  dup st-clause-sig dup -1 eq? if drop 0 1 else st-match then
  0= if drop drop drop exit then
  248 st-cell@ 0= 0= swap 1 lshift or st-cand-add ;
-- ( F -- ) The most specific unguarded candidate; equal scores tie.
: st-choose
  >r -1 r@ 136 ! -1 r@ 144 ! 0 r@ 152 !
  0 cycle dup r@ 0 @ ult? while
    dup 16 u* 16 u+ r@ swap @
    dup 1 and if drop else
      1 rshift
      dup r@ 144 @ eq? if drop 1 r@ 152 ! else
        r@ 144 @ over lt? if r@ 144 ! dup r@ 136 ! 0 r@ 152 ! else drop then
      then
    then
    1 u+
  repeat drop r> drop ;
-- ( F -- flag ) Whether any candidate is guarded; ( F -- c ) the first.
: st-guarded?
  >r 0 0 cycle dup r@ 0 @ ult? while
    dup 16 u* 16 u+ r@ swap @ 1 and rot or swap 1 u+
  repeat drop r> drop ;
: st-first-guarded
  >r 0 cycle dup r@ 0 @ ult? if dup 16 u* 16 u+ r@ swap @ 1 and 0= else 0 then
  while 1 u+ repeat r> drop ;
-- ( j -- n ) Settle the inputs by clause j's signature, so every clause
-- tried at run time starts from values of known types: a literal takes its
-- type. How many inputs it has.
: st-settle-inputs
  st-clause-sig dup -1 eq? if drop 0 exit then
  dup 2 u* st-need
  st-unbind
  0 cycle over over swap ult? while
    over over u+ over 16 st@ st-annotate-at
    1 u+
  repeat drop
  dup cycle dup while st-drop 1 u- repeat drop ;
-- ( F -- ) Save the judgments, and where the inputs start; put them back.
: st-snapshot
  280 get over 168 !
  280 get 40 u* 8 u+ region-new over 160 !
  dup 160 @ >r 272 get 0 r> 0 280 get 40 u* copy
  280 get over 176 @ u- swap 184 ! ;
: st-restore
  >r r@ 160 @ 0 272 get 0 r@ 168 @ 40 u* copy
  r> 168 @ 280 put ;
-- ( F -- ) The guards st-clause-sig recorded, into the frame.
: st-copy-guards
  248 st-cell@ over 376 !
  0 cycle dup 8 ult? while
    dup 8 u* 256 u+ st-cell@ over 8 u* 384 u+ >r >r over r> swap r> !
    1 u+
  repeat drop drop ;
-- ( F -- ) An alternative ends: its results' literals take their defaults;
-- the first alternative's results are remembered, and each later one must
-- leave the same types; then a jump to the end, patched later.
: st-end-alt
  280 get over 184 @ u- 768 st-cell!
  768 st-cell@ 8 ult? 0= if 27 trap then
  0 cycle dup 768 st-cell@ ult? while dup 0 st@ st-lit? if dup st-default then 1 u+ repeat drop
  dup 192 @ -1 eq? if
    768 st-cell@ over 192 !
    0 cycle dup 768 st-cell@ ult? while
      dup 0 st@ over 8 u* 200 u+ >r >r over r> swap r> !
      1 u+
    repeat drop
  else
    dup 192 @ 768 st-cell@ eq? 0= if 23 trap then
    0 cycle dup 768 st-cell@ ult? while
      over over 8 u* 200 u+ @ over 0 st@ eq? 0= if 23 trap then
      1 u+
    repeat drop
  then
  5 c, here over dup 264 @ 8 u* 272 u+ ! 0 u32,
  dup 264 @ 1 u+ swap 264 ! ;
-- ( F -- ) Point the jumps to the next alternative, or to the end, here.
: st-patch-nexts
  0 cycle over 336 @ over swap ult? while
    over over 8 u* 344 u+ @ ops swap u32!
    1 u+
  repeat drop drop ;
: st-patch-ends
  0 cycle over 264 @ over swap ult? while
    over over 8 u* 272 u+ @ ops swap u32!
    1 u+
  repeat drop drop ;
-- ( F g -- ) Guard g of the current clause, tested at run time on copies of
-- the inputs it looks at (`dup`, `over`, or a copy from two down; deeper is
-- a limit), with a jump to the next alternative if it fails.
: st-guard-test
  over over 16 u* 384 u+ @ 752 st-cell!
  over over 16 u* 392 u+ @ 736 st-cell!
  drop
  dup 176 @ 728 st-cell!
  752 st-cell@ 1000 ult? if 752 st-cell@ 16 st-entry else 2 then 744 st-cell!
  728 st-cell@ 1 u- 736 st-cell@ u- 744 st-cell@ u+ 760 st-cell!
  760 st-cell@ 3 ult? 0= if 27 trap then
  744 st-cell@ cycle dup while
    760 st-cell@ dup 0= if drop 0 prim, else
      1 eq? if 3 prim, else 33 prim, 3 prim, 34 prim, 2 prim, then
    then
    760 st-cell@ 0 st@ 0 0 0 -1 st-push
    1 u-
  repeat drop
  752 st-cell@ dup 1000 ult? if st-inline else 1000 u- st-binop then
  0 0 st@ st-lit? if 0 st-default then
  0 0 st@ 1 eq? 0= if 23 trap then
  6 c, here over dup 336 @ 8 u* 344 u+ ! 0 u32,
  dup 336 @ 1 u+ over 336 !
  st-drop drop ;
-- ( F c -- ) Candidate c, guarded: from the judgments as they were, its
-- guards, then its body, as one alternative.
: st-try-guarded
  over st-restore
  16 u* 8 u+ over swap @
  dup st-clause-sig dup -1 eq? if drop else cycle dup while st-drop 1 u- repeat drop then
  over st-copy-guards
  over >r 0 r> 336 !
  >r
  0 cycle over 376 @ over swap ult? while over over st-guard-test 1 u+ repeat drop
  r> st-inline
  dup st-end-alt
  st-patch-nexts ;
-- ( F -- ) With no unguarded clause, after the trap for no word: the
-- results the alternatives leave, values known at run time.
: st-noword-state
  dup 184 @ 280 put
  dup 192 @ cycle dup while
    1 u- over over 8 u* 200 u+ @ 0 0 0 -1 st-push
  repeat drop drop ;
-- ( F -- ) The results, values known only at run time.
: st-runtime-results
  184 @ 280 get swap u-
  0 cycle over over swap ult? while 0 over 8 st! -1 over 32 st! 1 u+ repeat drop drop ;
-- ( F -- ) A choice at run time: each guarded clause, in the order defined,
-- tests its guards on copies of its inputs and runs if they hold; then the
-- most specific unguarded clause, or the trap for no word. The inputs are
-- settled first, by the unguarded clause or the first guarded one.
: st-dispatch
  dup 136 @ dup -1 eq? if drop dup st-first-guarded then
  16 u* 8 u+ over swap @ st-settle-inputs over 176 !
  dup st-snapshot
  0 cycle over 0 @ over swap ult? while
    over over 16 u* 16 u+ @ 1 and if over over st-try-guarded then
    1 u+
  repeat drop
  dup st-restore
  dup 136 @ -1 eq? if
    1 literal 32 prim, dup st-noword-state
  else
    dup dup 136 @ 16 u* 8 u+ @ st-inline dup st-end-alt
  then
  dup st-patch-ends
  dup 160 @ region-free
  st-runtime-results ;
-- ( idx -- ) A typed word applied: of the typed words with its name, the
-- clauses whose input types match the values on top, chosen by types now and
-- by guards at run time. No match is the error for an unknown word.
: st-family
  512 region-new swap >r
  0 over 0 ! -1 over 192 ! 0 over 264 ! 0 over 336 !
  0 cycle dup 120 get ult? while
    dup r@ st-same-name? if over over st-candidate then
    1 u+
  repeat drop r> drop
  dup st-choose
  dup 152 @ if 23 trap then
  dup st-guarded? 0= if
    dup 136 @ -1 eq? if 1 trap then
    dup dup 136 @ 16 u* 8 u+ @ swap region-free st-inline exit
  then
  dup st-dispatch region-free ;
-- ( -- ) `.`: apply the top judgment, a type, an operation or a typed word.
: st-apply
  1 st-need
  0 0 st@ 6 eq? if 0 16 st@ st-drop 1 st-need 0 swap st-annotate-at exit then
  0 0 st@ 7 eq? if 0 16 st@ st-drop st-op exit then
  0 0 st@ 8 eq? if 0 16 st@ st-drop st-family exit then
  23 trap ;
-- ( -- ) Past a string literal, from the quote that starts the current
-- word to the one that ends it, a backslash escaping the byte after it.
: st-skip-string
  64 get 1 u+
  cycle
    40 get over 48 get 92 byte-find 512 put
    40 get swap 512 get 34 byte-find
    dup 512 get ult? if 1 u+ 56 put exit then
    drop 512 get 48 get ult? 0= if 8 trap then
    512 get 2 u+
  again ;
-- ( -- ) One word of a body in the explicit form, other than `;`. A string
-- literal is compiled as everywhere else, and is a string.
: st-token-body
  40 get 64 get c@ 34 eq? if string-literal 9 0 0 0 -1 st-push exit then
  46 tok-char? if st-apply exit then
  60 tok-char? if st-sig exit then
  40 tok-char? if st-open exit then
  41 tok-char? if st-close exit then
  numeric-start? if st-literal exit then
  st-name ;
-- ( -- done ) One word of the definition's own body.
: st-token
  59 tok-char? if st-finish 1 exit then
  st-token-body 0 ;
-- ( -- ) The type stage, over the input up to `;`.
: stage
  2560 region-new 272 put 0 280 put 0 168 put 0 32 st-cell!
  cycle read-word 0= if 8 trap then st-token 0= while repeat ;
-- ( r n -- ) Make r, n bytes long, the input, and run the type stage over it.
: stage-text
  40 get >r 48 get >r 56 get >r 64 get >r 72 get >r
  48 put 40 put 0 56 put
  stage
  r> 72 put r> 64 put r> 56 put r> 48 put r> 40 put ;
-- ( -- n ok ) A bracket, read to its `>`: how many input types it leaves,
-- and whether a word whose signature it is can be compiled for itself, with
-- no type variable and no guard.
: st-bracket-effect
  0 776 st-cell! 1 784 st-cell! -1 792 st-cell!
  cycle read-word 0= if 8 trap then 62 tok-char? 0= while
    numeric-start? if 776 st-cell@ 1 u+ 776 st-cell! else
    s" --" tok= if 776 st-cell@ 792 st-cell! else
    s" ary" tok= if else
    s" vec" tok= s" map" tok= or if 776 st-cell@ 1 u- 776 st-cell! else
    st-guard-ref -1 eq? 0= if 0 784 st-cell! else
      72 get 1 eq? if 40 get 64 get c@ 97 u- 26 ult? if 0 784 st-cell! then then
      776 st-cell@ 1 u+ 776 st-cell!
    then then then then then
  repeat
  792 st-cell@ -1 eq? if 776 st-cell@ else 792 st-cell@ then 784 st-cell@ ;
-- ( r n -- in out k ) What a body in the explicit form takes and leaves,
-- and how many types a signature first in it names (4095 if it cannot be
-- compiled for itself). Numbers push; a name pushes a value, which `.`
-- applies; a bracket needs as many values as it types; `( … )` leaves one.
-- Working memory: 368 the depth, 376 its lowest, 312 and 320 what the last
-- name takes and leaves, 336 whether this is the first word, 328 the
-- signature's length.
: st-effect
  40 get >r 48 get >r 56 get >r 64 get >r 72 get >r
  48 put 40 put 0 56 put
  0 368 put 0 376 put 1 336 put 0 328 put
  cycle read-word 0= if 8 trap then 59 tok-char? 0= while
    40 get 64 get c@ 34 eq? if st-skip-string 368 get 1 + 368 put else
    46 tok-char? if
      368 get 1 - 312 get - dup 376 get lt? if dup 376 put then
      320 get + 368 put
    else 60 tok-char? if
      st-bracket-effect
      336 get if if dup 328 put else 4095 328 put then else drop then
      368 get swap - dup 376 get lt? if 376 put else drop then
    else 40 tok-char? if 368 get >r else 41 tok-char? if r> 1 + 368 put else
    numeric-start? if 368 get 1 + 368 put else
      st-name-effect 320 put 312 put 368 get 1 + 368 put
    then then then then then then
    0 336 put
  repeat
  r> 72 put r> 64 put r> 56 put r> 48 put r> 40 put
  376 get negate 368 get 376 get - 328 get ;
-- ( r n in out -- r n ) Record a typed word: its name (at 80-96, as `colon`
-- left it), its explicit form and what it takes and leaves.
: st-record
  st-state
  120 get 64 ult? 0= if 27 trap then
  88 get 40 ult? 0= if 7 trap then
  120 get 80 u* 312 put
  112 get 312 get 24 u+ ! 112 get 312 get 16 u+ !
  over 112 get 312 get ! dup 112 get 312 get 8 u+ !
  88 get 112 get 312 get 32 u+ !
  96 get 80 get 112 get 312 get 40 u+ 88 get copy
  120 get 1 u+ 120 put ;
-- ( r n -- ) A typed definition, in the explicit form: recorded, then
-- compiled as a word of its own if a signature types all it takes, with no
-- variable and no guard; otherwise it has no code of its own.
: st-define
  over over st-effect >r over r> eq? >r
  st-record
  r> if stage-text exit then
  drop drop out region-free 0 24 put 0 16 put 0 0 put ;
-- ( -- r n ) The rest of the definition, through its `;`, as it is.
: st-capture
  56 get 312 put
  cycle read-word 0= if 8 trap then 59 tok-char? 0= while repeat
  56 get 312 get u- dup region-new 320 put
  >r 40 get 312 get 320 get 0 r@ copy 320 get r> ;
-- ( r o n -- ) Append bytes and a space to the explicit form being built,
-- in the region at 312, 320 bytes long so far.
: emit-text
  >r 312 get 320 get r@ copy 320 get r> u+ 320 put
  32 312 get 320 get c! 320 get 1 u+ 320 put ;
-- ( -- r n ) Stage 1: the rest of the definition, through its `;`, in the
-- explicit form. A word that is not a number is followed by `.`, except `(`
-- and `)`; a bracket and a string literal are copied as they are.
: lower
  48 get 56 get u- 3 u* 16 u+ region-new 312 put 0 320 put 0 336 put
  cycle
    read-word 0= if 8 trap then
    40 get 64 get c@ 34 eq? 336 get 0= and if
      st-skip-string 40 get 64 get 56 get 64 get u- emit-text 1
    else
      40 get 64 get 72 get emit-text
      336 get if 62 tok-char? if 0 336 put then 1 else
        60 tok-char? if 1 336 put 1 else
          59 tok-char? if 0 else
            40 tok-char? 41 tok-char? or 0= numeric-start? 0= and if
              s" ." emit-text
            then 1
          then
        then
      then
    then
  while repeat
  312 get 320 get ;
-- ( -- ) `#`, `##` or `###`, then a bracket: the context of the typed
-- definitions after it, until the next heading, which starts a new section
-- even if this one is empty. A heading that names a namespace instead ends
-- the context.
: st-heading
  0 8 st-cell!
  read-word 0= if exit then
  60 tok-char? 0= if exit then
  64 get 312 put
  cycle read-word 0= if 8 trap then 62 tok-char? 0= while repeat
  56 get 312 get u- dup region-new 320 put
  >r 40 get 312 get 320 get 0 r@ copy
  320 get 0 st-cell! r> 8 st-cell! ;
-- ( r n -- r' n' ) The current heading's bracket, put first in a body, as
-- its own signature: the per-definition form lowering gives.
: st-with-context
  8 st-cell@ 0= if exit then
  dup 8 st-cell@ u+ 1 u+ region-new >r
  0 st-cell@ 0 r@ 0 8 st-cell@ copy
  32 r@ 8 st-cell@ c!
  >r 0 r> r@ swap 8 st-cell@ 1 u+ swap dup >r copy
  r> 8 st-cell@ 1 u+ u+ r> swap ;
-- ( -- ) `typed name … ;` and `explicit name … ;`.
: typed colon lower st-with-context st-define ;
: explicit colon st-capture st-with-context st-define ;

: register-families
  0 728 get 0 !
  ' + ' p.f+ 514 2 0 add-clause
  ' - ' p.f- 514 2 0 add-clause
  ' * ' p.f* 514 2 0 add-clause
  ' / ' p.f/ 514 2 0 add-clause
  ' lt? ' p.flt? 514 2 0 add-clause
  ' gt? ' f-gt? 514 2 0 add-clause
  ' lte? ' f-lte? 514 2 0 add-clause
  ' gte? ' f-gte? 514 2 0 add-clause
  ' lt? ' text-lt? 65021 2 1 add-clause
  ' gt? ' text-gt? 65021 2 1 add-clause
  ' lte? ' text-lte? 65021 2 1 add-clause
  ' gte? ' text-gte? 65021 2 1 add-clause ;

: STATE 1 0 ;
: HERE 1 16 ;
: LATEST 1 8 ;

-- The name s" cannot be written with s" itself.
: sq-name 2 region-new 115 over 0 c! 34 over 1 c! 0 2 ;

: init
  ' p.dup 0 prim-flag s" dup" install
  ' p.drop 1 prim-flag s" drop" install
  ' p.swap 2 prim-flag s" swap" install
  ' p.over 3 prim-flag s" over" install
  ' p.rot 4 prim-flag s" rot" install
  ' p.u+ 5 prim-flag s" u+" install
  ' p.u- 6 prim-flag s" u-" install
  ' p.u* 7 prim-flag s" u*" install
  ' p.u/ 8 prim-flag s" u/" install
  ' p.umod 9 prim-flag s" umod" install
  ' p.eq? 10 prim-flag s" eq?" install
  ' p.ult? 11 prim-flag s" ult?" install
  ' p.and 12 prim-flag s" and" install
  ' p.or 13 prim-flag s" or" install
  ' p.xor 14 prim-flag s" xor" install
  ' p.invert 15 prim-flag s" invert" install
  ' p.lshift 16 prim-flag s" lshift" install
  ' p.rshift 17 prim-flag s" rshift" install
  ' p.c@ 18 prim-flag s" c@" install
  ' p.c! 19 prim-flag s" c!" install
  ' p.@ 20 prim-flag s" @" install
  ' p.! 21 prim-flag s" !" install
  ' p.region-new 22 prim-flag s" region-new" install
  ' p.region-free 23 prim-flag s" region-free" install
  ' p.region-size 24 prim-flag s" region-size" install
  ' p.call 25 prim-flag s" call" install
  ' word 0 s" word" install
  ' lookup 0 s" find" install
  ' >xt 0 s" >xt" install
  ' begin 0 s" begin" install
  ' colon 0 s" :" install
  ' semicolon 1 s" ;" install
  ' immediate 0 s" immediate" install
  ' literal 0 s" literal" install
  ' compile, 0 s" compile," install
  ' quote-word 1 s" quote" install
  ' quote-word 1 s" '" install
  ' , 0 s" ," install
  ' c, 0 s" c," install
  ' line-comment 5 s" --" install
  ' qrecur 1 s" recur" install
  ' STATE 0 s" STATE" install
  ' HERE 0 s" HERE" install
  ' LATEST 0 s" LATEST" install
  ' [ 1 s" [[" install
  ' ] 0 s" ]]" install
  ' quote-open 5 s" [" install
  ' quote-close 1 s" ]" install
  ' prim, 0 s" prim," install
  ' p.0= 0 s" 0=" install
  ' nip 0 s" nip" install
  ' qif 5 s" if" install
  ' then 1 s" then" install
  ' else 1 s" else" install
  ' cycle 1 s" cycle" install
  ' again 1 s" again" install
  ' until 1 s" until" install
  ' qwhile 5 s" while" install
  ' repeat 1 s" repeat" install
  ' qexit 1 s" exit" install
  ' times 5 s" times" install
  ' each 5 s" each" install
  ' fold 5 s" fold" install
  ' map 5 s" map" install
  ' i0 1 s" i0" install
  ' i1 1 s" i1" install
  ' s" 1 sq-name install
  ' >r 1 s" >r" install
  ' r> 1 s" r>" install
  ' r@ 1 s" r@" install
  ' evaluate 0 s" evaluate" install
  ' negate 0 s" negate" install
  ' abs 0 s" abs" install
  ' lt? 8 s" lt?" install
  ' gt? 8 s" gt?" install
  ' lte? 8 s" lte?" install
  ' gte? 8 s" gte?" install
  ' + 8 s" +" install
  ' - 8 s" -" install
  ' * 8 s" *" install
  ' / 8 s" /" install
  ' mod 16 s" mod" install
  ' p.trap 32 prim-flag s" trap" install
  ' p.seal 26 prim-flag s" seal" install
  ' p.code-cid 27 prim-flag s" code-cid" install
  ' p.resolve 28 prim-flag s" resolve" install
  ' p.publish 29 prim-flag s" publish" install
  ' p.blob-cid 30 prim-flag s" blob-cid" install
  ' p.blob-read 31 prim-flag s" blob-read" install
  ' p.f+ 36 prim-flag s" f+" install
  ' p.f- 37 prim-flag s" f-" install
  ' p.f* 38 prim-flag s" f*" install
  ' p.f/ 39 prim-flag s" f/" install
  ' p.feq? 40 prim-flag s" feq?" install
  ' p.flt? 41 prim-flag s" flt?" install
  ' p.i>f 42 prim-flag s" i>f" install
  ' p.f>i 43 prim-flag s" f>i" install
  ' stack-effect 0 s" stack-effect" install
  ' stack-types 0 s" stack-types" install
  ' qopen 33 s" (" install
  ' qclose 65 s" )" install
  ' length 48 prim-flag s" length" install
  ' at 49 prim-flag s" at" install
  ' concat 53 prim-flag s" concat" install
  ' slice 54 prim-flag s" slice" install
  ' same? 55 prim-flag s" same?" install
  ' map-put 57 prim-flag s" put" install
  ' has? 58 prim-flag s" has?" install
  ' remove 59 prim-flag s" remove" install
  ' keys 60 prim-flag s" keys" install
  ' values 61 prim-flag s" values" install
  ' >string 16 s" >string" install
  ' print 16 s" print" install
  ' typed 0 s" typed" install
  ' explicit 0 s" explicit" install
  ' st-heading 0 s" #" install
  ' st-heading 0 s" ##" install
  ' st-heading 0 s" ###" install
  ' input-word 5 s" _" install
  ' >integer 0 s" >integer" install
  ' >float 0 s" >float" install
  ' order 70 prim-flag s" compare" install
  ' index-of 71 prim-flag s" search" install
  ' qopen 33 s" {" install
  ' qmapclose 129 s" }" install
  ' hash-bytes 0 s" hash-bytes" install
  ' checked 0 s" checked" install
  ' unchecked 0 s" unchecked" install ;

-- ( -- region offset n ) For the host: the types the interpreter knows for
-- the top n values on the stack, a byte each, the deepest first.
: describe 3576 get 0 784 get ;

-- ( data-region 0 length -- evaluate recover export describe )
: boot 4096 32 put 0 8 put 0 0 put -1 744 put ' compile-token 104 put
  ' st-token-body 592 put
  1048576 region-new 624 put 1048576 region-new 712 put ' effect-of 616 put 0 632 put
  4096 region-new 728 put register-families
  98312 region-new 3512 put ' instantiate 3504 put ' lift-for 3392 put
  65536 region-new 3576 put 0 784 put 0 3528 put
  8192 region-new 736 put
  dup if restore else drop drop drop init then
  ' evaluate ' recover ' snapshot ' describe ;

' boot

-- Word frequencies: march8's first real program (2026-10-09). Run it with
-- `march8 examples/wordfreq.march`.

-- The words come from core's `words`, split at white space, and `lower`,
-- so "The" and "the" count together. (The first version split the text
-- itself, by value patterns, recursion and a comprehension: commit f7ce8a0.)

-- Counting: a word's count so far is `i64 nil or`, nil before its first.
tally: < i64 > [ 1 + ] ;
tally: < nil > [ drop 1 ] ;
bump: < k i64 map k > [ over over get tally put ] ;
frequencies: < string ary -- string i64 map > [ string i64 map empty [ bump ] fold ] ;

-- Each word and its count, a line each, in the words' order.
report: < string i64 map > [ dup keys sort [ over over at "\_ \_\n;" write ] each drop ] ;

-- Most frequent first. Each count from the highest down to 1 looks through
-- the words for its own: counts × words steps. (Written before `sort-by`.)
has-count: [ rot swap at eq? ] ;
show-if: < string i64 map i64 string has-count? > [ over "\_ \_\n;" write ] ;
show-if: < string i64 map i64 string > [ drop ] ;
with-count: < string i64 map i64 > [ over keys sort [ show-if ] each drop drop ] ;
ranked: < string i64 map > [ dup values sort last range reverse [ over swap with-count ] each drop ] ;

"The cat and the hat
and the bat sat on the mat" words lower frequencies dup report "--\n;" write ranked

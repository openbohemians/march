-- Array Broadcasting Demo

-- Define the wildcard broadcast handler
= {a} a -> {a} ;
: [*]
  swap
  dup array.len
  [ {
    over i0 array.get
    rot
    [*]
    swap
  } ] #do
  drop
;

TEST. { 1 2 3 } 10 + { 11 12 13 }  eq? ;  -- test broadcast of +. 
TEST. { 5 10 15 } 2 * { 10 20 30 } eq? ;  -- test broadcast of *.
TEST. { 90 } 5 - { 85 } eq? ;             -- test broadcast of -.

